    out.hex("4157")  # push r15
    out.call(rt[R_WRITE_WHOLE_FILE_BODY])
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("c3")  # ret
end

# rax = the path, rcx = the text. Replaces the file
func write_rt_write_whole_file_body(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_part = out.new_label()
    var at_finished = out.new_label()
    var at_failed = out.new_label()
    out.place(rt[R_WRITE_WHOLE_FILE_BODY])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec40")  # sub rsp, 64
    out.hex("4989c5")  # mov r13, rax
    out.hex("4989ce")  # mov r14, rcx
    out.call(rt[R_TO_WIDE])
    out.hex("4889c1")  # mov rcx, rax
    out.hex("ba00000040")  # mov edx, 0x40000000
    out.hex("41b801000000")  # mov r8d, 1
    out.hex("4531c9")  # xor r9d, r9d
    out.hex("48c744242002000000")  # mov qword ptr [rsp+32], 2
    out.hex("48c744242880000000")  # mov qword ptr [rsp+40], 0x80
    out.hex("48c744243000000000")  # mov qword ptr [rsp+48], 0
    out.call_windows(DATA_CREATE_FILE_W)
    out.hex("4883f8ff")  # cmp rax, -1
    out.jump_if_equal(at_failed)
    out.hex("4989c4")  # mov r12, rax
    out.hex("498d5e08")  # lea rbx, [r14+8]
    out.hex("498b36")  # mov rsi, qword ptr [r14]
    out.place(at_next_part)
    out.hex("4885f6")  # test rsi, rsi
    out.jump_if_equal(at_finished)
    out.hex("4989f0")  # mov r8, rsi
    out.hex("b800000040")  # mov eax, 0x40000000
    out.hex("4939c0")  # cmp r8, rax
    out.hex("4c0f47c0")  # cmova r8, rax
    out.hex("4c89e1")  # mov rcx, r12
    out.hex("4889da")  # mov rdx, rbx
    out.hex("4c8d4c2438")  # lea r9, [rsp+56]
    out.hex("48c744242000000000")  # mov qword ptr [rsp+32], 0
    out.call_windows(DATA_WRITE_FILE)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_failed)
    out.hex("8b442438")  # mov eax, dword ptr [rsp+56]
    out.hex("4801c3")  # add rbx, rax
    out.hex("4829c6")  # sub rsi, rax
    out.jump(at_next_part)
    out.place(at_finished)
    out.hex("4c89e1")  # mov rcx, r12
    out.call_windows(DATA_CLOSE_HANDLE)
    out.hex("c9")  # leave
    out.hex("c3")  # ret
    out.place(at_failed)
    out.hex("4c89e8")  # mov rax, r13
    out.lea_string(REG_RDX, text.cant_write)
    out.lea_string(REG_R8, text.period)
    out.jump(rt[R_TEXT_ERROR])
end

# rax = the path. Answers with a bool
func write_rt_file_exists(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_FILE_EXISTS])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.call(rt[R_TO_WIDE])
    out.hex("4889c1")  # mov rcx, rax
    out.call_windows(DATA_GET_FILE_ATTRIBUTES_W)
    out.hex("83f8ff")  # cmp eax, -1
    out.hex("0f95c0")  # setne al
    out.hex("0fb6c0")  # movzx eax, al
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# Reads more typed or piped input. Answers with how much came. Keeps rbx
func write_rt_stdin_refill(out: Assembler, rt: [int], text: RuntimeText)
    var at_has_buffer = out.new_label()
    var at_no_input = out.new_label()
    var at_finished = out.new_label()
    out.place(rt[R_STDIN_REFILL])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("53")  # push rbx
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec40")  # sub rsp, 64
    out.lea_data(REG_RBX, DATA_STDIN, 0)
    out.hex("48833b00")  # cmp qword ptr [rbx], 0
    out.jump_if_not_equal(at_has_buffer)
    out.hex("b900100000")  # mov ecx, 4096
    out.call(rt[R_RAW_ALLOC])
    out.hex("488903")  # mov qword ptr [rbx], rax
    out.place(at_has_buffer)
    out.hex("48c7c1f6ffffff")  # mov rcx, -10
    out.call_windows(DATA_GET_STD_HANDLE)
    out.hex("4889c1")  # mov rcx, rax
    out.hex("488b13")  # mov rdx, qword ptr [rbx]
    out.hex("41b800100000")  # mov r8d, 4096
    out.hex("4c8d4c2438")  # lea r9, [rsp+56]
    out.hex("48c744243800000000")  # mov qword ptr [rsp+56], 0
    out.hex("48c744242000000000")  # mov qword ptr [rsp+32], 0
    out.call_windows(DATA_READ_FILE)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_no_input)
    out.hex("8b442438")  # mov eax, dword ptr [rsp+56]
    out.hex("48c7430800000000")  # mov qword ptr [rbx+8], 0
    out.hex("48894310")  # mov qword ptr [rbx+16], rax
    out.jump(at_finished)
    out.place(at_no_input)
    out.hex("31c0")  # xor eax, eax
    out.place(at_finished)
    out.hex("488d65f8")  # lea rsp, [rbp-8]
    out.hex("5b")  # pop rbx
    out.hex("5d")  # pop rbp
    out.hex("c3")  # ret
end

# Answers with the next line of input, without its line ending, or "" when there's no more
func write_rt_read_line(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_char = out.new_label()
    var at_has_char = out.new_label()
    var at_line_done = out.new_label()
    var at_no_return = out.new_label()
    out.place(rt[R_READ_LINE])
    out.lea_data(REG_RBX, DATA_STDIN, 0)
    out.call(rt[R_BUILDER_START])
    out.place(at_next_char)
    out.hex("488b4308")  # mov rax, qword ptr [rbx+8]
    out.hex("483b4310")  # cmp rax, qword ptr [rbx+16]
    out.jump_if_below(at_has_char)
    out.call(rt[R_STDIN_REFILL])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_line_done)
    out.hex("31c0")  # xor eax, eax
    out.place(at_has_char)
    out.hex("488b13")  # mov rdx, qword ptr [rbx]
    out.hex("4801c2")  # add rdx, rax
    out.hex("48ff4308")  # inc qword ptr [rbx+8]
    out.hex("803a0a")  # cmp byte ptr [rdx], 10
    out.jump_if_equal(at_line_done)
    out.hex("41b801000000")  # mov r8d, 1
    out.call(rt[R_BUILDER_ADD])
    out.jump(at_next_char)
    out.place(at_line_done)
    out.lea_data(REG_RAX, DATA_BUILDER, 0)
    out.hex("488b4808")  # mov rcx, qword ptr [rax+8]
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_no_return)
    out.hex("488b10")  # mov rdx, qword ptr [rax]
    out.hex("807c0aff0d")  # cmp byte ptr [rdx+rcx-1], 13
    out.jump_if_not_equal(at_no_return)
    out.hex("48ff4808")  # dec qword ptr [rax+8]
    out.place(at_no_return)
    out.jump(rt[R_BUILDER_TO_STRING])
end

# rax = one byte. Keeps rbx
func write_rt_builder_add_byte(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_BYTE])
    out.hex("50")  # push rax
    out.hex("4889e2")  # mov rdx, rsp
    out.hex("41b801000000")  # mov r8d, 1
    out.call(rt[R_BUILDER_ADD])
    out.hex("58")  # pop rax
    out.hex("c3")  # ret
end

# rax = a letter's number in Unicode, added as UTF-8. Keeps r12, r13, r14 and r15
func write_rt_builder_add_letter(out: Assembler, rt: [int], text: RuntimeText)
    var at_two_bytes = out.new_label()
    var at_three_bytes = out.new_label()
    var at_four_bytes = out.new_label()
    var at_middle_byte = out.new_label()
    var at_last_byte = out.new_label()
    out.place(rt[R_BUILDER_ADD_LETTER])
    out.hex("4889c3")  # mov rbx, rax
    out.hex("4881fb80000000")  # cmp rbx, 0x80
    out.jump_if_at_least(at_two_bytes)
    out.jump(rt[R_BUILDER_ADD_BYTE])
    out.place(at_two_bytes)
    out.hex("4881fb00080000")  # cmp rbx, 0x800
    out.jump_if_at_least(at_three_bytes)
    out.hex("48c1e806")  # shr rax, 6
    out.hex("480dc0000000")  # or rax, 0xC0
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.jump(at_last_byte)
    out.place(at_three_bytes)
    out.hex("4881fb00000100")  # cmp rbx, 0x10000
    out.jump_if_at_least(at_four_bytes)
    out.hex("48c1e80c")  # shr rax, 12
    out.hex("480de0000000")  # or rax, 0xE0
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.jump(at_middle_byte)
    out.place(at_four_bytes)
    out.hex("48c1e812")  # shr rax, 18
    out.hex("480df0000000")  # or rax, 0xF0
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.hex("4889d8")  # mov rax, rbx
    out.hex("48c1e80c")  # shr rax, 12
    out.hex("4883e03f")  # and rax, 0x3F
    out.hex("480d80000000")  # or rax, 0x80
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.place(at_middle_byte)
    out.hex("4889d8")  # mov rax, rbx
    out.hex("48c1e806")  # shr rax, 6
    out.hex("4883e03f")  # and rax, 0x3F
    out.hex("480d80000000")  # or rax, 0x80
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.place(at_last_byte)
    out.hex("4889d8")  # mov rax, rbx
    out.hex("4883e03f")  # and rax, 0x3F
    out.hex("480d80000000")  # or rax, 0x80
    out.jump(rt[R_BUILDER_ADD_BYTE])
end

# Keeps r12 to r15, where Jamo code may hold variables, around get_args_body
func write_rt_get_args(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_GET_ARGS])
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.hex("4156")  # push r14
    out.hex("4157")  # push r15
    out.call(rt[R_GET_ARGS_BODY])
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("c3")  # ret
end

# Answers with the command line's inputs as an array of strings, read by Windows' usual rules
func write_rt_get_args_body(out: Assembler, rt: [int], text: RuntimeText)
    var at_skip_quoted_name = out.new_label()
    var at_skip_plain_name = out.new_label()
    var at_next_input = out.new_label()
    var at_skip_space = out.new_label()
    var at_found_input = out.new_label()
    var at_next_letter = out.new_label()
    var at_plain_letter = out.new_label()
    var at_whole_letter = out.new_label()
    var at_quote_mark = out.new_label()
    var at_flip_quotes = out.new_label()
    var at_backslashes = out.new_label()
    var at_count_backslash = out.new_label()
    var at_counted = out.new_label()
    var at_add_backslashes = out.new_label()
    var at_input_done = out.new_label()
    var at_all_done = out.new_label()
    out.place(rt[R_GET_ARGS_BODY])
    out.hex("b900000000")  # mov ecx, 0
    out.call(rt[R_NEW_ARRAY])
    out.hex("4989c4")  # mov r12, rax
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.call_windows(DATA_GET_COMMAND_LINE_W)
    out.hex("4989c5")  # mov r13, rax
    out.hex("6641837d0022")  # cmp word ptr [r13], 34
    out.jump_if_not_equal(at_skip_plain_name)
    out.place(at_skip_quoted_name)
    out.hex("4983c502")  # add r13, 2
    out.hex("410fb74500")  # movzx eax, word ptr [r13]
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_all_done)
    out.hex("83f822")  # cmp eax, 34
    out.jump_if_not_equal(at_skip_quoted_name)
    out.hex("4983c502")  # add r13, 2
    out.jump(at_next_input)
    out.place(at_skip_plain_name)
    out.hex("410fb74500")  # movzx eax, word ptr [r13]
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_all_done)
    out.hex("83f820")  # cmp eax, 32
    out.jump_if_equal(at_next_input)
    out.hex("83f809")  # cmp eax, 9
    out.jump_if_equal(at_next_input)
    out.hex("4983c502")  # add r13, 2
    out.jump(at_skip_plain_name)
    out.place(at_next_input)
    out.hex("410fb74500")  # movzx eax, word ptr [r13]
    out.hex("83f820")  # cmp eax, 32
    out.jump_if_equal(at_skip_space)
    out.hex("83f809")  # cmp eax, 9
    out.jump_if_not_equal(at_found_input)
    out.place(at_skip_space)
    out.hex("4983c502")  # add r13, 2
    out.jump(at_next_input)
    out.place(at_found_input)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_all_done)
    out.call(rt[R_BUILDER_START])
    out.hex("4531f6")  # xor r14d, r14d
    out.place(at_next_letter)
    out.hex("410fb74500")  # movzx eax, word ptr [r13]
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_input_done)
    out.hex("83f85c")  # cmp eax, 92
    out.jump_if_equal(at_backslashes)
    out.hex("83f822")  # cmp eax, 34
    out.jump_if_equal(at_quote_mark)
    out.hex("4d85f6")  # test r14, r14
    out.jump_if_not_equal(at_plain_letter)
    out.hex("83f820")  # cmp eax, 32
    out.jump_if_equal(at_input_done)
    out.hex("83f809")  # cmp eax, 9
    out.jump_if_equal(at_input_done)
    out.place(at_plain_letter)
    out.hex("4983c502")  # add r13, 2
    out.hex("89c1")  # mov ecx, eax
    out.hex("81e100fc0000")  # and ecx, 0xFC00
    out.hex("81f900d80000")  # cmp ecx, 0xD800
    out.jump_if_not_equal(at_whole_letter)
    out.hex("410fb74d00")  # movzx ecx, word ptr [r13]
    out.hex("89ca")  # mov edx, ecx
    out.hex("81e200fc0000")  # and edx, 0xFC00
    out.hex("81fa00dc0000")  # cmp edx, 0xDC00
    out.jump_if_not_equal(at_whole_letter)
    out.hex("4983c502")  # add r13, 2
    out.hex("2d00d80000")  # sub eax, 0xD800
    out.hex("c1e00a")  # shl eax, 10
    out.hex("81e900dc0000")  # sub ecx, 0xDC00
    out.hex("01c8")  # add eax, ecx
    out.hex("0500000100")  # add eax, 0x10000
    out.place(at_whole_letter)
    out.call(rt[R_BUILDER_ADD_LETTER])
    out.jump(at_next_letter)
    out.place(at_quote_mark)
    out.hex("4983c502")  # add r13, 2
    out.hex("4d85f6")  # test r14, r14
    out.jump_if_equal(at_flip_quotes)
    out.hex("6641837d0022")  # cmp word ptr [r13], 34
    out.jump_if_not_equal(at_flip_quotes)
    out.hex("4983c502")  # add r13, 2
    out.hex("b822000000")  # mov eax, 34
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.jump(at_next_letter)
    out.place(at_flip_quotes)
    out.hex("4983f601")  # xor r14, 1
    out.jump(at_next_letter)
    out.place(at_backslashes)
    out.hex("4531ff")  # xor r15d, r15d
    out.place(at_count_backslash)
    out.hex("6641837d005c")  # cmp word ptr [r13], 92
    out.jump_if_not_equal(at_counted)
    out.hex("49ffc7")  # inc r15
    out.hex("4983c502")  # add r13, 2
    out.jump(at_count_backslash)
    out.place(at_counted)
    out.hex("6641837d0022")  # cmp word ptr [r13], 34
    out.jump_if_not_equal(at_add_backslashes)
    out.hex("4c89f8")  # mov rax, r15
    out.hex("4883e001")  # and rax, 1
    out.hex("49d1ef")  # shr r15, 1
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_add_backslashes)
    out.hex("4983c502")  # add r13, 2
    out.hex("4c89fb")  # mov rbx, r15
    out.call(rt[R_ADD_BACKSLASH_RUN])
    out.hex("b822000000")  # mov eax, 34
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.jump(at_next_letter)
    out.place(at_add_backslashes)
    out.hex("4c89fb")  # mov rbx, r15
    out.call(rt[R_ADD_BACKSLASH_RUN])
    out.jump(at_next_letter)
    out.place(at_input_done)
    out.call(rt[R_BUILDER_TO_STRING])
    out.hex("4889c1")  # mov rcx, rax
    out.hex("4c89e0")  # mov rax, r12
    out.call(rt[R_ARRAY_ADD])
    out.jump(at_next_input)
    out.place(at_all_done)
    out.hex("4c89e0")  # mov rax, r12
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rbx = how many backslashes to add
func write_rt_add_backslash_run(out: Assembler, rt: [int], text: RuntimeText)
    var at_none_left = out.new_label()
    out.place(rt[R_ADD_BACKSLASH_RUN])
    out.hex("4885db")  # test rbx, rbx
    out.jump_if_equal(at_none_left)
    out.hex("b85c000000")  # mov eax, 92
    out.call(rt[R_BUILDER_ADD_BYTE])
    out.hex("48ffcb")  # dec rbx
    out.jump(rt[R_ADD_BACKSLASH_RUN])
    out.place(at_none_left)
    out.hex("c3")  # ret
end

# rcx = what raw_alloc gave, or 0. Keeps rbx, rsi and rdi
func write_rt_raw_free(out: Assembler, rt: [int], text: RuntimeText)
    var at_nothing = out.new_label()
    out.place(rt[R_RAW_FREE])
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_nothing)
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.hex("4989c8")  # mov r8, rcx
    out.hex("31d2")  # xor edx, edx
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.call_windows(DATA_HEAP_FREE)
    out.hex("c9")  # leave
    out.place(at_nothing)
    out.hex("c3")  # ret
end

# rcx = bytes wanted, for a block that can hold references. Answers in rax with the memory zeroed, and keeps every other register
func write_rt_alloc(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_ALLOC])
    out.hex("41bb01000000")  # mov r11d, 1
    out.jump(rt[R_ALLOC_BLOCK])
end

# rcx = bytes wanted, for a block that holds no references, like a string
func write_rt_alloc_text(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_ALLOC_TEXT])
    out.hex("4531db")  # xor r11d, r11d
    out.jump(rt[R_ALLOC_BLOCK])
end

# Each block starts with a 32-byte header: the next block, its size, its type at +16, its mark at +17, where it sits in its chunk at +20 or 0 if it has no chunk, and a check value. Blocks of up to 512 bytes come from chunks, and this quick path saves few registers because it can't clean or call Windows
func write_rt_alloc_block(out: Assembler, rt: [int], text: RuntimeText)
    var at_slow = out.new_label()
    out.place(rt[R_ALLOC_BLOCK])
    out.hex("50")  # push rax
    out.hex("51")  # push rcx
    out.hex("52")  # push rdx
    out.hex("53")  # push rbx
    out.hex("57")  # push rdi
    out.lea_data(REG_RBX, DATA_CLEANER, 0)
    out.hex("488d51ff")  # lea rdx, [rcx-1]
    out.hex("4881fa00020000")  # cmp rdx, 512
    out.jump_if_at_least(at_slow)
    out.hex("4883e2f0")  # and rdx, -16
    out.hex("488d4230")  # lea rax, [rdx+48]
    out.hex("48034310")  # add rax, qword ptr [rbx+16]
    out.hex("483b4318")  # cmp rax, qword ptr [rbx+24]
    out.jump_if_at_least(at_slow)
    out.hex("f6432001")  # test byte ptr [rbx+32], 1
    out.jump_if_not_equal(at_slow)
    out.jump(rt[R_ALLOC_TAKE])
    out.place(at_slow)
    out.hex("5f")  # pop rdi
    out.hex("5b")  # pop rbx
    out.hex("5a")  # pop rdx
    out.hex("59")  # pop rcx
    out.hex("58")  # pop rax
    out.jump(rt[R_ALLOC_SLOW])
end

# Comes back from alloc_slow, which has made sure a small block can be had
func write_rt_alloc_again(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_ALLOC_AGAIN])
    out.hex("50")  # push rax
    out.hex("51")  # push rcx
    out.hex("52")  # push rdx
    out.hex("53")  # push rbx
    out.hex("57")  # push rdi
    out.lea_data(REG_RBX, DATA_CLEANER, 0)
    out.hex("488d51ff")  # lea rdx, [rcx-1]
    out.hex("4883e2f0")  # and rdx, -16
    out.jump(rt[R_ALLOC_TAKE])
end

# rdx = 16 x the size class. Takes a block from its free list, or else from the current chunk, then sets it up and zeroes it. Five registers are on the stack
func write_rt_alloc_take(out: Assembler, rt: [int], text: RuntimeText)
    var at_set_up = out.new_label()
    var at_next_zero = out.new_label()
    var at_from_chunk = out.new_label()
    var at_slow = out.new_label()
    var at_not_free = out.new_label()
    out.place(rt[R_ALLOC_TAKE])
    out.hex("4889d1")  # mov rcx, rdx
    out.hex("48d1e9")  # shr rcx, 1
    out.hex("488b840b90000000")  # mov rax, qword ptr [rbx+rcx+144]
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_from_chunk)
    out.hex("80781003")  # cmp byte ptr [rax+16], 3
    out.jump_if_not_equal(at_not_free)
    out.hex("488b38")  # mov rdi, qword ptr [rax]
    out.hex("4889bc0b90000000")  # mov qword ptr [rbx+rcx+144], rdi
    out.place(at_set_up)
    out.hex("488d7a30")  # lea rdi, [rdx+48]
    out.hex("48017b10")  # add qword ptr [rbx+16], rdi
    out.hex("488b3b")  # mov rdi, qword ptr [rbx]
    out.hex("488938")  # mov qword ptr [rax], rdi
    out.hex("488903")  # mov qword ptr [rbx], rax
    out.hex("48ff4308")  # inc qword ptr [rbx+8]
    out.hex("488b4c2418")  # mov rcx, qword ptr [rsp+24]
    out.hex("48894808")  # mov qword ptr [rax+8], rcx
    out.hex("44885810")  # mov byte ptr [rax+16], r11b
    out.hex("c6401100")  # mov byte ptr [rax+17], 0
    out.hex("4831c1")  # xor rcx, rax
    out.hex("48bf41454c434f4d414a")  # movabs rdi, 0x4A414D4F434C4541
    out.hex("4831f9")  # xor rcx, rdi
    out.hex("48894818")  # mov qword ptr [rax+24], rcx
    out.hex("4883c020")  # add rax, 32
    out.place(at_next_zero)
    out.hex("48c7041000000000")  # mov qword ptr [rax+rdx], 0
    out.hex("48c744100800000000")  # mov qword ptr [rax+rdx+8], 0
    out.hex("4883ea10")  # sub rdx, 16
    out.jump_if_not_negative(at_next_zero)
    out.hex("5f")  # pop rdi
    out.hex("5b")  # pop rbx
    out.hex("5a")  # pop rdx
    out.hex("59")  # pop rcx
    out.hex("4883c408")  # add rsp, 8
    out.hex("c3")  # ret
    out.place(at_from_chunk)
    out.hex("488b4368")  # mov rax, qword ptr [rbx+104]
    out.hex("488d7c1030")  # lea rdi, [rax+rdx+48]
    out.hex("483b7b70")  # cmp rdi, qword ptr [rbx+112]
    out.jump_if_above(at_slow)
    out.hex("48897b68")  # mov qword ptr [rbx+104], rdi
    out.hex("4889c7")  # mov rdi, rax
    out.hex("482b7b60")  # sub rdi, qword ptr [rbx+96]
    out.hex("897814")  # mov dword ptr [rax+20], edi
    out.jump(at_set_up)
    out.place(at_slow)
    out.hex("5f")  # pop rdi
    out.hex("5b")  # pop rbx
    out.hex("5a")  # pop rdx
    out.hex("59")  # pop rcx
    out.hex("58")  # pop rax
    out.jump(rt[R_ALLOC_SLOW])
    out.place(at_not_free)
    out.lea_string(REG_RAX, text.cleaner_bad_header)
    out.jump(rt[R_RUN_ERROR])
end

# Everything the quick path can't do: cleaning, getting a chunk, and large blocks. Every register goes on the stack first, so cleaning can find what's in them
func write_rt_alloc_slow(out: Assembler, rt: [int], text: RuntimeText)
    var at_clean_first = out.new_label()
    var at_no_clean = out.new_label()
    var at_new_chunk = out.new_label()
    var at_get_chunk = out.new_label()
    var at_use_chunk = out.new_label()
    var at_small_ready = out.new_label()
    var at_large = out.new_label()
    var at_no_memory = out.new_label()
    var at_got_memory = out.new_label()
    out.place(rt[R_ALLOC_SLOW])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("50")  # push rax
    out.hex("51")  # push rcx
    out.hex("52")  # push rdx
    out.hex("53")  # push rbx
    out.hex("56")  # push rsi
    out.hex("57")  # push rdi
    out.hex("4150")  # push r8
    out.hex("4151")  # push r9
    out.hex("4152")  # push r10
    out.hex("4153")  # push r11
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.hex("4156")  # push r14
    out.hex("4157")  # push r15
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.lea_data(REG_RBX, DATA_CLEANER, 0)
    out.hex("488b45f0")  # mov rax, qword ptr [rbp-16]
    out.hex("4883c02f")  # add rax, 47
    out.hex("4883e0f0")  # and rax, -16
    out.hex("48014310")  # add qword ptr [rbx+16], rax
    out.hex("4531e4")  # xor r12d, r12d
    out.hex("f6432004")  # test byte ptr [rbx+32], 4
    out.jump_if_not_equal(at_no_clean)
    out.hex("f6432001")  # test byte ptr [rbx+32], 1
    out.jump_if_not_equal(at_clean_first)
    out.hex("488b4310")  # mov rax, qword ptr [rbx+16]
    out.hex("483b4318")  # cmp rax, qword ptr [rbx+24]
    out.jump_if_below(at_no_clean)
    out.place(at_clean_first)
    out.call(rt[R_CLEANER_CLEAN])
    out.hex("41bc01000000")  # mov r12d, 1
    out.place(at_no_clean)
    out.hex("488b4df0")  # mov rcx, qword ptr [rbp-16]
    out.hex("48ffc9")  # dec rcx
    out.hex("4881f900020000")  # cmp rcx, 512
    out.jump_if_at_least(at_large)
    out.hex("4883e1f0")  # and rcx, -16
    out.hex("4889c8")  # mov rax, rcx
    out.hex("48d1e8")  # shr rax, 1
    out.hex("4883bc039000000000")  # cmp qword ptr [rbx+rax+144], 0
    out.jump_if_not_equal(at_small_ready)
    out.hex("488b4368")  # mov rax, qword ptr [rbx+104]
    out.hex("488d440830")  # lea rax, [rax+rcx+48]
    out.hex("483b4370")  # cmp rax, qword ptr [rbx+112]
    out.jump_if_at_most(at_small_ready)
    out.hex("488b8380000000")  # mov rax, qword ptr [rbx+128]
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_new_chunk)
    out.hex("488b08")  # mov rcx, qword ptr [rax]
    out.hex("48898b80000000")  # mov qword ptr [rbx+128], rcx
    out.hex("48ff8b88000000")  # dec qword ptr [rbx+136]
    out.jump(at_use_chunk)
    out.place(at_new_chunk)
    out.hex("4d85e4")  # test r12, r12
    out.jump_if_not_equal(at_get_chunk)
    out.hex("f6432004")  # test byte ptr [rbx+32], 4
    out.jump_if_not_equal(at_get_chunk)
    out.hex("488b4308")  # mov rax, qword ptr [rbx+8]
    out.hex("48034350")  # add rax, qword ptr [rbx+80]
    out.hex("4c8d0480")  # lea r8, [rax+rax*4]
    out.hex("49c1e003")  # shl r8, 3
    out.hex("4981c000000400")  # add r8, 0x40000
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_clean_first)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4989c0")  # mov r8, rax
    out.call_windows(DATA_HEAP_FREE)
    out.place(at_get_chunk)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("41b800000400")  # mov r8d, 0x40000
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_no_memory)
    out.place(at_use_chunk)
    out.hex("488b4b78")  # mov rcx, qword ptr [rbx+120]
    out.hex("488908")  # mov qword ptr [rax], rcx
    out.hex("48894378")  # mov qword ptr [rbx+120], rax
    out.hex("48c7400800000000")  # mov qword ptr [rax+8], 0
    out.hex("48894360")  # mov qword ptr [rbx+96], rax
    out.hex("488d4810")  # lea rcx, [rax+16]
    out.hex("48894b68")  # mov qword ptr [rbx+104], rcx
    out.hex("488d8800000400")  # lea rcx, [rax+0x40000]
    out.hex("48894b70")  # mov qword ptr [rbx+112], rcx
    out.place(at_small_ready)
    out.hex("488d6590")  # lea rsp, [rbp-112]
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("415b")  # pop r11
    out.hex("415a")  # pop r10
    out.hex("4159")  # pop r9
    out.hex("4158")  # pop r8
    out.hex("5f")  # pop rdi
    out.hex("5e")  # pop rsi
    out.hex("5b")  # pop rbx
    out.hex("5a")  # pop rdx
    out.hex("59")  # pop rcx
    out.hex("58")  # pop rax
    out.hex("5d")  # pop rbp
    out.jump(rt[R_ALLOC_AGAIN])
    out.place(at_large)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("ba08000000")  # mov edx, 8
    out.hex("4c8b45f0")  # mov r8, qword ptr [rbp-16]
    out.hex("4983c020")  # add r8, 32
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_not_equal(at_got_memory)
    out.place(at_no_memory)
    out.hex("4d85e4")  # test r12, r12
    out.jump_if_not_equal(rt[R_OUT_OF_MEMORY])
    out.hex("f6432004")  # test byte ptr [rbx+32], 4
    out.jump_if_not_equal(rt[R_OUT_OF_MEMORY])
    out.jump(at_clean_first)
    out.place(at_got_memory)
    out.hex("488b0b")  # mov rcx, qword ptr [rbx]
    out.hex("488908")  # mov qword ptr [rax], rcx
    out.hex("488903")  # mov qword ptr [rbx], rax
    out.hex("48ff4308")  # inc qword ptr [rbx+8]
    out.hex("488b4df0")  # mov rcx, qword ptr [rbp-16]
    out.hex("48894808")  # mov qword ptr [rax+8], rcx
    out.hex("488b55b0")  # mov rdx, qword ptr [rbp-80]
    out.hex("885010")  # mov byte ptr [rax+16], dl
    out.hex("4831c1")  # xor rcx, rax
    out.hex("48ba41454c434f4d414a")  # movabs rdx, 0x4A414D4F434C4541
    out.hex("4831d1")  # xor rcx, rdx
    out.hex("48894818")  # mov qword ptr [rax+24], rcx
    out.hex("4883c020")  # add rax, 32
    out.hex("488945f8")  # mov qword ptr [rbp-8], rax
    out.hex("488d6590")  # lea rsp, [rbp-112]
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("415b")  # pop r11
    out.hex("415a")  # pop r10
    out.hex("4159")  # pop r9
    out.hex("4158")  # pop r8
    out.hex("5f")  # pop rdi
    out.hex("5e")  # pop rsi
    out.hex("5b")  # pop rbx
    out.hex("5a")  # pop rdx
    out.hex("59")  # pop rcx
    out.hex("58")  # pop rax
    out.hex("5d")  # pop rbp
    out.hex("c3")  # ret
end

# rax = the mode: 1 cleans at every allocation, 2 adds extra checks, 4 turns cleaning off, 16 is a window program. Also notes where the stack starts. The cleaner's values: the first block +0, how many +8, bytes since a clean +16, when to clean +24, mode +32, stack start +40, freed list +56, how many freed +80, how many cleans +88, current chunk +96, its next free spot +104, its end +112, chunks in use +120, empty chunks +128, how many empty +136, the free list of each size class +144, then the table of blocks +400 and how many entries it has +408, and the list to look through +416 and its entries +424, kept from clean to clean while each is 2 MB or less, so a program that cleans often doesn't ask Windows for them every time. A chunk starts with the next chunk and how many blocks in it are in use
func write_rt_cleaner_start(out: Assembler, rt: [int], text: RuntimeText)
    var at_will_clean = out.new_label()
    out.place(rt[R_CLEANER_START])
    out.lea_data(REG_RDX, DATA_CLEANER, 0)
    out.hex("48894220")  # mov qword ptr [rdx+32], rax
    out.hex("48896228")  # mov qword ptr [rdx+40], rsp
    out.hex("48c7421800004000")  # mov qword ptr [rdx+24], 0x400000
    out.hex("a804")  # test al, 4
    out.jump_if_equal(at_will_clean)
    out.hex("48c74218ffffffff")  # mov qword ptr [rdx+24], -1
    out.place(at_will_clean)
    out.hex("c3")  # ret
end

# The extra checks: every block's header, and that freed memory still holds only its marker. rbx = the cleaner's values
func write_rt_cleaner_verify(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_live = out.new_label()
    var at_check_freed = out.new_label()
    var at_next_freed = out.new_label()
    var at_all_good = out.new_label()
    var at_bad_header = out.new_label()
    var at_freed_changed = out.new_label()
    out.place(rt[R_CLEANER_VERIFY])
    out.hex("488b13")  # mov rdx, qword ptr [rbx]
    out.place(at_next_live)
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_equal(at_check_freed)
    out.hex("488b4208")  # mov rax, qword ptr [rdx+8]
    out.hex("4831d0")  # xor rax, rdx
    out.hex("48b941454c434f4d414a")  # movabs rcx, 0x4A414D4F434C4541
    out.hex("4831c8")  # xor rax, rcx
    out.hex("483b4218")  # cmp rax, qword ptr [rdx+24]
    out.jump_if_not_equal(at_bad_header)
    out.hex("807a1001")  # cmp byte ptr [rdx+16], 1
    out.jump_if_above(at_bad_header)
    out.hex("807a1100")  # cmp byte ptr [rdx+17], 0
    out.jump_if_not_equal(at_bad_header)
    out.hex("488b12")  # mov rdx, qword ptr [rdx]
    out.jump(at_next_live)
    out.place(at_check_freed)
    out.hex("488b5338")  # mov rdx, qword ptr [rbx+56]
    out.place(at_next_freed)
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_equal(at_all_good)
    out.hex("488b4208")  # mov rax, qword ptr [rdx+8]
    out.hex("4831d0")  # xor rax, rdx
    out.hex("48b941454c434f4d414a")  # movabs rcx, 0x4A414D4F434C4541
    out.hex("4831c8")  # xor rax, rcx
    out.hex("483b4218")  # cmp rax, qword ptr [rdx+24]
    out.jump_if_not_equal(at_bad_header)
    out.hex("807a1002")  # cmp byte ptr [rdx+16], 2
    out.jump_if_not_equal(at_bad_header)
    out.hex("488d7a20")  # lea rdi, [rdx+32]
    out.hex("488b4a08")  # mov rcx, qword ptr [rdx+8]
    out.hex("48c1e903")  # shr rcx, 3
    out.hex("48b8dddddddddddddddd")  # movabs rax, 0xDDDDDDDDDDDDDDDD
    out.hex("4839c0")  # cmp rax, rax
    out.hex("f348af")  # repe scasq
    out.jump_if_not_equal(at_freed_changed)
    out.hex("488b4a08")  # mov rcx, qword ptr [rdx+8]
    out.hex("4883e107")  # and rcx, 7
    out.hex("4839c0")  # cmp rax, rax
    out.hex("f3ae")  # repe scasb
    out.jump_if_not_equal(at_freed_changed)
    out.hex("488b12")  # mov rdx, qword ptr [rdx]
    out.jump(at_next_freed)
    out.place(at_all_good)
    out.hex("c3")  # ret
    out.place(at_bad_header)
    out.lea_string(REG_RAX, text.cleaner_bad_header)
    out.jump(rt[R_RUN_ERROR])
    out.place(at_freed_changed)
    out.lea_string(REG_RAX, text.cleaner_freed_changed)
    out.jump(rt[R_RUN_ERROR])
end

# rdx = a list of blocks to add to the table of known blocks. r12 = the table, r13 = its size minus 1
func write_rt_cleaner_add_to_table(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_block = out.new_label()
    var at_next_place = out.new_label()
    var at_found_room = out.new_label()
    var at_finished = out.new_label()
    out.place(rt[R_CLEANER_ADD_TO_TABLE])
    out.hex("49b9157c4a7fb979379e")  # movabs r9, 0x9E3779B97F4A7C15
    out.place(at_next_block)
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_equal(at_finished)
    out.hex("488d4220")  # lea rax, [rdx+32]
    out.hex("4889c1")  # mov rcx, rax
    out.hex("48c1e904")  # shr rcx, 4
    out.hex("490fafc9")  # imul rcx, r9
    out.hex("48c1e920")  # shr rcx, 32
    out.place(at_next_place)
    out.hex("4c21e9")  # and rcx, r13
    out.hex("49833ccc00")  # cmp qword ptr [r12+rcx*8], 0
    out.jump_if_equal(at_found_room)
    out.hex("48ffc1")  # inc rcx
    out.jump(at_next_place)
    out.place(at_found_room)
    out.hex("498904cc")  # mov qword ptr [r12+rcx*8], rax
    out.hex("488b12")  # mov rdx, qword ptr [rdx]
    out.jump(at_next_block)
    out.place(at_finished)
    out.hex("c3")  # ret
end

# rax = anything at all. If it's exactly where a known block's memory starts, that block is in use. r14 = the top of the list still to look through, r15 = 1 when the word came from a block. With checks on, a block's word that points at a block freed in the last 2 cleans is a bug: when the cleaner frees something still in use, that's when it shows. Older ones are left alone, since a plain number can equal an old block's address
func write_rt_cleaner_mark_word(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_place = out.new_label()
    var at_found = out.new_label()
    var at_nothing = out.new_label()
    var at_is_freed = out.new_label()
    out.place(rt[R_CLEANER_MARK_WORD])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_nothing)
    out.hex("a80f")  # test al, 15
    out.jump_if_not_equal(at_nothing)
    out.hex("49b9157c4a7fb979379e")  # movabs r9, 0x9E3779B97F4A7C15
    out.hex("4889c1")  # mov rcx, rax
    out.hex("48c1e904")  # shr rcx, 4
    out.hex("490fafc9")  # imul rcx, r9
    out.hex("48c1e920")  # shr rcx, 32
    out.place(at_next_place)
    out.hex("4c21e9")  # and rcx, r13
    out.hex("498b14cc")  # mov rdx, qword ptr [r12+rcx*8]
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_equal(at_nothing)
    out.hex("4839c2")  # cmp rdx, rax
    out.jump_if_equal(at_found)
    out.hex("48ffc1")  # inc rcx
    out.jump(at_next_place)
    out.place(at_found)
    out.hex("8078f002")  # cmp byte ptr [rax-16], 2
    out.jump_if_equal(at_is_freed)
    out.hex("8078f100")  # cmp byte ptr [rax-15], 0
    out.jump_if_not_equal(at_nothing)
    out.hex("c640f101")  # mov byte ptr [rax-15], 1
    out.hex("8078f001")  # cmp byte ptr [rax-16], 1
    out.jump_if_not_equal(at_nothing)
    out.hex("498906")  # mov qword ptr [r14], rax
    out.hex("4983c608")  # add r14, 8
    out.place(at_nothing)
    out.hex("c3")  # ret
    out.place(at_is_freed)
    out.hex("4d85ff")  # test r15, r15
    out.jump_if_equal(at_nothing)
    out.hex("0fb748f2")  # movzx ecx, word ptr [rax-14]
    out.hex("8b5358")  # mov edx, dword ptr [rbx+88]
    out.hex("29ca")  # sub edx, ecx
    out.hex("81e2ffff0000")  # and edx, 0xFFFF
    out.hex("83fa02")  # cmp edx, 2
    out.jump_if_above(at_nothing)
    out.lea_string(REG_RAX, text.cleaner_freed_reference)
    out.jump(rt[R_RUN_ERROR])
end

# Marks everything that's in use, starting from the whole stack, which holds every saved register. Uses a list instead of recursion, so long chains can't overflow the stack
func write_rt_cleaner_clean(out: Assembler, rt: [int], text: RuntimeText)
    var at_no_checks = out.new_label()
    var at_size_table = out.new_label()
    var at_table_sized = out.new_label()
    var at_table_freed = out.new_label()
    var at_reuse_table = out.new_label()
    var at_table_ready = out.new_label()
    var at_list_freed = out.new_label()
    var at_reuse_list = out.new_label()
    var at_next_root = out.new_label()
    var at_roots_done = out.new_label()
    var at_next_to_look_at = out.new_label()
    var at_next_word = out.new_label()
    var at_all_marked = out.new_label()
    var at_next_count = out.new_label()
    var at_counts_cleared = out.new_label()
    var at_next_block = out.new_label()
    var at_not_in_chunk = out.new_label()
    var at_free_block = out.new_label()
    var at_free_small = out.new_label()
    var at_keep_freed = out.new_label()
    var at_block_freed = out.new_label()
    var at_freed_twice = out.new_label()
    var at_sweep_done = out.new_label()
    var at_next_counted = out.new_label()
    var at_has_live = out.new_label()
    var at_all_counted = out.new_label()
    var at_next_list = out.new_label()
    var at_next_free = out.new_label()
    var at_drop_free = out.new_label()
    var at_list_done = out.new_label()
    var at_next_chunk = out.new_label()
    var at_empty_chunk = out.new_label()
    var at_not_current = out.new_label()
    var at_trim_chunks = out.new_label()
    var at_chunks_done = out.new_label()
    var at_give_up = out.new_label()
    var at_keep_table = out.new_label()
    var at_keep_list = out.new_label()
    out.place(rt[R_CLEANER_CLEAN])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec30")  # sub rsp, 48
    out.lea_data(REG_RBX, DATA_CLEANER, 0)
    out.hex("48ff4358")  # inc qword ptr [rbx+88]
    out.hex("f6432002")  # test byte ptr [rbx+32], 2
    out.jump_if_equal(at_no_checks)
    out.call(rt[R_CLEANER_VERIFY])
    out.place(at_no_checks)
    out.hex("488b4308")  # mov rax, qword ptr [rbx+8]
    out.hex("48034350")  # add rax, qword ptr [rbx+80]
    out.hex("488d540001")  # lea rdx, [rax+rax+1]
    out.hex("41bd10000000")  # mov r13d, 16
    out.place(at_size_table)
    out.hex("4939d5")  # cmp r13, rdx
    out.jump_if_at_least(at_table_sized)
    out.hex("49d1e5")  # shl r13, 1
    out.jump(at_size_table)
    out.place(at_table_sized)
    out.hex("4c3bab98010000")  # cmp r13, qword ptr [rbx+408]
    out.jump_if_at_most(at_reuse_table)
    out.hex("4c8b8390010000")  # mov r8, qword ptr [rbx+400]
    out.hex("4d85c0")  # test r8, r8
    out.jump_if_equal(at_table_freed)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.call_windows(DATA_HEAP_FREE)
    out.place(at_table_freed)
    out.hex("48c7839001000000000000")  # mov qword ptr [rbx+400], 0
    out.hex("48c7839801000000000000")  # mov qword ptr [rbx+408], 0
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("ba08000000")  # mov edx, 8
    out.hex("4e8d04ed00000000")  # lea r8, [r13*8]
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_give_up)
    out.hex("48898390010000")  # mov qword ptr [rbx+400], rax
    out.hex("4c89ab98010000")  # mov qword ptr [rbx+408], r13
    out.jump(at_table_ready)
    out.place(at_reuse_table)
    out.hex("4c8bab98010000")  # mov r13, qword ptr [rbx+408]
    out.hex("488bbb90010000")  # mov rdi, qword ptr [rbx+400]
    out.hex("4c89e9")  # mov rcx, r13
    out.hex("31c0")  # xor eax, eax
    out.hex("f348ab")  # rep stosq
    out.place(at_table_ready)
    out.hex("4c8ba390010000")  # mov r12, qword ptr [rbx+400]
    out.hex("4c8b7b08")  # mov r15, qword ptr [rbx+8]
    out.hex("49ffc7")  # inc r15
    out.hex("4c3bbba8010000")  # cmp r15, qword ptr [rbx+424]
    out.jump_if_at_most(at_reuse_list)
    out.hex("4c8b83a0010000")  # mov r8, qword ptr [rbx+416]
    out.hex("4d85c0")  # test r8, r8
    out.jump_if_equal(at_list_freed)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.call_windows(DATA_HEAP_FREE)
    out.place(at_list_freed)
    out.hex("48c783a001000000000000")  # mov qword ptr [rbx+416], 0
    out.hex("48c783a801000000000000")  # mov qword ptr [rbx+424], 0
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4e8d04fd00000000")  # lea r8, [r15*8]
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_give_up)
    out.hex("488983a0010000")  # mov qword ptr [rbx+416], rax
    out.hex("4c89bba8010000")  # mov qword ptr [rbx+424], r15
    out.place(at_reuse_list)
    out.hex("4c8bb3a0010000")  # mov r14, qword ptr [rbx+416]
    out.hex("4c89742428")  # mov qword ptr [rsp+40], r14
    out.hex("49ffcd")  # dec r13
    out.hex("488b13")  # mov rdx, qword ptr [rbx]
    out.call(rt[R_CLEANER_ADD_TO_TABLE])
    out.hex("488b5338")  # mov rdx, qword ptr [rbx+56]
    out.call(rt[R_CLEANER_ADD_TO_TABLE])
    out.hex("4531ff")  # xor r15d, r15d
    out.hex("4889e6")  # mov rsi, rsp
    out.place(at_next_root)
    out.hex("483b7328")  # cmp rsi, qword ptr [rbx+40]
    out.jump_if_at_least(at_roots_done)
    out.hex("488b06")  # mov rax, qword ptr [rsi]
    out.call(rt[R_CLEANER_MARK_WORD])
    out.hex("4883c608")  # add rsi, 8
    out.jump(at_next_root)
    out.place(at_roots_done)
    out.hex("41bf01000000")  # mov r15d, 1
    out.place(at_next_to_look_at)
    out.hex("4c3b742428")  # cmp r14, qword ptr [rsp+40]
    out.jump_if_equal(at_all_marked)
    out.hex("4983ee08")  # sub r14, 8
    out.hex("498b36")  # mov rsi, qword ptr [r14]
    out.hex("488b7ee8")  # mov rdi, qword ptr [rsi-24]
    out.hex("48c1ef03")  # shr rdi, 3
    out.place(at_next_word)
    out.hex("4885ff")  # test rdi, rdi
    out.jump_if_equal(at_next_to_look_at)
    out.hex("488b06")  # mov rax, qword ptr [rsi]
    out.call(rt[R_CLEANER_MARK_WORD])
    out.hex("4883c608")  # add rsi, 8
    out.hex("48ffcf")  # dec rdi
    out.jump(at_next_word)
    out.place(at_all_marked)
    out.hex("488b4378")  # mov rax, qword ptr [rbx+120]
    out.place(at_next_count)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_counts_cleared)
    out.hex("48c7400800000000")  # mov qword ptr [rax+8], 0
    out.hex("488b00")  # mov rax, qword ptr [rax]
    out.jump(at_next_count)
    out.place(at_counts_cleared)
    out.hex("4889de")  # mov rsi, rbx
    out.hex("488b3b")  # mov rdi, qword ptr [rbx]
    out.hex("4531f6")  # xor r14d, r14d
    out.place(at_next_block)
    out.hex("4885ff")  # test rdi, rdi
    out.jump_if_equal(at_sweep_done)
    out.hex("807f1100")  # cmp byte ptr [rdi+17], 0
    out.jump_if_equal(at_free_block)
    out.hex("c6471100")  # mov byte ptr [rdi+17], 0
    out.hex("488b4708")  # mov rax, qword ptr [rdi+8]
    out.hex("4883c02f")  # add rax, 47
    out.hex("4883e0f0")  # and rax, -16
    out.hex("4901c6")  # add r14, rax
    out.hex("8b5714")  # mov edx, dword ptr [rdi+20]
    out.hex("85d2")  # test edx, edx
    out.jump_if_equal(at_not_in_chunk)
    out.hex("4889f8")  # mov rax, rdi
    out.hex("4829d0")  # sub rax, rdx
    out.hex("48ff4008")  # inc qword ptr [rax+8]
    out.place(at_not_in_chunk)
    out.hex("4889fe")  # mov rsi, rdi
    out.hex("488b3f")  # mov rdi, qword ptr [rdi]
    out.jump(at_next_block)
    out.place(at_free_block)
    out.hex("807f1002")  # cmp byte ptr [rdi+16], 2
    out.jump_if_equal(at_freed_twice)
    out.hex("4c8b3f")  # mov r15, qword ptr [rdi]
    out.hex("4c893e")  # mov qword ptr [rsi], r15
    out.hex("48ff4b08")  # dec qword ptr [rbx+8]
    out.hex("f6432002")  # test byte ptr [rbx+32], 2
    out.jump_if_not_equal(at_keep_freed)
    out.hex("837f1400")  # cmp dword ptr [rdi+20], 0
    out.jump_if_not_equal(at_free_small)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4989f8")  # mov r8, rdi
    out.call_windows(DATA_HEAP_FREE)
    out.jump(at_block_freed)
    out.place(at_free_small)
    out.hex("c6471003")  # mov byte ptr [rdi+16], 3
    out.hex("488b4708")  # mov rax, qword ptr [rdi+8]
    out.hex("48ffc8")  # dec rax
    out.hex("48c1e804")  # shr rax, 4
    out.hex("488b8cc390000000")  # mov rcx, qword ptr [rbx+rax*8+144]
    out.hex("48890f")  # mov qword ptr [rdi], rcx
    out.hex("4889bcc390000000")  # mov qword ptr [rbx+rax*8+144], rdi
    out.jump(at_block_freed)
    out.place(at_keep_freed)
    out.hex("c6471002")  # mov byte ptr [rdi+16], 2
    out.hex("8b4358")  # mov eax, dword ptr [rbx+88]
    out.hex("66894712")  # mov word ptr [rdi+18], ax
    out.hex("488b4338")  # mov rax, qword ptr [rbx+56]
    out.hex("488907")  # mov qword ptr [rdi], rax
    out.hex("48897b38")  # mov qword ptr [rbx+56], rdi
    out.hex("48ff4350")  # inc qword ptr [rbx+80]
    out.hex("488b4f08")  # mov rcx, qword ptr [rdi+8]
    out.hex("4883c720")  # add rdi, 32
    out.hex("b0dd")  # mov al, 0xDD
    out.hex("f3aa")  # rep stosb
    out.place(at_block_freed)
    out.hex("4c89ff")  # mov rdi, r15
    out.jump(at_next_block)
    out.place(at_freed_twice)
    out.lea_string(REG_RAX, text.cleaner_double_free)
    out.jump(rt[R_RUN_ERROR])
    out.place(at_sweep_done)
    out.hex("4d01f6")  # add r14, r14
    out.hex("b800004000")  # mov eax, 0x400000
    out.hex("4939c6")  # cmp r14, rax
    out.hex("490f47c6")  # cmova rax, r14
    out.hex("48894318")  # mov qword ptr [rbx+24], rax
    out.hex("f6432002")  # test byte ptr [rbx+32], 2
    out.jump_if_not_equal(at_chunks_done)
    out.hex("31c9")  # xor ecx, ecx
    out.hex("31d2")  # xor edx, edx
    out.hex("488b4378")  # mov rax, qword ptr [rbx+120]
    out.place(at_next_counted)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_all_counted)
    out.hex("48ffc1")  # inc rcx
    out.hex("4883780800")  # cmp qword ptr [rax+8], 0
    out.jump_if_not_equal(at_has_live)
    out.hex("48ffc2")  # inc rdx
    out.place(at_has_live)
    out.hex("488b00")  # mov rax, qword ptr [rax]
    out.jump(at_next_counted)
    out.place(at_all_counted)
    out.hex("48c1e203")  # shl rdx, 3
    out.hex("4839ca")  # cmp rdx, rcx
    out.jump_if_below(at_trim_chunks)
    out.hex("4531ed")  # xor r13d, r13d
    out.place(at_next_list)
    out.hex("4a8db42b90000000")  # lea rsi, [rbx+r13+144]
    out.place(at_next_free)
    out.hex("488b3e")  # mov rdi, qword ptr [rsi]
    out.hex("4885ff")  # test rdi, rdi
    out.jump_if_equal(at_list_done)
    out.hex("8b5714")  # mov edx, dword ptr [rdi+20]
    out.hex("4889f8")  # mov rax, rdi
    out.hex("4829d0")  # sub rax, rdx
    out.hex("4883780800")  # cmp qword ptr [rax+8], 0
    out.jump_if_equal(at_drop_free)
    out.hex("4889fe")  # mov rsi, rdi
    out.jump(at_next_free)
    out.place(at_drop_free)
    out.hex("488b07")  # mov rax, qword ptr [rdi]
    out.hex("488906")  # mov qword ptr [rsi], rax
    out.jump(at_next_free)
    out.place(at_list_done)
    out.hex("4983c508")  # add r13, 8
    out.hex("4981fd00010000")  # cmp r13, 256
    out.jump_if_below(at_next_list)
    out.hex("488d7378")  # lea rsi, [rbx+120]
    out.place(at_next_chunk)
    out.hex("488b3e")  # mov rdi, qword ptr [rsi]
    out.hex("4885ff")  # test rdi, rdi
    out.jump_if_equal(at_trim_chunks)
    out.hex("48837f0800")  # cmp qword ptr [rdi+8], 0
    out.jump_if_equal(at_empty_chunk)
    out.hex("4889fe")  # mov rsi, rdi
    out.jump(at_next_chunk)
    out.place(at_empty_chunk)
    out.hex("488b07")  # mov rax, qword ptr [rdi]
    out.hex("488906")  # mov qword ptr [rsi], rax
    out.hex("483b7b60")  # cmp rdi, qword ptr [rbx+96]
    out.jump_if_not_equal(at_not_current)
    out.hex("31c0")  # xor eax, eax
    out.hex("48894360")  # mov qword ptr [rbx+96], rax
    out.hex("48894368")  # mov qword ptr [rbx+104], rax
    out.hex("48894370")  # mov qword ptr [rbx+112], rax
    out.place(at_not_current)
    out.hex("488b8380000000")  # mov rax, qword ptr [rbx+128]
    out.hex("488907")  # mov qword ptr [rdi], rax
    out.hex("4889bb80000000")  # mov qword ptr [rbx+128], rdi
    out.hex("48ff8388000000")  # inc qword ptr [rbx+136]
    out.jump(at_next_chunk)
    out.place(at_trim_chunks)
    out.hex("488b8388000000")  # mov rax, qword ptr [rbx+136]
    out.hex("48c1e012")  # shl rax, 18
    out.hex("488b4b18")  # mov rcx, qword ptr [rbx+24]
    out.hex("48d1e9")  # shr rcx, 1
    out.hex("4881c100000800")  # add rcx, 0x80000
    out.hex("4839c8")  # cmp rax, rcx
    out.jump_if_at_most(at_chunks_done)
    out.hex("488bbb80000000")  # mov rdi, qword ptr [rbx+128]
    out.hex("488b07")  # mov rax, qword ptr [rdi]
    out.hex("48898380000000")  # mov qword ptr [rbx+128], rax
    out.hex("48ff8b88000000")  # dec qword ptr [rbx+136]
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4989f8")  # mov r8, rdi
    out.call_windows(DATA_HEAP_FREE)
    out.jump(at_trim_chunks)
    out.place(at_chunks_done)
    out.place(at_give_up)
    out.hex("4881bb9801000000000400")  # cmp qword ptr [rbx+408], 262144
    out.jump_if_at_most(at_keep_table)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4c8b8390010000")  # mov r8, qword ptr [rbx+400]
    out.call_windows(DATA_HEAP_FREE)
    out.hex("48c7839001000000000000")  # mov qword ptr [rbx+400], 0
    out.hex("48c7839801000000000000")  # mov qword ptr [rbx+408], 0
    out.place(at_keep_table)
    out.hex("4881bba801000000000400")  # cmp qword ptr [rbx+424], 262144
    out.jump_if_at_most(at_keep_list)
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.hex("31d2")  # xor edx, edx
    out.hex("4c8b83a0010000")  # mov r8, qword ptr [rbx+416]
    out.call_windows(DATA_HEAP_FREE)
    out.hex("48c783a001000000000000")  # mov qword ptr [rbx+416], 0
    out.hex("48c783a801000000000000")  # mov qword ptr [rbx+424], 0
    out.place(at_keep_list)
    out.hex("48c7431000000000")  # mov qword ptr [rbx+16], 0
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# Walks up the stack, showing each function call that led here. The table holds pairs of 4-byte places: where a call returns to, and the words for that call
func write_rt_show_calls(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_frame = out.new_label()
    var at_next_entry = out.new_label()
    var at_found_call = out.new_label()
    var at_not_a_call = out.new_label()
    var at_too_many = out.new_label()
    var at_finished = out.new_label()
    out.place(rt[R_SHOW_CALLS])
    out.hex("4989ed")  # mov r13, rbp
    out.hex("4531f6")  # xor r14d, r14d
    out.lea_data(REG_RAX, DATA_CLEANER, 0)
    out.hex("4c8b7828")  # mov r15, qword ptr [rax+40]
    out.place(at_next_frame)
    out.hex("4d85ed")  # test r13, r13
    out.jump_if_equal(at_finished)
    out.hex("4d39fd")  # cmp r13, r15
    out.jump_if_at_least(at_finished)
    out.hex("498b4508")  # mov rax, qword ptr [r13+8]
    out.hex("48b90000004001000000")  # movabs rcx, 0x140000000
    out.hex("4829c8")  # sub rax, rcx
    out.lea_data(REG_RDX, DATA_CALL_TABLE, 0)
    out.hex("8b0a")  # mov ecx, dword ptr [rdx]
    out.hex("4883c208")  # add rdx, 8
    out.place(at_next_entry)
    out.hex("85c9")  # test ecx, ecx
    out.jump_if_equal(at_not_a_call)
    out.hex("3b02")  # cmp eax, dword ptr [rdx]
    out.jump_if_equal(at_found_call)
    out.hex("4883c208")  # add rdx, 8
    out.hex("ffc9")  # dec ecx
    out.jump(at_next_entry)
    out.place(at_found_call)
    out.hex("4983fe0a")  # cmp r14, 10
    out.jump_if_at_least(at_too_many)
    out.hex("49ffc6")  # inc r14
    out.hex("8b4204")  # mov eax, dword ptr [rdx+4]
    out.hex("48b90000004001000000")  # movabs rcx, 0x140000000
    out.hex("4801c8")  # add rax, rcx
    out.call(rt[R_ERROR_TEXT])
    out.place(at_not_a_call)
    out.hex("498b4500")  # mov rax, qword ptr [r13]
    out.hex("4c39e8")  # cmp rax, r13
    out.jump_if_at_most(at_finished)
    out.hex("4989c5")  # mov r13, rax
    out.jump(at_next_frame)
    out.place(at_too_many)
    out.lea_string(REG_RAX, text.more_calls)
    out.jump(rt[R_ERROR_TEXT])
    out.place(at_finished)
    out.hex("c3")  # ret
end

# Every routine's label, made first, in order
func make_runtime_labels(out: Assembler): [int]
    var rt: [int] = []
    for i in 0..RUNTIME_ROUTINES
        rt.add(out.new_label())
    end
    return rt
end

func write_runtime(out: Assembler, rt: [int], text: RuntimeText)
    write_rt_exit(out, rt, text)
    write_rt_write(out, rt, text)
    write_rt_raw_alloc(out, rt, text)
    write_rt_format_int(out, rt, text)
    write_rt_make_string(out, rt, text)
    write_rt_print_int(out, rt, text)
    write_rt_int_to_string(out, rt, text)
    write_rt_bool_to_string(out, rt, text)
    write_rt_print_bool(out, rt, text)
    write_rt_print_string(out, rt, text)
    write_rt_join_strings(out, rt, text)
    write_rt_join_many(out, rt, text)
    write_rt_strings_equal(out, rt, text)
    write_rt_error_text(out, rt, text)
    write_rt_file_name_of(out, rt, text)
    write_rt_run_error(out, rt, text)
    write_rt_stop_with_error(out, rt, text)
    write_rt_divide_by_zero(out, rt, text)
    write_rt_out_of_memory(out, rt, text)
    write_rt_format_float(out, rt, text)
    write_rt_print_float(out, rt, text)
    write_rt_float_to_string(out, rt, text)
    write_rt_float_to_int(out, rt, text)
    write_rt_float_mod(out, rt, text)
    write_rt_builder_start(out, rt, text)
    write_rt_builder_add(out, rt, text)
    write_rt_builder_add_string(out, rt, text)
    write_rt_builder_to_string(out, rt, text)
    write_rt_builder_add_int(out, rt, text)
    write_rt_index_error(out, rt, text)
    write_rt_string_at(out, rt, text)
    write_rt_new_array(out, rt, text)
    write_rt_array_add(out, rt, text)
    write_rt_array_pop(out, rt, text)
    write_rt_array_address(out, rt, text)
    write_rt_array_at(out, rt, text)
    write_rt_builder_add_float(out, rt, text)
    write_rt_builder_add_bool(out, rt, text)
    write_rt_builder_add_quoted(out, rt, text)
    write_rt_builder_print(out, rt, text)
    write_rt_show_enter(out, rt, text)
    write_rt_show_leave(out, rt, text)
    write_rt_text_error(out, rt, text)
    write_rt_string_to_int(out, rt, text)
    write_rt_big_times_ten(out, rt, text)
    write_rt_big_double(out, rt, text)
    write_rt_big_compare(out, rt, text)
    write_rt_big_subtract(out, rt, text)
    write_rt_string_to_float(out, rt, text)
    write_rt_string_to_float_body(out, rt, text)
    write_rt_big_subtract_clear(out, rt, text)
    write_rt_to_wide(out, rt, text)
    write_rt_to_wide_body(out, rt, text)
    write_rt_read_whole_file(out, rt, text)
    write_rt_read_whole_file_body(out, rt, text)
    write_rt_write_whole_file(out, rt, text)
    write_rt_write_whole_file_body(out, rt, text)
    write_rt_file_exists(out, rt, text)
    write_rt_stdin_refill(out, rt, text)
    write_rt_read_line(out, rt, text)
    write_rt_builder_add_byte(out, rt, text)
    write_rt_builder_add_letter(out, rt, text)
    write_rt_get_args(out, rt, text)
    write_rt_get_args_body(out, rt, text)
    write_rt_add_backslash_run(out, rt, text)
    write_rt_raw_free(out, rt, text)
    write_rt_alloc(out, rt, text)
    write_rt_alloc_text(out, rt, text)
    write_rt_alloc_block(out, rt, text)
    write_rt_alloc_again(out, rt, text)
    write_rt_alloc_take(out, rt, text)
    write_rt_alloc_slow(out, rt, text)
    write_rt_cleaner_start(out, rt, text)
    write_rt_cleaner_verify(out, rt, text)
    write_rt_cleaner_add_to_table(out, rt, text)
    write_rt_cleaner_mark_word(out, rt, text)
    write_rt_cleaner_clean(out, rt, text)
    write_rt_show_calls(out, rt, text)
end
