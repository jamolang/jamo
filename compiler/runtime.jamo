# Made by runtime/make_runtime.py from runtime.dsl. Change that, not this.
#
# Each runtime routine is real machine code, written out as hex, with its instruction beside it.

use "assembler.jamo"

const R_EXIT = 0
const R_WRITE = 1
const R_RAW_ALLOC = 2
const R_FORMAT_INT = 3
const R_MAKE_STRING = 4
const R_PRINT_INT = 5
const R_INT_TO_STRING = 6
const R_BOOL_TO_STRING = 7
const R_PRINT_BOOL = 8
const R_PRINT_STRING = 9
const R_JOIN_STRINGS = 10
const R_JOIN_MANY = 11
const R_STRINGS_EQUAL = 12
const R_ERROR_TEXT = 13
const R_FILE_NAME_OF = 14
const R_RUN_ERROR = 15
const R_STOP_WITH_ERROR = 16
const R_DIVIDE_BY_ZERO = 17
const R_OUT_OF_MEMORY = 18
const R_FORMAT_FLOAT = 19
const R_PRINT_FLOAT = 20
const R_FLOAT_TO_STRING = 21
const R_FLOAT_TO_INT = 22
const R_FLOAT_MOD = 23
const R_BUILDER_START = 24
const R_BUILDER_ADD = 25
const R_BUILDER_ADD_STRING = 26
const R_BUILDER_TO_STRING = 27
const R_BUILDER_ADD_INT = 28
const R_INDEX_ERROR = 29
const R_STRING_AT = 30
const R_NEW_ARRAY = 31
const R_ARRAY_ADD = 32
const R_ARRAY_POP = 33
const R_ARRAY_ADDRESS = 34
const R_ARRAY_AT = 35
const R_BUILDER_ADD_FLOAT = 36
const R_BUILDER_ADD_BOOL = 37
const R_BUILDER_ADD_QUOTED = 38
const R_BUILDER_PRINT = 39
const R_SHOW_ENTER = 40
const R_SHOW_LEAVE = 41
const R_TEXT_ERROR = 42
const R_STRING_TO_INT = 43
const R_BIG_TIMES_TEN = 44
const R_BIG_DOUBLE = 45
const R_BIG_COMPARE = 46
const R_BIG_SUBTRACT = 47
const R_STRING_TO_FLOAT = 48
const R_STRING_TO_FLOAT_BODY = 49
const R_BIG_SUBTRACT_CLEAR = 50
const R_TO_WIDE = 51
const R_TO_WIDE_BODY = 52
const R_READ_WHOLE_FILE = 53
const R_READ_WHOLE_FILE_BODY = 54
const R_WRITE_WHOLE_FILE = 55
const R_WRITE_WHOLE_FILE_BODY = 56
const R_FILE_EXISTS = 57
const R_STDIN_REFILL = 58
const R_READ_LINE = 59
const R_BUILDER_ADD_BYTE = 60
const R_BUILDER_ADD_LETTER = 61
const R_GET_ARGS = 62
const R_GET_ARGS_BODY = 63
const R_ADD_BACKSLASH_RUN = 64
const R_RAW_FREE = 65
const R_ALLOC = 66
const R_ALLOC_TEXT = 67
const R_ALLOC_BLOCK = 68
const R_ALLOC_AGAIN = 69
const R_ALLOC_TAKE = 70
const R_ALLOC_SLOW = 71
const R_CLEANER_START = 72
const R_CLEANER_VERIFY = 73
const R_CLEANER_ADD_TO_TABLE = 74
const R_CLEANER_MARK_WORD = 75
const R_CLEANER_CLEAN = 76
const R_SHOW_CALLS = 77
const RUNTIME_ROUTINES = 78

# rcx = exit code. A window program that collected a run error shows it in a message box first, since it has no console
func write_rt_exit(out: Assembler, rt: [int], text: RuntimeText)
    var at_box_done = out.new_label()
    var at_plain_exit = out.new_label()
    out.place(rt[R_EXIT])
    out.lea_data(REG_RAX, DATA_CLEANER, 0)
    out.hex("f6402010")  # test byte ptr [rax+32], 16
    out.jump_if_equal(at_plain_exit)
    out.lea_data(REG_RAX, DATA_ERROR_TEXT, 0)
    out.hex("48833800")  # cmp qword ptr [rax], 0
    out.jump_if_equal(at_plain_exit)
    out.hex("4889cb")  # mov rbx, rcx
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.lea_string(REG_RCX, text.user32_dll)
    out.hex("4883c108")  # add rcx, 8
    out.call_windows(DATA_LOAD_LIBRARY_A)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_box_done)
    out.hex("4889c1")  # mov rcx, rax
    out.lea_string(REG_RDX, text.message_box)
    out.hex("4883c208")  # add rdx, 8
    out.call_windows(DATA_GET_PROC_ADDRESS)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_box_done)
    out.hex("4989c3")  # mov r11, rax
    out.hex("31c9")  # xor ecx, ecx
    out.lea_data(REG_RDX, DATA_ERROR_TEXT, 0)
    out.hex("4883c208")  # add rdx, 8
    out.lea_string(REG_R8, text.error_title)
    out.hex("4983c008")  # add r8, 8
    out.hex("41b910000000")  # mov r9d, 16
    out.call_r11()
    out.place(at_box_done)
    out.hex("4889d9")  # mov rcx, rbx
    out.place(at_plain_exit)
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.call_windows(DATA_EXIT_PROCESS)
end

# rcx = which stream, rdx = the text, r8 = its length. Keeps rbx, rsi and rdi for its callers. A window program has no console, so what goes to the error stream is kept for exit's message box, up to 4095 bytes
func write_rt_write(out: Assembler, rt: [int], text: RuntimeText)
    var at_to_stream = out.new_label()
    var at_next_part = out.new_label()
    var at_finished = out.new_label()
    out.place(rt[R_WRITE])
    out.hex("4883f9f4")  # cmp rcx, -12
    out.jump_if_not_equal(at_to_stream)
    out.lea_data(REG_R9, DATA_CLEANER, 0)
    out.hex("41f6412010")  # test byte ptr [r9+32], 16
    out.jump_if_equal(at_to_stream)
    out.hex("56")  # push rsi
    out.hex("57")  # push rdi
    out.lea_data(REG_R9, DATA_ERROR_TEXT, 0)
    out.hex("498b39")  # mov rdi, qword ptr [r9]
    out.hex("48c7c1ff0f0000")  # mov rcx, 4095
    out.hex("4829f9")  # sub rcx, rdi
    out.hex("4c39c1")  # cmp rcx, r8
    out.hex("490f47c8")  # cmova rcx, r8
    out.hex("490109")  # add qword ptr [r9], rcx
    out.hex("498d7c3908")  # lea rdi, [r9+rdi+8]
    out.hex("4889d6")  # mov rsi, rdx
    out.hex("f3a4")  # rep movsb
    out.hex("5f")  # pop rdi
    out.hex("5e")  # pop rsi
    out.hex("c3")  # ret
    out.place(at_to_stream)
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("53")  # push rbx
    out.hex("56")  # push rsi
    out.hex("57")  # push rdi
    out.hex("4889d3")  # mov rbx, rdx
    out.hex("4c89c6")  # mov rsi, r8
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec30")  # sub rsp, 48
    out.call_windows(DATA_GET_STD_HANDLE)
    out.hex("4889c7")  # mov rdi, rax
    out.place(at_next_part)
    out.hex("4885f6")  # test rsi, rsi
    out.jump_if_equal(at_finished)
    out.hex("4989f0")  # mov r8, rsi
    out.hex("b800000040")  # mov eax, 0x40000000
    out.hex("4939c0")  # cmp r8, rax
    out.hex("4c0f47c0")  # cmova r8, rax
    out.hex("4889f9")  # mov rcx, rdi
    out.hex("4889da")  # mov rdx, rbx
    out.hex("4c8d4c2428")  # lea r9, [rsp+40]
    out.hex("48c744242000000000")  # mov qword ptr [rsp+32], 0
    out.call_windows(DATA_WRITE_FILE)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_finished)
    out.hex("8b442428")  # mov eax, dword ptr [rsp+40]
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_finished)
    out.hex("4801c3")  # add rbx, rax
    out.hex("4829c6")  # sub rsi, rax
    out.jump(at_next_part)
    out.place(at_finished)
    out.hex("488d65e8")  # lea rsp, [rbp-24]
    out.hex("5f")  # pop rdi
    out.hex("5e")  # pop rsi
    out.hex("5b")  # pop rbx
    out.hex("5d")  # pop rbp
    out.hex("c3")  # ret
end

# rcx = bytes wanted, for the text builder and the like, which the cleaner never touches. Keeps rbx, rsi and rdi
func write_rt_raw_alloc(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_RAW_ALLOC])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec20")  # sub rsp, 32
    out.hex("4989c8")  # mov r8, rcx
    out.hex("31d2")  # xor edx, edx
    out.load_rcx_data(DATA_HEAP_HANDLE)
    out.call_windows(DATA_HEAP_ALLOC)
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(rt[R_OUT_OF_MEMORY])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the int, rdi = where the text must end. Answers with its start in rdx, building it backward
func write_rt_format_int(out: Assembler, rt: [int], text: RuntimeText)
    var at_positive = out.new_label()
    var at_next_digit = out.new_label()
    var at_no_sign = out.new_label()
    out.place(rt[R_FORMAT_INT])
    out.hex("4989fa")  # mov r10, rdi
    out.hex("4531db")  # xor r11d, r11d
    out.hex("4885c0")  # test rax, rax
    out.jump_if_not_negative(at_positive)
    out.hex("41bb01000000")  # mov r11d, 1
    out.hex("48f7d8")  # neg rax
    out.place(at_positive)
    out.hex("b90a000000")  # mov ecx, 10
    out.place(at_next_digit)
    out.hex("31d2")  # xor edx, edx
    out.hex("48f7f1")  # div rcx
    out.hex("80c230")  # add dl, 48
    out.hex("49ffca")  # dec r10
    out.hex("418812")  # mov byte ptr [r10], dl
    out.hex("4885c0")  # test rax, rax
    out.jump_if_not_equal(at_next_digit)
    out.hex("4d85db")  # test r11, r11
    out.jump_if_equal(at_no_sign)
    out.hex("49ffca")  # dec r10
    out.hex("41c6022d")  # mov byte ptr [r10], 45
    out.place(at_no_sign)
    out.hex("4c89d2")  # mov rdx, r10
    out.hex("c3")  # ret
end

# rdx = the text, r8 = its length. Answers with a new string in rax
func write_rt_make_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_MAKE_STRING])
    out.hex("4889d3")  # mov rbx, rdx
    out.hex("4c89c6")  # mov rsi, r8
    out.hex("498d4809")  # lea rcx, [r8+9]
    out.call(rt[R_ALLOC_TEXT])
    out.hex("4989c1")  # mov r9, rax
    out.hex("498931")  # mov qword ptr [r9], rsi
    out.hex("498d7908")  # lea rdi, [r9+8]
    out.hex("4889f1")  # mov rcx, rsi
    out.hex("4889de")  # mov rsi, rbx
    out.hex("f3a4")  # rep movsb
    out.hex("c6070a")  # mov byte ptr [rdi], 10
    out.hex("4c89c8")  # mov rax, r9
    out.hex("c3")  # ret
end

# rax = the int
func write_rt_print_int(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_PRINT_INT])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec30")  # sub rsp, 48
    out.hex("c645ff0a")  # mov byte ptr [rbp-1], 10
    out.hex("488d7dff")  # lea rdi, [rbp-1]
    out.call(rt[R_FORMAT_INT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.hex("48c7c1f5ffffff")  # mov rcx, -11
    out.call(rt[R_WRITE])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the int
func write_rt_int_to_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_INT_TO_STRING])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec30")  # sub rsp, 48
    out.hex("4889ef")  # mov rdi, rbp
    out.call(rt[R_FORMAT_INT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.call(rt[R_MAKE_STRING])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the bool. Answers with the shared true or false string
func write_rt_bool_to_string(out: Assembler, rt: [int], text: RuntimeText)
    var at_is_false = out.new_label()
    out.place(rt[R_BOOL_TO_STRING])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_is_false)
    out.lea_rax_string(text.true_word)
    out.hex("c3")  # ret
    out.place(at_is_false)
    out.lea_rax_string(text.false_word)
    out.hex("c3")  # ret
end

# rax = the bool
func write_rt_print_bool(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_PRINT_BOOL])
    out.call(rt[R_BOOL_TO_STRING])
    out.jump(rt[R_PRINT_STRING])
end

# rax = the string. Every string keeps a hidden new line just past its end
func write_rt_print_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_PRINT_STRING])
    out.hex("488d5008")  # lea rdx, [rax+8]
    out.hex("4c8b00")  # mov r8, qword ptr [rax]
    out.hex("49ffc0")  # inc r8
    out.hex("48c7c1f5ffffff")  # mov rcx, -11
    out.jump(rt[R_WRITE])
end

# rax = the left string, rcx = the right string
func write_rt_join_strings(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_JOIN_STRINGS])
    out.hex("4889c3")  # mov rbx, rax
    out.hex("4889ce")  # mov rsi, rcx
    out.hex("488b0b")  # mov rcx, qword ptr [rbx]
    out.hex("48030e")  # add rcx, qword ptr [rsi]
    out.hex("4883c109")  # add rcx, 9
    out.call(rt[R_ALLOC_TEXT])
    out.hex("4989c0")  # mov r8, rax
    out.hex("488b0b")  # mov rcx, qword ptr [rbx]
    out.hex("48030e")  # add rcx, qword ptr [rsi]
    out.hex("498908")  # mov qword ptr [r8], rcx
    out.hex("498d7808")  # lea rdi, [r8+8]
    out.hex("4889f2")  # mov rdx, rsi
    out.hex("488d7308")  # lea rsi, [rbx+8]
    out.hex("488b0b")  # mov rcx, qword ptr [rbx]
    out.hex("f3a4")  # rep movsb
    out.hex("488d7208")  # lea rsi, [rdx+8]
    out.hex("488b0a")  # mov rcx, qword ptr [rdx]
    out.hex("f3a4")  # rep movsb
    out.hex("c6070a")  # mov byte ptr [rdi], 10
    out.hex("4c89c0")  # mov rax, r8
    out.hex("c3")  # ret
end

# rcx = how many strings, 2 or more, pushed in order before the call. Answers with them joined, made once. The caller takes them off the stack
func write_rt_join_many(out: Assembler, rt: [int], text: RuntimeText)
    var at_add_length = out.new_label()
    var at_copy_part = out.new_label()
    out.place(rt[R_JOIN_MANY])
    out.hex("4889cb")  # mov rbx, rcx
    out.hex("31c9")  # xor ecx, ecx
    out.hex("488d742408")  # lea rsi, [rsp+8]
    out.hex("4889da")  # mov rdx, rbx
    out.place(at_add_length)
    out.hex("488b06")  # mov rax, qword ptr [rsi]
    out.hex("480308")  # add rcx, qword ptr [rax]
    out.hex("4883c608")  # add rsi, 8
    out.hex("48ffca")  # dec rdx
    out.jump_if_not_equal(at_add_length)
    out.hex("4989c8")  # mov r8, rcx
    out.hex("4883c109")  # add rcx, 9
    out.call(rt[R_ALLOC_TEXT])
    out.hex("4c8900")  # mov qword ptr [rax], r8
    out.hex("488d7808")  # lea rdi, [rax+8]
    out.hex("488d14dc")  # lea rdx, [rsp+rbx*8]
    out.place(at_copy_part)
    out.hex("488b32")  # mov rsi, qword ptr [rdx]
    out.hex("488b0e")  # mov rcx, qword ptr [rsi]
    out.hex("4883c608")  # add rsi, 8
    out.hex("f3a4")  # rep movsb
    out.hex("4883ea08")  # sub rdx, 8
    out.hex("48ffcb")  # dec rbx
    out.jump_if_not_equal(at_copy_part)
    out.hex("c6070a")  # mov byte ptr [rdi], 10
    out.hex("c3")  # ret
end

# rax = one string, rcx = the other. Answers with a bool. The same string is equal to itself without looking
func write_rt_strings_equal(out: Assembler, rt: [int], text: RuntimeText)
    var at_same = out.new_label()
    var at_different = out.new_label()
    out.place(rt[R_STRINGS_EQUAL])
    out.hex("4839c8")  # cmp rax, rcx
    out.jump_if_equal(at_same)
    out.hex("4889c6")  # mov rsi, rax
    out.hex("4889cf")  # mov rdi, rcx
    out.hex("488b0e")  # mov rcx, qword ptr [rsi]
    out.hex("483b0f")  # cmp rcx, qword ptr [rdi]
    out.jump_if_not_equal(at_different)
    out.hex("4883c608")  # add rsi, 8
    out.hex("4883c708")  # add rdi, 8
    out.hex("31c0")  # xor eax, eax
    out.hex("f3a6")  # repe cmpsb
    out.hex("0f94c0")  # sete al
    out.hex("c3")  # ret
    out.place(at_same)
    out.hex("b801000000")  # mov eax, 1
    out.hex("c3")  # ret
    out.place(at_different)
    out.hex("31c0")  # xor eax, eax
    out.hex("c3")  # ret
end

# rax = the string, written to the error stream with no new line
func write_rt_error_text(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_ERROR_TEXT])
    out.hex("488d5008")  # lea rdx, [rax+8]
    out.hex("4c8b00")  # mov r8, qword ptr [rax]
    out.hex("48c7c1f4ffffff")  # mov rcx, -12
    out.jump(rt[R_WRITE])
end

# rax = which file. Answers with its name
func write_rt_file_name_of(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_FILE_NAME_OF])
    for i in 1..len(text.file_names)
        var next = out.new_label()
        out.mov_rcx_number(i)
        out.cmp_rax_rcx()
        out.jump_if_not_equal(next)
        out.lea_rax_string(text.file_names[i])
        out.hex("c3")
        out.place(next)
    end
    out.lea_rax_string(text.file_names[0])
    out.hex("c3")  # ret
end

# rax = the message. With a try open, goes back to that try's rbp and rsp and jumps to its catch with the message still in rax, making the try around it the newest. Otherwise shows the file and line, then stops with exit code 1
func write_rt_run_error(out: Assembler, rt: [int], text: RuntimeText)
    var at_not_caught = out.new_label()
    out.place(rt[R_RUN_ERROR])
    out.lea_data(REG_RCX, DATA_TRY_FRAME, 0)
    out.hex("488b11")  # mov rdx, qword ptr [rcx]
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_equal(at_not_caught)
    out.hex("4c8b02")  # mov r8, qword ptr [rdx]
    out.hex("4c8901")  # mov qword ptr [rcx], r8
    out.hex("488b6a08")  # mov rbp, qword ptr [rdx+8]
    out.hex("488b6210")  # mov rsp, qword ptr [rdx+16]
    out.hex("ff7218")  # push qword ptr [rdx+24]
    out.hex("c3")  # ret
    out.place(at_not_caught)
    out.jump(rt[R_STOP_WITH_ERROR])
end

# rax = the message. Shows the file and line, then stops with exit code 1, even with a try open
func write_rt_stop_with_error(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_STOP_WITH_ERROR])
    out.hex("4889c3")  # mov rbx, rax
    out.load_rax_data(DATA_CURRENT_LINE)
    out.hex("4989c4")  # mov r12, rax
    out.hex("48c1e820")  # shr rax, 32
    out.call(rt[R_FILE_NAME_OF])
    out.call(rt[R_ERROR_TEXT])
    out.lea_rax_string(text.line_word)
    out.call(rt[R_ERROR_TEXT])
    out.hex("4883ec30")  # sub rsp, 48
    out.hex("4489e0")  # mov eax, r12d
    out.hex("488d7c2430")  # lea rdi, [rsp+48]
    out.call(rt[R_FORMAT_INT])
    out.hex("4c8d442430")  # lea r8, [rsp+48]
    out.hex("4929d0")  # sub r8, rdx
    out.hex("48c7c1f4ffffff")  # mov rcx, -12
    out.call(rt[R_WRITE])
    out.lea_rax_string(text.error_word)
    out.call(rt[R_ERROR_TEXT])
    out.hex("488d5308")  # lea rdx, [rbx+8]
    out.hex("4c8b03")  # mov r8, qword ptr [rbx]
    out.hex("49ffc0")  # inc r8
    out.hex("48c7c1f4ffffff")  # mov rcx, -12
    out.call(rt[R_WRITE])
    out.call(rt[R_SHOW_CALLS])
    out.hex("b901000000")  # mov ecx, 1
    out.jump(rt[R_EXIT])
end

func write_rt_divide_by_zero(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_DIVIDE_BY_ZERO])
    out.lea_rax_string(text.divide_by_zero)
    out.jump(rt[R_RUN_ERROR])
end

# Can't be caught, since it can happen half way through the memory cleaner's work
func write_rt_out_of_memory(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_OUT_OF_MEMORY])
    out.lea_rax_string(text.out_of_memory)
    out.jump(rt[R_STOP_WITH_ERROR])
end

# rax = the float, rdi = where the text must end. Answers with its start in rdx, building it backward. Rounds exactly, like %.6f, using whole numbers only
func write_rt_format_float(out: Assembler, rt: [int], text: RuntimeText)
    var at_has_fraction = out.new_label()
    var at_only_fraction = out.new_label()
    var at_long_shift = out.new_label()
    var at_half_is_high = out.new_label()
    var at_half_added = out.new_label()
    var at_carry_check = out.new_label()
    var at_write_fixed = out.new_label()
    var at_has_decimals = out.new_label()
    var at_next_trim = out.new_label()
    var at_next_place = out.new_label()
    var at_write_dot = out.new_label()
    var at_add_sign = out.new_label()
    var at_all_done = out.new_label()
    var at_not_finite = out.new_label()
    var at_is_infinite = out.new_label()
    var at_scientific = out.new_label()
    var at_next_big_digit = out.new_label()
    var at_next_word = out.new_label()
    var at_check_rest = out.new_label()
    var at_is_tie = out.new_label()
    var at_round_up = out.new_label()
    var at_next_carry = out.new_label()
    var at_plain_increase = out.new_label()
    var at_rounded = out.new_label()
    var at_trim_zero = out.new_label()
    var at_copy_digit = out.new_label()
    out.place(rt[R_FORMAT_FLOAT])
    out.hex("4989c0")  # mov r8, rax
    out.hex("4889c3")  # mov rbx, rax
    out.hex("480fbaf33f")  # btr rbx, 63
    out.hex("48b8000000000000f07f")  # movabs rax, 0x7FF0000000000000
    out.hex("4839c3")  # cmp rbx, rax
    out.jump_if_at_least(at_not_finite)
    out.hex("48b80080e03779c34143")  # movabs rax, 0x4341C37937E08000
    out.hex("4839c3")  # cmp rbx, rax
    out.jump_if_at_least(at_scientific)
    out.hex("4531c9")  # xor r9d, r9d
    out.hex("31f6")  # xor esi, esi
    out.hex("4889d9")  # mov rcx, rbx
    out.hex("48c1e934")  # shr rcx, 52
    out.hex("4881f9ea030000")  # cmp rcx, 1002
    out.jump_if_below(at_write_fixed)
    out.hex("4889d8")  # mov rax, rbx
    out.hex("48baffffffffffff0f00")  # movabs rdx, 0x000FFFFFFFFFFFFF
    out.hex("4821d0")  # and rax, rdx
    out.hex("480fbae834")  # bts rax, 52
    out.hex("4881e933040000")  # sub rcx, 1075
    out.jump_if_less(at_has_fraction)
    out.hex("48d3e0")  # shl rax, cl
    out.hex("4989c1")  # mov r9, rax
    out.jump(at_write_fixed)
    out.place(at_has_fraction)
    out.hex("48f7d9")  # neg rcx
    out.hex("4883f940")  # cmp rcx, 64
    out.jump_if_at_least(at_only_fraction)
    out.hex("4989c1")  # mov r9, rax
    out.hex("49d3e9")  # shr r9, cl
    out.hex("ba01000000")  # mov edx, 1
    out.hex("48d3e2")  # shl rdx, cl
    out.hex("48ffca")  # dec rdx
    out.hex("4821d0")  # and rax, rdx
    out.place(at_only_fraction)
    out.hex("4989ca")  # mov r10, rcx
    out.hex("ba40420f00")  # mov edx, 1000000
    out.hex("48f7e2")  # mul rdx
    out.hex("4983fa40")  # cmp r10, 64
    out.jump_if_at_least(at_long_shift)
    out.hex("498d4aff")  # lea rcx, [r10-1]
    out.hex("41bb01000000")  # mov r11d, 1
    out.hex("49d3e3")  # shl r11, cl
    out.hex("4c01d8")  # add rax, r11
    out.hex("4883d200")  # adc rdx, 0
    out.hex("4c89d1")  # mov rcx, r10
    out.hex("4889c6")  # mov rsi, rax
    out.hex("480fadd6")  # shrd rsi, rdx, cl
    out.hex("41bb01000000")  # mov r11d, 1
    out.hex("49d3e3")  # shl r11, cl
    out.hex("49ffcb")  # dec r11
    out.hex("4c85d8")  # test rax, r11
    out.jump_if_not_equal(at_carry_check)
    out.hex("4883e6fe")  # and rsi, -2
    out.jump(at_carry_check)
    out.place(at_long_shift)
    out.hex("498d4ac0")  # lea rcx, [r10-64]
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_not_equal(at_half_is_high)
    out.hex("49bb0000000000000080")  # movabs r11, 0x8000000000000000
    out.hex("4c01d8")  # add rax, r11
    out.hex("4883d200")  # adc rdx, 0
    out.jump(at_half_added)
    out.place(at_half_is_high)
    out.hex("498d4abf")  # lea rcx, [r10-65]
    out.hex("41bb01000000")  # mov r11d, 1
    out.hex("49d3e3")  # shl r11, cl
    out.hex("4c01da")  # add rdx, r11
    out.place(at_half_added)
    out.hex("498d4ac0")  # lea rcx, [r10-64]
    out.hex("4889d6")  # mov rsi, rdx
    out.hex("48d3ee")  # shr rsi, cl
    out.hex("4885c0")  # test rax, rax
    out.jump_if_not_equal(at_carry_check)
    out.hex("41bb01000000")  # mov r11d, 1
    out.hex("49d3e3")  # shl r11, cl
    out.hex("49ffcb")  # dec r11
    out.hex("4c85da")  # test rdx, r11
    out.jump_if_not_equal(at_carry_check)
    out.hex("4883e6fe")  # and rsi, -2
    out.place(at_carry_check)
    out.hex("4881fe40420f00")  # cmp rsi, 1000000
    out.jump_if_not_equal(at_write_fixed)
    out.hex("49ffc1")  # inc r9
    out.hex("31f6")  # xor esi, esi
    out.place(at_write_fixed)
    out.hex("4989fa")  # mov r10, rdi
    out.hex("4885f6")  # test rsi, rsi
    out.jump_if_not_equal(at_has_decimals)
    out.hex("49ffca")  # dec r10
    out.hex("41c60230")  # mov byte ptr [r10], 48
    out.jump(at_write_dot)
    out.place(at_has_decimals)
    out.hex("41bb06000000")  # mov r11d, 6
    out.hex("b90a000000")  # mov ecx, 10
    out.place(at_next_trim)
    out.hex("4889f0")  # mov rax, rsi
    out.hex("31d2")  # xor edx, edx
    out.hex("48f7f1")  # div rcx
    out.hex("4885d2")  # test rdx, rdx
    out.jump_if_not_equal(at_next_place)
    out.hex("4889c6")  # mov rsi, rax
    out.hex("49ffcb")  # dec r11
    out.jump(at_next_trim)
    out.place(at_next_place)
    out.hex("4889f0")  # mov rax, rsi
    out.hex("31d2")  # xor edx, edx
    out.hex("48f7f1")  # div rcx
    out.hex("4889c6")  # mov rsi, rax
    out.hex("80c230")  # add dl, 48
    out.hex("49ffca")  # dec r10
    out.hex("418812")  # mov byte ptr [r10], dl
    out.hex("49ffcb")  # dec r11
    out.jump_if_not_equal(at_next_place)
    out.place(at_write_dot)
    out.hex("49ffca")  # dec r10
    out.hex("41c6022e")  # mov byte ptr [r10], 46
    out.hex("4c89d7")  # mov rdi, r10
    out.hex("4c89c8")  # mov rax, r9
    out.call(rt[R_FORMAT_INT])
    out.place(at_add_sign)
    out.hex("4d85c0")  # test r8, r8
    out.jump_if_not_negative(at_all_done)
    out.hex("48ffca")  # dec rdx
    out.hex("c6022d")  # mov byte ptr [rdx], 45
    out.place(at_all_done)
    out.hex("c3")  # ret
    out.place(at_not_finite)
    out.hex("488d57fd")  # lea rdx, [rdi-3]
    out.hex("48b8000000000000f07f")  # movabs rax, 0x7FF0000000000000
    out.hex("4839c3")  # cmp rbx, rax
    out.jump_if_equal(at_is_infinite)
    out.hex("c6026e")  # mov byte ptr [rdx], 110
    out.hex("c6420161")  # mov byte ptr [rdx+1], 97
    out.hex("c642026e")  # mov byte ptr [rdx+2], 110
    out.hex("c3")  # ret
    out.place(at_is_infinite)
    out.hex("c60269")  # mov byte ptr [rdx], 105
    out.hex("c642016e")  # mov byte ptr [rdx+1], 110
    out.hex("c6420266")  # mov byte ptr [rdx+2], 102
    out.jump(at_add_sign)
    out.place(at_scientific)
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4881ec00020000")  # sub rsp, 512
    out.hex("4989f9")  # mov r9, rdi
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("31c0")  # xor eax, eax
    out.hex("b910000000")  # mov ecx, 16
    out.hex("f348ab")  # rep stosq
    out.hex("4889d9")  # mov rcx, rbx
    out.hex("48c1e934")  # shr rcx, 52
    out.hex("4881e933040000")  # sub rcx, 1075
    out.hex("4889d8")  # mov rax, rbx
    out.hex("48baffffffffffff0f00")  # movabs rdx, 0x000FFFFFFFFFFFFF
    out.hex("4821d0")  # and rax, rdx
    out.hex("480fbae834")  # bts rax, 52
    out.hex("4889ca")  # mov rdx, rcx
    out.hex("48c1ea06")  # shr rdx, 6
    out.hex("83e13f")  # and ecx, 63
    out.hex("4531d2")  # xor r10d, r10d
    out.hex("490fa5c2")  # shld r10, rax, cl
    out.hex("48d3e0")  # shl rax, cl
    out.hex("488904d4")  # mov qword ptr [rsp+rdx*8], rax
    out.hex("4c8954d408")  # mov qword ptr [rsp+rdx*8+8], r10
    out.hex("488dbc2400020000")  # lea rdi, [rsp+512]
    out.hex("41ba0a000000")  # mov r10d, 10
    out.place(at_next_big_digit)
    out.hex("b90f000000")  # mov ecx, 15
    out.hex("31d2")  # xor edx, edx
    out.hex("4531db")  # xor r11d, r11d
    out.place(at_next_word)
    out.hex("488b04cc")  # mov rax, qword ptr [rsp+rcx*8]
    out.hex("49f7f2")  # div r10
    out.hex("488904cc")  # mov qword ptr [rsp+rcx*8], rax
    out.hex("4909c3")  # or r11, rax
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_negative(at_next_word)
    out.hex("80c230")  # add dl, 48
    out.hex("48ffcf")  # dec rdi
    out.hex("8817")  # mov byte ptr [rdi], dl
    out.hex("4d85db")  # test r11, r11
    out.jump_if_not_equal(at_next_big_digit)
    out.hex("4889fe")  # mov rsi, rdi
    out.hex("4c8d9424ff010000")  # lea r10, [rsp+511]
    out.hex("4929f2")  # sub r10, rsi
    out.hex("8a4607")  # mov al, byte ptr [rsi+7]
    out.hex("3c35")  # cmp al, 53
    out.jump_if_above(at_round_up)
    out.jump_if_below(at_rounded)
    out.hex("488d7e08")  # lea rdi, [rsi+8]
    out.hex("488d8c2400020000")  # lea rcx, [rsp+512]
    out.place(at_check_rest)
    out.hex("4839cf")  # cmp rdi, rcx
    out.jump_if_at_least(at_is_tie)
    out.hex("803f30")  # cmp byte ptr [rdi], 48
    out.jump_if_not_equal(at_round_up)
    out.hex("48ffc7")  # inc rdi
    out.jump(at_check_rest)
    out.place(at_is_tie)
    out.hex("f6460601")  # test byte ptr [rsi+6], 1
    out.jump_if_equal(at_rounded)
    out.place(at_round_up)
    out.hex("b906000000")  # mov ecx, 6
    out.place(at_next_carry)
    out.hex("803c0e39")  # cmp byte ptr [rsi+rcx], 57
    out.jump_if_not_equal(at_plain_increase)
    out.hex("c6040e30")  # mov byte ptr [rsi+rcx], 48
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_negative(at_next_carry)
    out.hex("c60631")  # mov byte ptr [rsi], 49
    out.hex("49ffc2")  # inc r10
    out.jump(at_rounded)
    out.place(at_plain_increase)
    out.hex("fe040e")  # inc byte ptr [rsi+rcx]
    out.place(at_rounded)
    out.hex("4c89cf")  # mov rdi, r9
    out.hex("4c89d0")  # mov rax, r10
    out.call(rt[R_FORMAT_INT])
    out.hex("48ffca")  # dec rdx
    out.hex("c6022b")  # mov byte ptr [rdx], 43
    out.hex("48ffca")  # dec rdx
    out.hex("c60265")  # mov byte ptr [rdx], 101
    out.hex("b906000000")  # mov ecx, 6
    out.place(at_trim_zero)
    out.hex("4883f901")  # cmp rcx, 1
    out.jump_if_equal(at_copy_digit)
    out.hex("803c0e30")  # cmp byte ptr [rsi+rcx], 48
    out.jump_if_not_equal(at_copy_digit)
    out.hex("48ffc9")  # dec rcx
    out.jump(at_trim_zero)
    out.place(at_copy_digit)
    out.hex("8a040e")  # mov al, byte ptr [rsi+rcx]
    out.hex("48ffca")  # dec rdx
    out.hex("8802")  # mov byte ptr [rdx], al
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_equal(at_copy_digit)
    out.hex("48ffca")  # dec rdx
    out.hex("c6022e")  # mov byte ptr [rdx], 46
    out.hex("8a06")  # mov al, byte ptr [rsi]
    out.hex("48ffca")  # dec rdx
    out.hex("8802")  # mov byte ptr [rdx], al
    out.hex("c9")  # leave
    out.jump(at_add_sign)
end

# rax = the float
func write_rt_print_float(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_PRINT_FLOAT])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec40")  # sub rsp, 64
    out.hex("c645ff0a")  # mov byte ptr [rbp-1], 10
    out.hex("488d7dff")  # lea rdi, [rbp-1]
    out.call(rt[R_FORMAT_FLOAT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.hex("48c7c1f5ffffff")  # mov rcx, -11
    out.call(rt[R_WRITE])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the float
func write_rt_float_to_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_FLOAT_TO_STRING])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec40")  # sub rsp, 64
    out.hex("4889ef")  # mov rdi, rbp
    out.call(rt[R_FORMAT_FLOAT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.call(rt[R_MAKE_STRING])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the float. The processor answers with the smallest int when a float doesn't fit
func write_rt_float_to_int(out: Assembler, rt: [int], text: RuntimeText)
    var at_too_large = out.new_label()
    var at_fits = out.new_label()
    out.place(rt[R_FLOAT_TO_INT])
    out.hex("66480f6ec0")  # movq xmm0, rax
    out.hex("f2480f2cc0")  # cvttsd2si rax, xmm0
    out.hex("48b90000000000000080")  # movabs rcx, 0x8000000000000000
    out.hex("4839c8")  # cmp rax, rcx
    out.jump_if_not_equal(at_fits)
    out.hex("48b9000000000000e0c3")  # movabs rcx, 0xC3E0000000000000
    out.hex("66480f6ec9")  # movq xmm1, rcx
    out.hex("660f2ec1")  # ucomisd xmm0, xmm1
    out.jump_if_unordered(at_too_large)
    out.jump_if_equal(at_fits)
    out.place(at_too_large)
    out.lea_rax_string(text.float_too_large)
    out.jump(rt[R_RUN_ERROR])
    out.place(at_fits)
    out.hex("c3")  # ret
end

# rax = the left float, rcx = the right float. The remainder keeps the left side's sign, like % on ints
func write_rt_float_mod(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_step = out.new_label()
    out.place(rt[R_FLOAT_MOD])
    out.hex("51")  # push rcx
    out.hex("dd0424")  # fld qword ptr [rsp]
    out.hex("48890424")  # mov qword ptr [rsp], rax
    out.hex("dd0424")  # fld qword ptr [rsp]
    out.place(at_next_step)
    out.hex("d9f8")  # fprem
    out.hex("dfe0")  # fnstsw ax
    out.hex("f6c404")  # test ah, 4
    out.jump_if_not_equal(at_next_step)
    out.hex("ddd9")  # fstp st(1)
    out.hex("dd1c24")  # fstp qword ptr [rsp]
    out.hex("58")  # pop rax
    out.hex("c3")  # ret
end

# The one text builder: its pointer, length and room. Clears it for new text
func write_rt_builder_start(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_START])
    out.lea_data(REG_RAX, DATA_BUILDER, 0)
    out.hex("48c7400800000000")  # mov qword ptr [rax+8], 0
    out.hex("c3")  # ret
end

# rdx = the text, r8 = its length. Keeps rbx, rsi and rdi
func write_rt_builder_add(out: Assembler, rt: [int], text: RuntimeText)
    var at_big_enough = out.new_label()
    var at_has_room = out.new_label()
    out.place(rt[R_BUILDER_ADD])
    out.hex("53")  # push rbx
    out.hex("56")  # push rsi
    out.hex("57")  # push rdi
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.lea_data(REG_RBX, DATA_BUILDER, 0)
    out.hex("4889d6")  # mov rsi, rdx
    out.hex("4d89c4")  # mov r12, r8
    out.hex("488b4308")  # mov rax, qword ptr [rbx+8]
    out.hex("4c01e0")  # add rax, r12
    out.hex("483b4310")  # cmp rax, qword ptr [rbx+16]
    out.jump_if_at_most(at_has_room)
    out.hex("488d0c00")  # lea rcx, [rax+rax]
    out.hex("4881f900010000")  # cmp rcx, 256
    out.jump_if_at_least(at_big_enough)
    out.hex("b900010000")  # mov ecx, 256
    out.place(at_big_enough)
    out.hex("48894b10")  # mov qword ptr [rbx+16], rcx
    out.call(rt[R_RAW_ALLOC])
    out.hex("4889c7")  # mov rdi, rax
    out.hex("4989f0")  # mov r8, rsi
    out.hex("488b33")  # mov rsi, qword ptr [rbx]
    out.hex("4989f5")  # mov r13, rsi
    out.hex("48893b")  # mov qword ptr [rbx], rdi
    out.hex("488b4b08")  # mov rcx, qword ptr [rbx+8]
    out.hex("f3a4")  # rep movsb
    out.hex("4c89c6")  # mov rsi, r8
    out.hex("4c89e9")  # mov rcx, r13
    out.call(rt[R_RAW_FREE])
    out.place(at_has_room)
    out.hex("488b3b")  # mov rdi, qword ptr [rbx]
    out.hex("48037b08")  # add rdi, qword ptr [rbx+8]
    out.hex("4c89e1")  # mov rcx, r12
    out.hex("f3a4")  # rep movsb
    out.hex("4c016308")  # add qword ptr [rbx+8], r12
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("5f")  # pop rdi
    out.hex("5e")  # pop rsi
    out.hex("5b")  # pop rbx
    out.hex("c3")  # ret
end

# rax = the string
func write_rt_builder_add_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_STRING])
    out.hex("488d5008")  # lea rdx, [rax+8]
    out.hex("4c8b00")  # mov r8, qword ptr [rax]
    out.jump(rt[R_BUILDER_ADD])
end

# Answers with the built text as a new string
func write_rt_builder_to_string(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_TO_STRING])
    out.lea_data(REG_RAX, DATA_BUILDER, 0)
    out.hex("488b10")  # mov rdx, qword ptr [rax]
    out.hex("4c8b4008")  # mov r8, qword ptr [rax+8]
    out.jump(rt[R_MAKE_STRING])
end

# rax = the int. Keeps rbx, rsi, r12 and r13
func write_rt_builder_add_int(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_INT])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec30")  # sub rsp, 48
    out.hex("4889ef")  # mov rdi, rbp
    out.call(rt[R_FORMAT_INT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.call(rt[R_BUILDER_ADD])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the index, rcx = the size, rdx = the words after the index, r8 = the words after the size
func write_rt_index_error(out: Assembler, rt: [int], text: RuntimeText)
    var at_not_items = out.new_label()
    var at_words_chosen = out.new_label()
    out.place(rt[R_INDEX_ERROR])
    out.hex("4883f901")  # cmp rcx, 1
    out.jump_if_not_equal(at_words_chosen)
    out.lea_string(REG_R9, text.items_word)
    out.hex("4d39c8")  # cmp r8, r9
    out.jump_if_not_equal(at_not_items)
    out.lea_string(REG_R8, text.item_word)
    out.jump(at_words_chosen)
    out.place(at_not_items)
    out.lea_string(REG_R9, text.bytes_word)
    out.hex("4d39c8")  # cmp r8, r9
    out.jump_if_not_equal(at_words_chosen)
    out.lea_string(REG_R8, text.byte_word)
    out.place(at_words_chosen)
    out.hex("4889c3")  # mov rbx, rax
    out.hex("4889ce")  # mov rsi, rcx
    out.hex("4989d4")  # mov r12, rdx
    out.hex("4d89c5")  # mov r13, r8
    out.call(rt[R_BUILDER_START])
    out.lea_string(REG_RAX, text.index_word)
    out.call(rt[R_BUILDER_ADD_STRING])
    out.hex("4889d8")  # mov rax, rbx
    out.call(rt[R_BUILDER_ADD_INT])
    out.hex("4c89e0")  # mov rax, r12
    out.call(rt[R_BUILDER_ADD_STRING])
    out.hex("4889f0")  # mov rax, rsi
    out.call(rt[R_BUILDER_ADD_INT])
    out.hex("4c89e8")  # mov rax, r13
    out.call(rt[R_BUILDER_ADD_STRING])
    out.call(rt[R_BUILDER_TO_STRING])
    out.jump(rt[R_RUN_ERROR])
end

# rax = the string, rcx = the index. Answers with that byte's one-letter string, which is shared, since text never changes
func write_rt_string_at(out: Assembler, rt: [int], text: RuntimeText)
    var at_outside = out.new_label()
    out.place(rt[R_STRING_AT])
    out.hex("483b08")  # cmp rcx, qword ptr [rax]
    out.jump_if_at_least(at_outside)
    out.hex("0fb6440808")  # movzx eax, byte ptr [rax+rcx+8]
    out.hex("c1e004")  # shl eax, 4
    out.lea_data(REG_RDX, DATA_LETTERS, 0)
    out.hex("4801d0")  # add rax, rdx
    out.hex("c3")  # ret
    out.place(at_outside)
    out.hex("4889ca")  # mov rdx, rcx
    out.hex("488b08")  # mov rcx, qword ptr [rax]
    out.hex("4889d0")  # mov rax, rdx
    out.lea_string(REG_RDX, text.outside_string)
    out.lea_string(REG_R8, text.bytes_word)
    out.jump(rt[R_INDEX_ERROR])
end

# rcx = how many items. An array is its length, its room and a pointer to its items, so it can grow and stay shared. An empty one gets its items on its first add, since most never get any
func write_rt_new_array(out: Assembler, rt: [int], text: RuntimeText)
    var at_enough_room = out.new_label()
    var at_stays_empty = out.new_label()
    out.place(rt[R_NEW_ARRAY])
    out.hex("4889cb")  # mov rbx, rcx
    out.hex("b918000000")  # mov ecx, 24
    out.call(rt[R_ALLOC])
    out.hex("4889c6")  # mov rsi, rax
    out.hex("4889d9")  # mov rcx, rbx
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_stays_empty)
    out.hex("4883f904")  # cmp rcx, 4
    out.jump_if_at_least(at_enough_room)
    out.hex("b904000000")  # mov ecx, 4
    out.place(at_enough_room)
    out.hex("4889cf")  # mov rdi, rcx
    out.hex("48c1e103")  # shl rcx, 3
    out.call(rt[R_ALLOC])
    out.hex("48894610")  # mov qword ptr [rsi+16], rax
    out.hex("48897e08")  # mov qword ptr [rsi+8], rdi
    out.hex("48891e")  # mov qword ptr [rsi], rbx
    out.hex("4889f0")  # mov rax, rsi
    out.hex("c3")  # ret
    out.place(at_stays_empty)
    out.hex("4889f0")  # mov rax, rsi
    out.hex("c3")  # ret
end

# rax = the array, rcx = the new item
func write_rt_array_add(out: Assembler, rt: [int], text: RuntimeText)
    var at_has_items = out.new_label()
    var at_has_room = out.new_label()
    out.place(rt[R_ARRAY_ADD])
    out.hex("4889c3")  # mov rbx, rax
    out.hex("4889ce")  # mov rsi, rcx
    out.hex("488b03")  # mov rax, qword ptr [rbx]
    out.hex("483b4308")  # cmp rax, qword ptr [rbx+8]
    out.jump_if_below(at_has_room)
    out.hex("488b4b08")  # mov rcx, qword ptr [rbx+8]
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_not_equal(at_has_items)
    out.hex("48c7430802000000")  # mov qword ptr [rbx+8], 2
    out.hex("b902000000")  # mov ecx, 2
    out.place(at_has_items)
    out.hex("48c1e104")  # shl rcx, 4
    out.call(rt[R_ALLOC])
    out.hex("4889c7")  # mov rdi, rax
    out.hex("48d16308")  # shl qword ptr [rbx+8], 1
    out.hex("4989f0")  # mov r8, rsi
    out.hex("488b7310")  # mov rsi, qword ptr [rbx+16]
    out.hex("48897b10")  # mov qword ptr [rbx+16], rdi
    out.hex("488b0b")  # mov rcx, qword ptr [rbx]
    out.hex("f348a5")  # rep movsq
    out.hex("4c89c6")  # mov rsi, r8
    out.place(at_has_room)
    out.hex("488b03")  # mov rax, qword ptr [rbx]
    out.hex("488b5310")  # mov rdx, qword ptr [rbx+16]
    out.hex("488934c2")  # mov qword ptr [rdx+rax*8], rsi
    out.hex("48ff03")  # inc qword ptr [rbx]
    out.hex("c3")  # ret
end

# rax = the array. Answers with its last item
func write_rt_array_pop(out: Assembler, rt: [int], text: RuntimeText)
    var at_is_empty = out.new_label()
    out.place(rt[R_ARRAY_POP])
    out.hex("488b08")  # mov rcx, qword ptr [rax]
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_is_empty)
    out.hex("48ffc9")  # dec rcx
    out.hex("488908")  # mov qword ptr [rax], rcx
    out.hex("488b5010")  # mov rdx, qword ptr [rax+16]
    out.hex("488b04ca")  # mov rax, qword ptr [rdx+rcx*8]
    out.hex("48c704ca00000000")  # mov qword ptr [rdx+rcx*8], 0
    out.hex("c3")  # ret
    out.place(at_is_empty)
    out.lea_string(REG_RAX, text.pop_empty)
    out.jump(rt[R_RUN_ERROR])
end

# rax = the array, rcx = the index. Answers with where that item lives, and keeps r9
func write_rt_array_address(out: Assembler, rt: [int], text: RuntimeText)
    var at_outside = out.new_label()
    out.place(rt[R_ARRAY_ADDRESS])
    out.hex("483b08")  # cmp rcx, qword ptr [rax]
    out.jump_if_at_least(at_outside)
    out.hex("488b4010")  # mov rax, qword ptr [rax+16]
    out.hex("488d04c8")  # lea rax, [rax+rcx*8]
    out.hex("c3")  # ret
    out.place(at_outside)
    out.hex("4889ca")  # mov rdx, rcx
    out.hex("488b08")  # mov rcx, qword ptr [rax]
    out.hex("4889d0")  # mov rax, rdx
    out.lea_string(REG_RDX, text.outside_array)
    out.lea_string(REG_R8, text.items_word)
    out.jump(rt[R_INDEX_ERROR])
end

# rax = the array, rcx = the index. Answers with that item
func write_rt_array_at(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_ARRAY_AT])
    out.call(rt[R_ARRAY_ADDRESS])
    out.hex("488b00")  # mov rax, qword ptr [rax]
    out.hex("c3")  # ret
end

# rax = the float
func write_rt_builder_add_float(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_FLOAT])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883ec40")  # sub rsp, 64
    out.hex("4889ef")  # mov rdi, rbp
    out.call(rt[R_FORMAT_FLOAT])
    out.hex("4989e8")  # mov r8, rbp
    out.hex("4929d0")  # sub r8, rdx
    out.call(rt[R_BUILDER_ADD])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
end

# rax = the bool
func write_rt_builder_add_bool(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_BOOL])
    out.call(rt[R_BOOL_TO_STRING])
    out.jump(rt[R_BUILDER_ADD_STRING])
end

# rax = the string, shown inside an array or struct
func write_rt_builder_add_quoted(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_ADD_QUOTED])
    out.hex("4889c3")  # mov rbx, rax
    out.lea_string(REG_RAX, text.quote)
    out.call(rt[R_BUILDER_ADD_STRING])
    out.hex("4889d8")  # mov rax, rbx
    out.call(rt[R_BUILDER_ADD_STRING])
    out.lea_string(REG_RAX, text.quote)
    out.jump(rt[R_BUILDER_ADD_STRING])
end

# Writes the built text and a new line
func write_rt_builder_print(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_BUILDER_PRINT])
    out.lea_string(REG_RAX, text.new_line)
    out.call(rt[R_BUILDER_ADD_STRING])
    out.lea_data(REG_RAX, DATA_BUILDER, 0)
    out.hex("488b10")  # mov rdx, qword ptr [rax]
    out.hex("4c8b4008")  # mov r8, qword ptr [rax+8]
    out.hex("48c7c1f5ffffff")  # mov rcx, -11
    out.jump(rt[R_WRITE])
end

# rax = the array or struct being shown. Answers with 1 if it's already being shown, so a loop of items can't go on forever. Otherwise links it in, using [rbp-16] and [rbp-24] of its caller
func write_rt_show_enter(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_visit = out.new_label()
    var at_found = out.new_label()
    var at_not_found = out.new_label()
    out.place(rt[R_SHOW_ENTER])
    out.lea_data(REG_RDX, DATA_VISIT_HEAD, 0)
    out.hex("488b0a")  # mov rcx, qword ptr [rdx]
    out.place(at_next_visit)
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_not_found)
    out.hex("48394108")  # cmp qword ptr [rcx+8], rax
    out.jump_if_equal(at_found)
    out.hex("488b09")  # mov rcx, qword ptr [rcx]
    out.jump(at_next_visit)
    out.place(at_found)
    out.hex("b801000000")  # mov eax, 1
    out.hex("c3")  # ret
    out.place(at_not_found)
    out.hex("488945f0")  # mov qword ptr [rbp-16], rax
    out.hex("488b0a")  # mov rcx, qword ptr [rdx]
    out.hex("48894de8")  # mov qword ptr [rbp-24], rcx
    out.hex("488d4de8")  # lea rcx, [rbp-24]
    out.hex("48890a")  # mov qword ptr [rdx], rcx
    out.hex("31c0")  # xor eax, eax
    out.hex("c3")  # ret
end

# Unlinks what show_enter linked in
func write_rt_show_leave(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_SHOW_LEAVE])
    out.lea_data(REG_RDX, DATA_VISIT_HEAD, 0)
    out.hex("488b45e8")  # mov rax, qword ptr [rbp-24]
    out.hex("488902")  # mov qword ptr [rdx], rax
    out.hex("c3")  # ret
end

# rax = some text from the program, rdx = the words before it, r8 = the words after it
func write_rt_text_error(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_TEXT_ERROR])
    out.hex("4889c3")  # mov rbx, rax
    out.hex("4989d4")  # mov r12, rdx
    out.hex("4d89c5")  # mov r13, r8
    out.call(rt[R_BUILDER_START])
    out.hex("4c89e0")  # mov rax, r12
    out.call(rt[R_BUILDER_ADD_STRING])
    out.hex("4889d8")  # mov rax, rbx
    out.call(rt[R_BUILDER_ADD_STRING])
    out.hex("4c89e8")  # mov rax, r13
    out.call(rt[R_BUILDER_ADD_STRING])
    out.call(rt[R_BUILDER_TO_STRING])
    out.jump(rt[R_RUN_ERROR])
end

# rax = the text. Takes digits with an optional minus sign, and nothing else
func write_rt_string_to_int(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_digit = out.new_label()
    var at_fits = out.new_label()
    var at_positive = out.new_label()
    var at_bad_number = out.new_label()
    out.place(rt[R_STRING_TO_INT])
    out.hex("4889c3")  # mov rbx, rax
    out.hex("488d7008")  # lea rsi, [rax+8]
    out.hex("488b08")  # mov rcx, qword ptr [rax]
    out.hex("4885c9")  # test rcx, rcx
    out.jump_if_equal(at_bad_number)
    out.hex("31ff")  # xor edi, edi
    out.hex("4531c0")  # xor r8d, r8d
    out.hex("41b90a000000")  # mov r9d, 10
    out.hex("803e2d")  # cmp byte ptr [rsi], 45
    out.jump_if_not_equal(at_next_digit)
    out.hex("bf01000000")  # mov edi, 1
    out.hex("48ffc6")  # inc rsi
    out.hex("48ffc9")  # dec rcx
    out.jump_if_equal(at_bad_number)
    out.place(at_next_digit)
    out.hex("0fb606")  # movzx eax, byte ptr [rsi]
    out.hex("83e830")  # sub eax, 48
    out.hex("83f809")  # cmp eax, 9
    out.jump_if_above(at_bad_number)
    out.hex("4989c2")  # mov r10, rax
    out.hex("4c89c0")  # mov rax, r8
    out.hex("49f7e1")  # mul r9
    out.jump_if_below(at_bad_number)
    out.hex("4c01d0")  # add rax, r10
    out.jump_if_below(at_bad_number)
    out.hex("4989c0")  # mov r8, rax
    out.hex("48ffc6")  # inc rsi
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_equal(at_next_digit)
    out.hex("48b80000000000000080")  # movabs rax, 0x8000000000000000
    out.hex("4939c0")  # cmp r8, rax
    out.jump_if_above(at_bad_number)
    out.jump_if_not_equal(at_fits)
    out.hex("85ff")  # test edi, edi
    out.jump_if_equal(at_bad_number)
    out.place(at_fits)
    out.hex("4c89c0")  # mov rax, r8
    out.hex("85ff")  # test edi, edi
    out.jump_if_equal(at_positive)
    out.hex("48f7d8")  # neg rax
    out.place(at_positive)
    out.hex("c3")  # ret
    out.place(at_bad_number)
    out.hex("4889d8")  # mov rax, rbx
    out.lea_string(REG_RDX, text.cant_turn)
    out.lea_string(REG_R8, text.into_int)
    out.jump(rt[R_TEXT_ERROR])
end

# rdi = a whole number of 128 words, rax = what to add afterward
func write_rt_big_times_ten(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_word = out.new_label()
    out.place(rt[R_BIG_TIMES_TEN])
    out.hex("4989c3")  # mov r11, rax
    out.hex("31c9")  # xor ecx, ecx
    out.place(at_next_word)
    out.hex("488b04cf")  # mov rax, qword ptr [rdi+rcx*8]
    out.hex("ba0a000000")  # mov edx, 10
    out.hex("48f7e2")  # mul rdx
    out.hex("4c01d8")  # add rax, r11
    out.hex("4883d200")  # adc rdx, 0
    out.hex("488904cf")  # mov qword ptr [rdi+rcx*8], rax
    out.hex("4989d3")  # mov r11, rdx
    out.hex("48ffc1")  # inc rcx
    out.hex("4881f980000000")  # cmp rcx, 128
    out.jump_if_below(at_next_word)
    out.hex("c3")  # ret
end

# rdi = a whole number of 128 words
func write_rt_big_double(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_word = out.new_label()
    out.place(rt[R_BIG_DOUBLE])
    out.hex("b980000000")  # mov ecx, 128
    out.hex("31c0")  # xor eax, eax
    out.place(at_next_word)
    out.hex("48d117")  # rcl qword ptr [rdi], 1
    out.hex("488d7f08")  # lea rdi, [rdi+8]
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_equal(at_next_word)
    out.hex("c3")  # ret
end

# rdi and rsi = two whole numbers of 128 words. Answers with less than, equal to or more than 0 in rax
func write_rt_big_compare(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_word = out.new_label()
    var at_different = out.new_label()
    out.place(rt[R_BIG_COMPARE])
    out.hex("b97f000000")  # mov ecx, 127
    out.place(at_next_word)
    out.hex("488b04cf")  # mov rax, qword ptr [rdi+rcx*8]
    out.hex("483b04ce")  # cmp rax, qword ptr [rsi+rcx*8]
    out.jump_if_not_equal(at_different)
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_negative(at_next_word)
    out.hex("31c0")  # xor eax, eax
    out.hex("c3")  # ret
    out.place(at_different)
    out.hex("4819c0")  # sbb rax, rax
    out.hex("4883c801")  # or rax, 1
    out.hex("c3")  # ret
end

# rdi = a whole number of 128 words, which rsi is taken away from
func write_rt_big_subtract(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_word = out.new_label()
    out.place(rt[R_BIG_SUBTRACT])
    out.hex("b980000000")  # mov ecx, 128
    out.hex("31d2")  # xor edx, edx
    out.place(at_next_word)
    out.hex("488b04d6")  # mov rax, qword ptr [rsi+rdx*8]
    out.hex("481904d7")  # sbb qword ptr [rdi+rdx*8], rax
    out.hex("48ffc2")  # inc rdx
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_equal(at_next_word)
    out.hex("c3")  # ret
end

# Keeps r12 to r15, where Jamo code may hold variables, around string_to_float_body
func write_rt_string_to_float(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_STRING_TO_FLOAT])
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.hex("4156")  # push r14
    out.hex("4157")  # push r15
    out.call(rt[R_STRING_TO_FLOAT_BODY])
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("c3")  # ret
end

# rax = the text. Rounds exactly, using whole numbers only. [rsp] holds the top of a fraction, and [rsp+1024] the bottom
func write_rt_string_to_float_body(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_char = out.new_label()
    var at_is_significant = out.new_label()
    var at_digit_counted = out.new_label()
    var at_too_many_digits = out.new_label()
    var at_char_done = out.new_label()
    var at_found_dot = out.new_label()
    var at_all_read = out.new_label()
    var at_scale_top = out.new_label()
    var at_scale_bottom = out.new_label()
    var at_scaled = out.new_label()
    var at_shift_bottom = out.new_label()
    var at_bottom_too_small = out.new_label()
    var at_top_too_small = out.new_label()
    var at_in_range = out.new_label()
    var at_has_precision = out.new_label()
    var at_next_bit = out.new_label()
    var at_bit_done = out.new_label()
    var at_check_rest = out.new_label()
    var at_round_up = out.new_label()
    var at_rounded = out.new_label()
    var at_has_answer = out.new_label()
    var at_bad_number = out.new_label()
    out.place(rt[R_STRING_TO_FLOAT_BODY])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4881ec00080000")  # sub rsp, 2048
    out.hex("48830c2400")  # or qword ptr [rsp], 0
    out.hex("4889c3")  # mov rbx, rax
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("31c0")  # xor eax, eax
    out.hex("b900010000")  # mov ecx, 256
    out.hex("f348ab")  # rep stosq
    out.hex("488d7308")  # lea rsi, [rbx+8]
    out.hex("4c8b03")  # mov r8, qword ptr [rbx]
    out.hex("4d85c0")  # test r8, r8
    out.jump_if_equal(at_bad_number)
    out.hex("4531ff")  # xor r15d, r15d
    out.hex("4531e4")  # xor r12d, r12d
    out.hex("4531ed")  # xor r13d, r13d
    out.hex("4531f6")  # xor r14d, r14d
    out.hex("4531c9")  # xor r9d, r9d
    out.hex("4531d2")  # xor r10d, r10d
    out.hex("803e2d")  # cmp byte ptr [rsi], 45
    out.jump_if_not_equal(at_next_char)
    out.hex("41bf01000000")  # mov r15d, 1
    out.hex("48ffc6")  # inc rsi
    out.hex("49ffc8")  # dec r8
    out.jump_if_equal(at_bad_number)
    out.place(at_next_char)
    out.hex("4d85c0")  # test r8, r8
    out.jump_if_equal(at_all_read)
    out.hex("0fb606")  # movzx eax, byte ptr [rsi]
    out.hex("3c2e")  # cmp al, 46
    out.jump_if_equal(at_found_dot)
    out.hex("83e830")  # sub eax, 48
    out.hex("83f809")  # cmp eax, 9
    out.jump_if_above(at_bad_number)
    out.hex("49ffc1")  # inc r9
    out.hex("4d85ed")  # test r13, r13
    out.jump_if_not_equal(at_is_significant)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_digit_counted)
    out.place(at_is_significant)
    out.hex("4981fd20030000")  # cmp r13, 800
    out.jump_if_at_least(at_too_many_digits)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.call(rt[R_BIG_TIMES_TEN])
    out.hex("49ffc5")  # inc r13
    out.place(at_digit_counted)
    out.hex("4d85d2")  # test r10, r10
    out.jump_if_equal(at_char_done)
    out.hex("49ffcc")  # dec r12
    out.jump(at_char_done)
    out.place(at_too_many_digits)
    out.hex("4909c6")  # or r14, rax
    out.hex("4d85d2")  # test r10, r10
    out.jump_if_not_equal(at_char_done)
    out.hex("49ffc4")  # inc r12
    out.place(at_char_done)
    out.hex("48ffc6")  # inc rsi
    out.hex("49ffc8")  # dec r8
    out.jump(at_next_char)
    out.place(at_found_dot)
    out.hex("4d85d2")  # test r10, r10
    out.jump_if_not_equal(at_bad_number)
    out.hex("4d85c9")  # test r9, r9
    out.jump_if_equal(at_bad_number)
    out.hex("41ba01000000")  # mov r10d, 1
    out.hex("48ffc6")  # inc rsi
    out.hex("49ffc8")  # dec r8
    out.jump_if_equal(at_bad_number)
    out.jump(at_next_char)
    out.place(at_all_read)
    out.hex("31c0")  # xor eax, eax
    out.hex("4d85ed")  # test r13, r13
    out.jump_if_equal(at_has_answer)
    out.hex("4b8d042c")  # lea rax, [r12+r13]
    out.hex("483d36010000")  # cmp rax, 310
    out.jump_if_greater(at_bad_number)
    out.hex("483db6feffff")  # cmp rax, -330
    out.jump_if_less(at_bad_number)
    out.hex("48c784240004000001000000")  # mov qword ptr [rsp+1024], 1
    out.place(at_scale_top)
    out.hex("4d85e4")  # test r12, r12
    out.jump_if_less_equal(at_scale_bottom)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("31c0")  # xor eax, eax
    out.call(rt[R_BIG_TIMES_TEN])
    out.hex("49ffcc")  # dec r12
    out.jump(at_scale_top)
    out.place(at_scale_bottom)
    out.hex("4d85e4")  # test r12, r12
    out.jump_if_greater_equal(at_scaled)
    out.hex("488dbc2400040000")  # lea rdi, [rsp+1024]
    out.hex("31c0")  # xor eax, eax
    out.call(rt[R_BIG_TIMES_TEN])
    out.hex("49ffc4")  # inc r12
    out.jump(at_scale_bottom)
    out.place(at_scaled)
    out.hex("41bd35000000")  # mov r13d, 53
    out.hex("41bc35000000")  # mov r12d, 53
    out.place(at_shift_bottom)
    out.hex("488dbc2400040000")  # lea rdi, [rsp+1024]
    out.call(rt[R_BIG_DOUBLE])
    out.hex("49ffcc")  # dec r12
    out.jump_if_not_equal(at_shift_bottom)
    out.place(at_bottom_too_small)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("488db42400040000")  # lea rsi, [rsp+1024]
    out.call(rt[R_BIG_COMPARE])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_negative(at_top_too_small)
    out.hex("488dbc2400040000")  # lea rdi, [rsp+1024]
    out.call(rt[R_BIG_DOUBLE])
    out.hex("49ffc5")  # inc r13
    out.jump(at_bottom_too_small)
    out.place(at_top_too_small)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("488db42400040000")  # lea rsi, [rsp+1024]
    out.call(rt[R_BIG_COMPARE])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_not_negative(at_in_range)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.call(rt[R_BIG_DOUBLE])
    out.hex("49ffcd")  # dec r13
    out.jump(at_top_too_small)
    out.place(at_in_range)
    out.hex("4981fdff030000")  # cmp r13, 1023
    out.jump_if_greater(at_bad_number)
    out.hex("41b935000000")  # mov r9d, 53
    out.hex("4981fd02fcffff")  # cmp r13, -1022
    out.jump_if_greater_equal(at_has_precision)
    out.hex("4d8d8d33040000")  # lea r9, [r13+1075]
    out.hex("4d85c9")  # test r9, r9
    out.jump_if_negative(at_bad_number)
    out.place(at_has_precision)
    out.hex("4d8d6101")  # lea r12, [r9+1]
    out.hex("4531d2")  # xor r10d, r10d
    out.place(at_next_bit)
    out.hex("49d1e2")  # shl r10, 1
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("488db42400040000")  # lea rsi, [rsp+1024]
    out.call(rt[R_BIG_COMPARE])
    out.hex("4885c0")  # test rax, rax
    out.jump_if_negative(at_bit_done)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.hex("488db42400040000")  # lea rsi, [rsp+1024]
    out.hex("f8")  # clc
    out.call(rt[R_BIG_SUBTRACT_CLEAR])
    out.hex("4983ca01")  # or r10, 1
    out.place(at_bit_done)
    out.hex("488d3c24")  # lea rdi, [rsp]
    out.call(rt[R_BIG_DOUBLE])
    out.hex("49ffcc")  # dec r12
    out.jump_if_not_equal(at_next_bit)
    out.hex("b97f000000")  # mov ecx, 127
    out.hex("31c0")  # xor eax, eax
    out.place(at_check_rest)
    out.hex("480b04cc")  # or rax, qword ptr [rsp+rcx*8]
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_negative(at_check_rest)
    out.hex("4909c6")  # or r14, rax
    out.hex("4d89d3")  # mov r11, r10
    out.hex("4983e301")  # and r11, 1
    out.hex("49d1ea")  # shr r10, 1
    out.hex("4d85db")  # test r11, r11
    out.jump_if_equal(at_rounded)
    out.hex("4d85f6")  # test r14, r14
    out.jump_if_not_equal(at_round_up)
    out.hex("49f7c201000000")  # test r10, 1
    out.jump_if_equal(at_rounded)
    out.place(at_round_up)
    out.hex("49ffc2")  # inc r10
    out.place(at_rounded)
    out.hex("4c89d0")  # mov rax, r10
    out.hex("4981fd02fcffff")  # cmp r13, -1022
    out.jump_if_less(at_has_answer)
    out.hex("498d8dfe030000")  # lea rcx, [r13+1022]
    out.hex("48c1e134")  # shl rcx, 52
    out.hex("4801c8")  # add rax, rcx
    out.hex("48b9000000000000f07f")  # movabs rcx, 0x7FF0000000000000
    out.hex("4839c8")  # cmp rax, rcx
    out.jump_if_at_least(at_bad_number)
    out.place(at_has_answer)
    out.hex("49c1e73f")  # shl r15, 63
    out.hex("4c09f8")  # or rax, r15
    out.hex("c9")  # leave
    out.hex("c3")  # ret
    out.place(at_bad_number)
    out.hex("4889d8")  # mov rax, rbx
    out.lea_string(REG_RDX, text.cant_turn)
    out.lea_string(REG_R8, text.into_float)
    out.jump(rt[R_TEXT_ERROR])
end

# The same as big_subtract, starting with nothing borrowed
func write_rt_big_subtract_clear(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_word = out.new_label()
    out.place(rt[R_BIG_SUBTRACT_CLEAR])
    out.hex("31d2")  # xor edx, edx
    out.hex("b980000000")  # mov ecx, 128
    out.hex("31c0")  # xor eax, eax
    out.place(at_next_word)
    out.hex("488b04d6")  # mov rax, qword ptr [rsi+rdx*8]
    out.hex("481904d7")  # sbb qword ptr [rdi+rdx*8], rax
    out.hex("48ffc2")  # inc rdx
    out.hex("48ffc9")  # dec rcx
    out.jump_if_not_equal(at_next_word)
    out.hex("c3")  # ret
end

# Keeps r12 to r15, where Jamo code may hold variables, around to_wide_body
func write_rt_to_wide(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_TO_WIDE])
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.hex("4156")  # push r14
    out.hex("4157")  # push r15
    out.call(rt[R_TO_WIDE_BODY])
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("c3")  # ret
end

# rax = a string. Answers with its text the way Windows' file functions want it. Keeps rbx and rsi
func write_rt_to_wide_body(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_TO_WIDE_BODY])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("53")  # push rbx
    out.hex("56")  # push rsi
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4883ec30")  # sub rsp, 48
    out.hex("4889c3")  # mov rbx, rax
    out.hex("b9e9fd0000")  # mov ecx, 65001
    out.hex("31d2")  # xor edx, edx
    out.hex("4c8d4308")  # lea r8, [rbx+8]
    out.hex("4c8b0b")  # mov r9, qword ptr [rbx]
    out.hex("48c744242000000000")  # mov qword ptr [rsp+32], 0
    out.hex("48c744242800000000")  # mov qword ptr [rsp+40], 0
    out.call_windows(DATA_MULTI_BYTE_TO_WIDE_CHAR)
    out.hex("89c6")  # mov esi, eax
    out.hex("488d4c0002")  # lea rcx, [rax+rax+2]
    out.call(rt[R_ALLOC_TEXT])
    out.hex("4989c4")  # mov r12, rax
    out.hex("b9e9fd0000")  # mov ecx, 65001
    out.hex("31d2")  # xor edx, edx
    out.hex("4c8d4308")  # lea r8, [rbx+8]
    out.hex("4c8b0b")  # mov r9, qword ptr [rbx]
    out.hex("4c89642420")  # mov qword ptr [rsp+32], r12
    out.hex("4889742428")  # mov qword ptr [rsp+40], rsi
    out.call_windows(DATA_MULTI_BYTE_TO_WIDE_CHAR)
    out.hex("6641c704740000")  # mov word ptr [r12+rsi*2], 0
    out.hex("4c89e0")  # mov rax, r12
    out.hex("488d65f0")  # lea rsp, [rbp-16]
    out.hex("5e")  # pop rsi
    out.hex("5b")  # pop rbx
    out.hex("5d")  # pop rbp
    out.hex("c3")  # ret
end

# Keeps r12 to r15, where Jamo code may hold variables, around read_whole_file_body
func write_rt_read_whole_file(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_READ_WHOLE_FILE])
    out.hex("4154")  # push r12
    out.hex("4155")  # push r13
    out.hex("4156")  # push r14
    out.hex("4157")  # push r15
    out.call(rt[R_READ_WHOLE_FILE_BODY])
    out.hex("415f")  # pop r15
    out.hex("415e")  # pop r14
    out.hex("415d")  # pop r13
    out.hex("415c")  # pop r12
    out.hex("c3")  # ret
end

# rax = the path
func write_rt_read_whole_file_body(out: Assembler, rt: [int], text: RuntimeText)
    var at_next_chunk = out.new_label()
    var at_finished = out.new_label()
    var at_failed = out.new_label()
    out.place(rt[R_READ_WHOLE_FILE_BODY])
    out.hex("55")  # push rbp
    out.hex("4889e5")  # mov rbp, rsp
    out.hex("4883e4f0")  # and rsp, -16
    out.hex("4881ece00f0000")  # sub rsp, 4064
    out.hex("48830c2400")  # or qword ptr [rsp], 0
    out.hex("4989c5")  # mov r13, rax
    out.call(rt[R_TO_WIDE])
    out.hex("4889c1")  # mov rcx, rax
    out.hex("ba00000080")  # mov edx, 0x80000000
    out.hex("41b803000000")  # mov r8d, 3
    out.hex("4531c9")  # xor r9d, r9d
    out.hex("48c744242003000000")  # mov qword ptr [rsp+32], 3
    out.hex("48c744242880000000")  # mov qword ptr [rsp+40], 0x80
    out.hex("48c744243000000000")  # mov qword ptr [rsp+48], 0
    out.call_windows(DATA_CREATE_FILE_W)
    out.hex("4883f8ff")  # cmp rax, -1
    out.jump_if_equal(at_failed)
    out.hex("4989c4")  # mov r12, rax
    out.call(rt[R_BUILDER_START])
    out.place(at_next_chunk)
    out.hex("4c89e1")  # mov rcx, r12
    out.hex("488d542440")  # lea rdx, [rsp+64]
    out.hex("41b8a00f0000")  # mov r8d, 4000
    out.hex("4c8d4c2438")  # lea r9, [rsp+56]
    out.hex("48c744242000000000")  # mov qword ptr [rsp+32], 0
    out.call_windows(DATA_READ_FILE)
    out.hex("85c0")  # test eax, eax
    out.jump_if_equal(at_failed)
    out.hex("8b442438")  # mov eax, dword ptr [rsp+56]
    out.hex("4885c0")  # test rax, rax
    out.jump_if_equal(at_finished)
    out.hex("488d542440")  # lea rdx, [rsp+64]
    out.hex("4989c0")  # mov r8, rax
    out.call(rt[R_BUILDER_ADD])
    out.jump(at_next_chunk)
    out.place(at_finished)
    out.hex("4c89e1")  # mov rcx, r12
    out.call_windows(DATA_CLOSE_HANDLE)
    out.call(rt[R_BUILDER_TO_STRING])
    out.hex("c9")  # leave
    out.hex("c3")  # ret
    out.place(at_failed)
    out.hex("4c89e8")  # mov rax, r13
    out.lea_string(REG_RDX, text.cant_read)
    out.lea_string(REG_R8, text.period)
    out.jump(rt[R_TEXT_ERROR])
end

# Keeps r12 to r15, where Jamo code may hold variables, around write_whole_file_body
func write_rt_write_whole_file(out: Assembler, rt: [int], text: RuntimeText)
    out.place(rt[R_WRITE_WHOLE_FILE])
