# Checks a program, then prints everything the code generator makes, the same way as 'jamo code', so the
# two code generators can be compared. jamo run code.jamo flags some_file.jamo writes code.out
# flags are the test flags: 1, 2 and 4 for the cleaner, 8 for no optimizing

use "modules.jamo"
use "checker.jamo"
use "codegen.jamo"
use "printer.jamo"

func file_name_only(path: string): string
    var parts = path_parts(path)
    if len(parts) == 0
        return path
    end
    return parts[len(parts) - 1]
end

func main()
    var flags = int(args()[0])
    var path = args()[1]
    var errors = new_errors()
    var program = new_program()
    if not load_program(path, errors, program)
        fail("I can't read a file called " + path + ".")
    end
    if not errors.any()
        check_program(program, errors)
    end
    if errors.any()
        fail(errors.text())
    end
    var g = generate_code(program, file_name_only(path), flags)
    var code = g.out.code
    var digits = "0123456789abcdef"
    var out = new_builder()
    out.line(f"bytes {code.length()}")
    for i in 0..code.length()
        var value = code.get_u8(i)
        out.add(digits[value / 16])
        out.add(digits[value % 16])
        if i % 32 == 31 or i + 1 == code.length()
            out.add("\n")
        end
    end
    var a = g.out
    for i in 0..len(a.fixup_offsets)
        out.line(f"fixup {a.fixup_offsets[i]} {a.fixup_targets[i]} {a.fixup_strings[i]} {a.fixup_extras[i]}")
    end
    for i in 0..len(a.call_offsets)
        out.line(f"call {a.call_offsets[i]} {a.call_strings[i]}")
    end
    for i in 0..len(g.import_names)
        out.line("import " + g.import_dlls[i] + " " + g.import_names[i])
    end
    for i in 0..len(g.strings)
        out.line(f"string {i} [" + escaped(g.strings[i]) + "]")
    end
    write_file("code.out", out.text())
end
