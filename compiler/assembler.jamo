# Up to 127 fits in one byte
func Assembler.sub_rsp(amount: int)
    if amount >= 0 and amount <= 127
        self.hex("4883ec")
        self.byte(amount)
        return
    end
    self.hex("4881ec")
    self.int32(amount)
end

func Assembler.add_rsp(amount: int)
    if amount >= 0 and amount <= 127
        self.hex("4883c4")
        self.byte(amount)
        return
    end
    self.hex("4881c4")
    self.int32(amount)
end

# Touches memory below the stack, so a big frame can't jump past Windows' stack guard
func Assembler.touch_stack_below(amount: int)
    self.hex("488b8424")
    self.int32(0 - amount)
end

func Assembler.jump(label: int)
    self.hex("e9")
    self.label_gap(label)
end

func Assembler.jump_when(condition: int, label: int)
    self.hex("0f")
    self.byte(condition)
    self.label_gap(label)
end

func Assembler.jump_if_equal(label: int)
    self.jump_when(132, label)
end

func Assembler.jump_if_not_equal(label: int)
    self.jump_when(133, label)
end

func Assembler.jump_if_not_negative(label: int)
    self.jump_when(137, label)
end

func Assembler.jump_if_negative(label: int)
    self.jump_when(136, label)
end

func Assembler.jump_if_below(label: int)
    self.jump_when(130, label)
end

func Assembler.jump_if_at_least(label: int)
    self.jump_when(131, label)
end

func Assembler.jump_if_at_most(label: int)
    self.jump_when(134, label)
end

func Assembler.jump_if_above(label: int)
    self.jump_when(135, label)
end

func Assembler.jump_if_unordered(label: int)
    self.jump_when(138, label)
end

func Assembler.jump_if_less(label: int)
    self.jump_when(140, label)
end

func Assembler.jump_if_less_equal(label: int)
    self.jump_when(142, label)
end

func Assembler.jump_if_greater(label: int)
    self.jump_when(143, label)
end

func Assembler.jump_if_greater_equal(label: int)
    self.jump_when(141, label)
end

func Assembler.call(label: int)
    self.hex("e8")
    self.label_gap(label)
end

func Assembler.call_windows(function: int)
    self.hex("ff15")
    self.data_gap(function, 0)
end

func Assembler.lea_data(reg: int, target: int, which: int)
    self.byte(72 + reg / 8 * 4)
    self.hex("8d")
    self.byte(reg % 8 * 8 + 5)
    self.data_gap(target, which)
end

func Assembler.lea_string(reg: int, which: int)
    self.lea_data(reg, DATA_STRING, which)
end

func Assembler.call_import(import: int)
    self.hex("ff15")
    self.data_gap(DATA_IMPORT, import)
end

# A spare 8 bytes in the data section, which only the code generator uses
func Assembler.load_rax_string_bytes(which: int)
    self.hex("488b05")
    self.fixup(DATA_STRING, which, 8)
end

func Assembler.store_rax_string_bytes(which: int)
    self.hex("488905")
    self.fixup(DATA_STRING, which, 8)
end

func Assembler.call_r11()
    self.hex("41ffd3")
end

func Assembler.mov_r11_rax()
    self.hex("4989c3")
end

func Assembler.lea_rax_label(label: int)
    self.hex("488d05")
    self.label_gap(label)
end

# Loads input number reg_number into its register for a Windows call, from where rbx points
func Assembler.load_reg_from_inputs(reg_number: int, is_float: bool, offset: int)
    if is_float
        var floats = ["f20f1083", "f20f108b", "f20f1093", "f20f109b"]
        self.hex(floats[reg_number])
    else
        var ints = ["488b8b", "488b93", "4c8b83", "4c8b8b"]
        self.hex(ints[reg_number])
    end
    self.int32(offset)
end

# An f32 input: the float shrinks to 32 bits in its register
func Assembler.shrink_float_in(reg_number: int)
    self.hex("f20f5a")
    self.byte(192 + reg_number * 8 + reg_number)
end

func Assembler.copy_f32_input_to_stack(from: int, to: int)
    self.hex("f20f1083")
    self.int32(from)
    self.hex("f20f5ac0f30f118424")
    self.int32(to)
end

func Assembler.grow_float_answer()
    self.hex("f30f5ac0")
end

func Assembler.copy_input_to_stack(from: int, to: int)
    self.hex("488b83")
    self.int32(from)
    self.hex("48898424")
    self.int32(to)
end

func Assembler.lea_rax_string(which: int)
    self.hex("488d05")
    self.data_gap(DATA_STRING, which)
end

func Assembler.load_rax_data(target: int)
    self.hex("488b05")
    self.data_gap(target, 0)
end

func Assembler.load_rcx_data(target: int)
    self.hex("488b0d")
    self.data_gap(target, 0)
end

func Assembler.store_rax_data(target: int)
    self.hex("488905")
    self.data_gap(target, 0)
end

# Remembers the file and line for run errors. Uses r11, which holds nothing in Jamo code
func Assembler.note_line(line: int)
    self.hex("49bb")
    self.int64(line)
    self.hex("4c891d")
    self.data_gap(DATA_CURRENT_LINE, 0)
end
