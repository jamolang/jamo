# Assembler: writes x86-64 instructions as bytes, and fills in the distances to labels. The same as
# src/assembler.hpp. Instructions are written as hex text, like "4889e5" for mov rbp, rsp.

use "bytes.jamo"

# Registers, numbered like the processor does
const REG_RAX = 0
const REG_RCX = 1
const REG_RDX = 2
const REG_RBX = 3
const REG_RSI = 6
const REG_RDI = 7
const REG_R8 = 8
const REG_R9 = 9

# Things the code points at, whose addresses only the .exe writer knows. Numbered like DataRef
const DATA_GET_STD_HANDLE = 0
const DATA_WRITE_FILE = 1
const DATA_EXIT_PROCESS = 2
const DATA_GET_PROCESS_HEAP = 3
const DATA_HEAP_ALLOC = 4
const DATA_CREATE_FILE_W = 5
const DATA_READ_FILE = 6
const DATA_CLOSE_HANDLE = 7
const DATA_GET_FILE_ATTRIBUTES_W = 8
const DATA_GET_COMMAND_LINE_W = 9
const DATA_MULTI_BYTE_TO_WIDE_CHAR = 10
const DATA_HEAP_FREE = 11
const DATA_LOAD_LIBRARY_A = 12
const DATA_GET_PROC_ADDRESS = 13
const DATA_HEAP_HANDLE = 14
const DATA_CURRENT_LINE = 15
const DATA_BUILDER = 16
const DATA_VISIT_HEAD = 17
const DATA_STDIN = 18
const DATA_CLEANER = 19
const DATA_LETTERS = 20
const DATA_ERROR_TEXT = 21
const DATA_CALL_TABLE = 22
const DATA_STRING = 23
const DATA_IMPORT = 24
const DATA_GLOBALS = 25
const DATA_TRY_FRAME = 26
const DATA_GET_CONSOLE_MODE = 27
const DATA_WRITE_CONSOLE_W = 28
const DATA_READ_CONSOLE_W = 29
const DATA_WIDE_CHAR_TO_MULTI_BYTE = 30

# Which entry in the program's string table holds each fixed text the runtime uses
struct RuntimeText
    file_names: [int]
    true_word: int
    false_word: int
    line_word: int
    error_word: int
    divide_by_zero: int
    out_of_memory: int
    float_too_large: int
    index_word: int
    outside_string: int
    bytes_word: int
    pop_empty: int
    outside_array: int
    items_word: int
    item_word: int
    byte_word: int
    quote: int
    new_line: int
    cant_turn: int
    into_int: int
    into_float: int
    cant_read: int
    cant_write: int
    period: int
    cleaner_bad_header: int
    cleaner_freed_changed: int
    cleaner_freed_reference: int
    cleaner_double_free: int
    more_calls: int
    user32_dll: int
    message_box: int
    error_title: int
end

# The machine code so far. A fixup is a 4-byte gap the .exe writer fills with the distance to a thing in
# the data section, and a call site is a place a Jamo call returns to, for showing the calls in a run error
struct Assembler
    code: Bytes
    fixup_offsets: [int]
    fixup_targets: [int]
    fixup_strings: [int]
    fixup_extras: [int]
    call_offsets: [int]
    call_strings: [int]
    places: [int]
    gap_offsets: [int]
    gap_labels: [int]
end

func new_assembler(): Assembler
    return Assembler{code: new_bytes(), fixup_offsets: [], fixup_targets: [], fixup_strings: [], fixup_extras: [], call_offsets: [], call_strings: [], places: [], gap_offsets: [], gap_labels: []}
end

func hex_digit(letter: int): int
    if letter >= 97
        return letter - 87
    end
    return letter - 48
end

# Bytes written as hex text, two letters each
func Assembler.hex(text: string)
    var i = 0
    while i < len(text)
        self.code.add_u8(hex_digit(byte(text, i)) * 16 + hex_digit(byte(text, i + 1)))
        i += 2
    end
end

func Assembler.byte(value: int)
    self.code.add_u8(value)
end

func Assembler.int32(value: int)
    self.code.add_u32(value)
end

func Assembler.int64(value: int)
    self.code.add_u64(value)
end

func Assembler.size(): int
    return self.code.length()
end

func Assembler.new_label(): int
    self.places.add(-1)
    return len(self.places) - 1
end

func Assembler.place(label: int)
    self.places[label] = self.code.length()
end

# Adds a 4-byte distance to a label, filled in at the end
func Assembler.label_gap(label: int)
    self.gap_offsets.add(self.code.length())
    self.gap_labels.add(label)
    self.int32(0)
end

func Assembler.fixup(target: int, which: int, extra: int)
    self.fixup_offsets.add(self.code.length())
    self.fixup_targets.add(target)
    self.fixup_strings.add(which)
    self.fixup_extras.add(extra)
    self.int32(0)
end

func Assembler.data_gap(target: int, which: int)
    self.fixup(target, which, 0)
end

func Assembler.note_call_site(which: int)
    self.call_offsets.add(self.code.length())
    self.call_strings.add(which)
end

func Assembler.finish()
    for i in 0..len(self.gap_offsets)
        var offset = self.gap_offsets[i]
        self.code.set_u32(offset, self.places[self.gap_labels[i]] - (offset + 4))
    end
end

func fits_int32(value: int): bool
    return value >= -2147483648 and value <= 2147483647
end

# --- Instructions ---

func Assembler.push_rax()
    self.hex("50")
end

func Assembler.pop_rax()
    self.hex("58")
end

func Assembler.push_rbp()
    self.hex("55")
end

func Assembler.mov_rbp_rsp()
    self.hex("4889e5")
end

func Assembler.leave_and_return()
    self.hex("c9c3")
end

# Dividing by a constant with a multiply
func Assembler.mov_r8_rax()
    self.hex("4989c0")
end

func Assembler.mov_rax_r8()
    self.hex("4c89c0")
end

func Assembler.mov_r11_value(value: int)
    self.hex("49bb")
    self.int64(value)
end

# rdx:rax = rax * r11
func Assembler.imul_r11()
    self.hex("49f7eb")
end

func Assembler.add_rdx_r8()
    self.hex("4c01c2")
end

func Assembler.sar_rdx(count: int)
    self.hex("48c1fa")
    self.byte(count)
end

func Assembler.shr_rax_63()
    self.hex("48c1e83f")
end

func Assembler.add_rdx_rax()
    self.hex("4801c2")
end

# Variables outside functions: r11 = where they are, then one of them by its place. r11 holds nothing in Jamo code
func Assembler.load_r11_globals()
    self.hex("4c8b1d")
    self.data_gap(DATA_GLOBALS, 0)
end

func Assembler.load_rax_global(offset: int)
    self.hex("498b83")
    self.int32(offset)
end

func Assembler.load_rcx_global(offset: int)
    self.hex("498b8b")
    self.int32(offset)
end

func Assembler.store_rax_global(offset: int)
    self.hex("498983")
    self.int32(offset)
end

# Zeroes count words from rsp up, then keeps rsp as where the variables outside functions are
func Assembler.start_globals(count: int)
    self.hex("4889e7b9")
    self.int32(count)
    self.hex("31c0f348ab488925")
    self.data_gap(DATA_GLOBALS, 0)
end

func Assembler.imul_rdx_r11()
    self.hex("490fafd3")
end

# rax = text. FNV-1a over its bytes, leaving the number in rax. Uses rcx, rdx, r8 and r9
func Assembler.hash_text_rax()
    self.hex("488b08488d500848b825232284e49cf2cb49b8b301000000010000")
    self.hex("4885c97413440fb60a4c31c8490fafc048ffc248ffc9ebe8")
end

# Spreads rax's bits (splitmix64's last steps), then halves it so it's never below 0. Uses rcx
func Assembler.mix_hash_rax()
    self.hex("4889c148c1e91e4831c848b9b9e5e41c6d4758bf480fafc1")
    self.hex("4889c148c1e91b4831c848b9eb113113bb49d094480fafc1")
    self.hex("4889c148c1e91f4831c848d1e8")
end

func Assembler.imul_rdx_value(value: int)
    self.hex("4869d2")
    self.int32(value)
end

func Assembler.sub_rax_rdx()
    self.hex("4829d0")
end

# r12 to r15 hold a function's busiest variables, numbered 0 to 3
func Assembler.mov_reg_rax(reg: int)
    self.hex("4989")
    self.byte(196 + reg)
end

func Assembler.mov_rax_reg(reg: int)
    self.hex("4c89")
    self.byte(224 + reg * 8)
end

func Assembler.mov_rcx_reg(reg: int)
