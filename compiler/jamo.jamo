# jamo: compiles Jamo source into real Windows programs. jamo build file.jamo, or jamo run file.jamo.
# The same as src/main.cpp, written in Jamo.
#
# Messages go out the way the C++ jamo.exe writes them, with each new line as \r\n.

use "modules.jamo"
use "checker.jamo"
use "pe.jamo"
use "net.jamo"

extern "kernel32.dll" func GetStdHandle(which: i32): int
extern "kernel32.dll" func WriteFile(file: int, data: int, size: i32, written: int, overlapped: int): bool
extern "kernel32.dll" func ExitProcess(code: i32)
extern "kernel32.dll" func CreateFileW(name: int, access: i32, share: i32, security: int, how: i32, flags: i32, template: int): int
extern "kernel32.dll" func CloseHandle(handle: int): bool
extern "kernel32.dll" func MoveFileExW(from: int, to: int, flags: i32): bool
extern "kernel32.dll" func DeleteFileW(name: int): bool
extern "kernel32.dll" func CreateDirectoryW(name: int, security: int): bool
extern "kernel32.dll" func CreateProcessW(app: int, command: int, process_security: int, thread_security: int, inherit: bool, flags: i32, environment: int, folder: int, startup: int, info: int): bool
extern "kernel32.dll" func WaitForSingleObject(handle: int, milliseconds: i32): i32
extern "kernel32.dll" func GetExitCodeProcess(process: int, code: int): bool
extern "kernel32.dll" func GetLastError(): i32
extern "kernel32.dll" func Sleep(milliseconds: i32)
extern "kernel32.dll" func TerminateProcess(process: int, code: i32): bool
extern "kernel32.dll" func GetFileAttributesExW(name: int, level: i32, data: int): bool

const FAILED = 1
const CLEANER_CHECKS = 2
const CLEANER_OFF = 4
const VERSION = "0.6.0"
const USAGE = "Usage:\n  jamo run file.jamo     Builds it and runs it. Anything after the file goes to the program\n  jamo watch file.jamo   Runs it, then builds and runs it again each time you save a change\n  jamo build file.jamo   Writes file.exe beside the source\n  jamo build --window file.jamo   Writes a window program, with no console behind it\n  jamo run --trace file.jamo     Shows each of the program's own functions as it starts\n  jamo check file.jamo   Finds mistakes without writing an .exe\n  jamo debug file.jamo   Runs it with breakpoints, stepping and a look at its variables\n  jamo test              Runs the test_ functions in every _test.jamo file here, or: jamo test folder or file\n  jamo new name          Makes a folder called name, with a program to start from\n  jamo new --game name   Makes it with a small window game to start from instead\n  jamo fmt file.jamo     Tidies the indentation and spacing, without changing what it does\n  jamo doc file.jamo     Writes a web page of its functions, structs and comments. Works on gfx.jamo and the other libraries too\n  jamo get someone/project   Downloads a library someone shared on GitHub into packages\n  jamo version           Shows which Jamo this is\n  jamo help              Shows this\n"
# The game jamo new --game starts from: a player that moves, a coin to catch, and a score
const NEW_GAME = "use \"gfx.jamo\"\nuse \"math.jamo\"\n\nconst WIDTH = 640\nconst HEIGHT = 480\nconst SIZE = 32.0\nconst SPEED = 4.0\n\n# Everything the game keeps track of lives in one struct, passed to the functions that need it\nstruct Game\n    x: float\n    y: float\n    coin_x: float\n    coin_y: float\n    score: int\nend\n\nfunc Game.move(window: Window)\n    if window.key_down(\"left\")\n        self.x -= SPEED\n    end\n    if window.key_down(\"right\")\n        self.x += SPEED\n    end\n    if window.key_down(\"up\")\n        self.y -= SPEED\n    end\n    if window.key_down(\"down\")\n        self.y += SPEED\n    end\n    self.x = clamp(self.x, 0.0, float(WIDTH) - SIZE)\n    self.y = clamp(self.y, 0.0, float(HEIGHT) - SIZE)\nend\n\n# Touching the coin scores a point, and the coin jumps somewhere new\nfunc Game.catch_coin()\n    if abs(self.x + SIZE / 2.0 - self.coin_x) < 24.0 and abs(self.y + SIZE / 2.0 - self.coin_y) < 24.0\n        self.score += 1\n        self.coin_x = 20.0 + random_float() * float(WIDTH - 40)\n        self.coin_y = 60.0 + random_float() * float(HEIGHT - 80)\n    end\nend\n\nfunc Game.draw(screen: Gfx)\n    screen.clear(rgb(24, 28, 44))\n    screen.circle(self.coin_x, self.coin_y, 10.0, rgb(255, 210, 60))\n    screen.rect(self.x, self.y, SIZE, SIZE, rgb(90, 200, 255))\n    screen.text(f\"Coins: {self.score}\", 16.0, 16.0, 24.0, rgb(255, 255, 255))\nend\n\nfunc main()\n    var window = open_window(\"My game\", WIDTH, HEIGHT)\n    var screen = start_gfx(window)\n    var game = Game{x: 300.0, y: 220.0, coin_x: 120.0, coin_y: 120.0, score: 0}\n    while window.is_open()\n        if window.key_pressed(\"escape\")\n            window.close()\n        end\n        game.move(window)\n        game.catch_coin()\n        game.draw(screen)\n        screen.show()\n        window.wait_frame(60)\n    end\nend\n"
const NEW_PROGRAM = "func main()\n    print(\"Hello from Jamo!\")\nend\n"
const STANDARD_OUTPUT = -11
const STANDARD_ERROR = -12
const GENERIC_WRITE = 1073741824
const CREATE_ALWAYS = 2
const NORMAL_FILE = 128
const REPLACE_EXISTING = 1
const STARTUP_INFO_SIZE = 104
const PROCESS_INFO_SIZE = 24
const WAIT_FOREVER = -1
const RENAME_ATTEMPTS = 20
const RENAME_WAIT_MS = 50
const WATCH_WAIT_MS = 250
const WATCH_SETTLE_MS = 150
const FILE_DATA_SIZE = 40

# --- Writing ---

func write_out(which: int, text: string)
    var words = replace(text, "\n", "\r\n")
    if len(words) == 0
        return
    end
    var written = memory(8)
    var place = memory(len(words))
    for i in 0..len(words)
        poke_u8(place, i, byte(words, i))
    end
    WriteFile(GetStdHandle(which), place, len(words), written, 0)
end

func say(text: string)
    write_out(STANDARD_OUTPUT, text)
end

func complain(text: string)
    write_out(STANDARD_ERROR, text)
end

# Writes bytes to a file, answering false if Windows won't
func save_file(path: string, data: int, size: int): bool
    var file = CreateFileW(wide(path), GENERIC_WRITE, 0, 0, CREATE_ALWAYS, NORMAL_FILE, 0)
    if file == -1
        return false
    end
    var written = memory(8)
    var wrote = WriteFile(file, data, size, written, 0) and peek_i32(written, 0) == size
    CloseHandle(file)
    return wrote
end

func save_text(path: string, text: string): bool
    var place = memory(len(text) + 1)
    for i in 0..len(text)
        poke_u8(place, i, byte(text, i))
    end
    return save_file(path, place, len(text))
end

# Writes beside the real file first, so a failure can't leave a broken program behind
func write_exe(path: string, exe: Bytes): bool
    var partial = path + ".part"
    if not save_file(partial, exe.buffer, exe.length())
        return false
    end
    # Windows can hold the old .exe for a moment, like while it's being scanned for viruses, so it tries again for up to a second
    for attempt in 0..RENAME_ATTEMPTS
        if MoveFileExW(wide(partial), wide(path), REPLACE_EXISTING)
            return true
        end
        Sleep(RENAME_WAIT_MS)
    end
    DeleteFileW(wide(partial))
    return false
end

# --- Building ---

func file_name(path: string): string
    var parts = path_parts(path)
    if len(parts) == 0
        return ""
    end
    return parts[len(parts) - 1]
end

# --debug: the program comes with jamo_debugger.jamo and a call to it before each line
var debug_build = false

func load_and_check(source_path: string, program: Program): bool
    if path_extension(source_path) != ".jamo"
        complain(source_path + " isn't a Jamo file. Jamo files end in .jamo.\n")
        return false
    end
    var errors = new_errors()
    if not load_program(source_path, errors, program)
        complain("I can't read a file called " + source_path + ".\n")
        return false
    end
    if not errors.any() and debug_build
        load_extra_file("jamo_debugger.jamo (built in)", builtin_library("jamo_debugger.jamo"), errors, program)
        var order = [len(program.file_names) - 1]
        for file in program.setup_order
            order.add(file)
        end
        program.setup_order = order
        add_debug_lines(program)
    end
    if not errors.any()
        check_program(program, errors)
    end
    if errors.any()
        complain(errors.text())
        return false
    end
    complain(errors.warnings_text())
    return true
end

# Answers with the .exe's path, or nothing if it couldn't be built
func build(source_path: string, cleaner_mode: int): string
    var program = new_program()
    if not load_and_check(source_path, program)
        return ""
    end
    return write_program(program, source_path, cleaner_mode)
end

# Writes the .exe for a program that's already checked, and answers its path, or nothing if it can't
func write_program(program: Program, source_path: string, cleaner_mode: int): string
    var exe = build_exe(generate_code(program, file_name(source_path), cleaner_mode))
    var exe_path = slice(source_path, 0, len(source_path) - len(".jamo")) + ".exe"
    if not write_exe(exe_path, exe)
        complain("I can't write " + exe_path + ". If that program is still running, close it and try again.\n")
        return ""
    end
    return exe_path
end

# --- Running ---

# Adds an input to a command line, in the way programs read it back
func add_to_command(command: string, input: string): string
    var out = command + " \""
    var backslashes = 0
    for i in 0..len(input)
        var letter = input[i]
        if letter == "\\"
            backslashes += 1
            continue
        end
        if letter == "\""
            out += repeat("\\", backslashes * 2 + 1)
        else
            out += repeat("\\", backslashes)
        end
        backslashes = 0
        out += letter
    end
    out += repeat("\\", backslashes * 2)
    return out + "\""
end

# Starts the program without waiting for it. Answers its process, or 0 if Windows wouldn't start it
func start_program(exe_path: string, inputs: [string]): int
    var full = full_path(exe_path)
    if full == ""
        full = exe_path
    end
    var command = "\"" + full + "\""
    for input in inputs
        command = add_to_command(command, input)
    end
    var startup = memory(STARTUP_INFO_SIZE)
    poke_i32(startup, 0, STARTUP_INFO_SIZE)
    var process = memory(PROCESS_INFO_SIZE)
    if not CreateProcessW(0, wide(command), 0, 0, true, 0, 0, 0, startup, process)
        complain(f"I built {exe_path}, but Windows wouldn't start it (error {GetLastError()}).\n")
        return 0
    end
    CloseHandle(peek_i64(process, 8))
    return peek_i64(process, 0)
end

func run(exe_path: string, inputs: [string]): int
    var full = full_path(exe_path)
    if full == ""
        full = exe_path
    end
    var command = "\"" + full + "\""
    for input in inputs
        command = add_to_command(command, input)
    end
    var startup = memory(STARTUP_INFO_SIZE)
    poke_i32(startup, 0, STARTUP_INFO_SIZE)
    var process = memory(PROCESS_INFO_SIZE)
    if not CreateProcessW(0, wide(command), 0, 0, true, 0, 0, 0, startup, process)
        complain(f"I built {exe_path}, but Windows wouldn't start it (error {GetLastError()}).\n")
        return FAILED
    end
    var handle = peek_i64(process, 0)
    WaitForSingleObject(handle, WAIT_FOREVER)
    var exit_code = memory(8)
    poke_i32(exit_code, 0, FAILED)
    GetExitCodeProcess(handle, exit_code)
    CloseHandle(handle)
    CloseHandle(peek_i64(process, 8))
    return peek_i32(exit_code, 0)
end

# --- jamo new ---

# Makes the folder and any folders it sits in, like std::filesystem::create_directories
func make_folders(folder: string)
    var current = path_root(folder)
    for part in path_parts(folder)
        current = join_path(current, part)
        CreateDirectoryW(wide(current), 0)
    end
end

func make_new_program(folder: string, game: bool): int
    if file_kind(folder) >= 0
        complain(folder + " already exists, so I left it alone. Pick a different name.\n")
        return FAILED
    end
    make_folders(folder)
    var main_file = join_path(folder, "main.jamo")
    var program = NEW_PROGRAM
    if game
        program = NEW_GAME
    end
    if file_kind(folder) != 16 or not save_text(main_file, program)
        complain("I can't make a folder called " + folder + ".\n")
        return FAILED
    end
    say("Made " + main_file + "\nRun it with: jamo run \"" + main_file + "\"\n")
    if game
        say("When it's ready to share: jamo build --window \"" + main_file + "\"\n")
    end
    return 0
end

# --- jamo watch ---

# How the program's own files look now: each one's last change and size. Built-in libraries never change
func files_now(main_file: string, names: [string]): string
    var root = parent_path(canonical_path(main_file))
    var paths = [main_file]
    for name in names
        if not ends_with(name, " (built in)")
            paths.add(join_path(root, name))
        end
    end
    var out = ""
    var data = memory(FILE_DATA_SIZE)
    for path in paths
        if not GetFileAttributesExW(wide(path), 0, data)
            out = out + "missing;"
            continue
        end
        var high = peek_i32(data, 24)
        var low = peek_i32(data, 20)
        out = out + string(high) + ":" + string(low) + ":" + string(peek_i32(data, 32)) + ";"
    end
    return out
end

func stop_program(running: int)
    if running == 0
        return
    end
    TerminateProcess(running, FAILED)
    WaitForSingleObject(running, WAIT_FOREVER)
    CloseHandle(running)
end

# Builds and runs the program, then again each time one of its files changes. A build with mistakes shows
# them and leaves the last version that worked running, since its .exe is only replaced once the code checks out
func watch(main_file: string, cleaner_mode: int, inputs: [string]): int
    say("Watching " + main_file + ". Save a change to build and run it again, and press Ctrl+C to stop.\n")
    var running = 0
    var told_end = true
    while true
        var program = new_program()
        var checked = load_and_check(main_file, program)
        var seen = files_now(main_file, program.file_names)
        if checked
            stop_program(running)
            running = 0
            var exe_path = write_program(program, main_file, cleaner_mode)
            if exe_path != ""
                running = start_program(exe_path, inputs)
                told_end = running == 0
            end
        elif running != 0 and not told_end
            say("The last version that worked is still running.\n")
        end
        while true
            Sleep(WATCH_WAIT_MS)
            if running != 0 and not told_end and WaitForSingleObject(running, 0) == 0
                var exit_code = memory(8)
                poke_i32(exit_code, 0, FAILED)
                GetExitCodeProcess(running, exit_code)
                say("(It finished with exit code " + string(peek_i32(exit_code, 0)) + ". Waiting for a change.)\n")
                told_end = true
            end
            if files_now(main_file, program.file_names) != seen
                break
            end
        end
        # An editor can save a file in more than one step, so this waits for it to finish
        Sleep(WATCH_SETTLE_MS)
        say("\n(A file changed, so it's building again.)\n")
    end
    return 0
end

# --- jamo test ---
# Each file whose name ends in _test.jamo is built with a main that jamo test makes: it runs the one test_ function
# named on its command line. Then each test runs as its own program, so one that stops with a run error can't stop
# the others. Only a failed test's output is shown, without the lines about the made-up main

extern "kernel32.dll" func CreatePipe(reading: int, writing: int, security: int, size: i32): bool
extern "kernel32.dll" func SetHandleInformation(handle: int, mask: i32, flags: i32): bool
extern "kernel32.dll" func ReadFile(file: int, data: int, size: i32, done: int, overlapped: int): bool
extern "kernel32.dll" func FindFirstFileW(pattern: int, data: int): int
extern "kernel32.dll" func FindNextFileW(handle: int, data: int): bool
extern "kernel32.dll" func FindClose(handle: int): bool
extern "kernel32.dll" func GetTempPathW(size: i32, place: int): i32

const TEST_RUNNER = "jamo test (built in)"
const TEST_ENDING = "_test.jamo"
const STANDARD_INPUT = -10
const USE_STANDARD_HANDLES = 256
const FIND_DATA_SIZE = 592
const FIND_NAME_AT = 44

# UTF-16 from Windows as text, the way full_path reads it
func text_from_wide(place: int, units: int): string
    var out = new_bytes()
    for i in 0..units
        var unit = peek_u16(place, i * 2)
        if unit < 128
            out.add_u8(unit)
        elif unit < 2048
            out.add_u8(192 + unit / 64)
            out.add_u8(128 + unit % 64)
        else
            out.add_u8(224 + unit / 4096)
            out.add_u8(128 + unit / 64 % 64)
            out.add_u8(128 + unit % 64)
        end
    end
    return out.text()
end

func is_test_file(name: string): bool
    var low = lower(name)
    return len(low) > len(TEST_ENDING) and ends_with(low, TEST_ENDING)
end

# The test files in a folder and the folders inside it, as paths from that folder. Folders whose names start with .
# are left out
func find_test_files(folder: string, from: string, found: [string])
    var data = memory(FIND_DATA_SIZE)
    var handle = FindFirstFileW(wide(join_path(folder, "*")), data)
    if handle == -1
        return
    end
    var going = true
    while going
        var units = 0
        while peek_u16(data, FIND_NAME_AT + units * 2) != 0
            units += 1
        end
        var name = text_from_wide(data + FIND_NAME_AT, units)
        var shown = name
        if from != ""
            shown = from + "\\" + name
        end
        if name != "." and name != ".."
            if peek_i32(data, 0) / 16 % 2 == 1
                if not starts_with(name, ".")
                    find_test_files(join_path(folder, name), shown, found)
                end
            elif is_test_file(name)
                found.add(shown)
            end
        end
        going = FindNextFileW(handle, data)
    end
    FindClose(handle)
end

# Loads the test file, adds the made-up main, and checks it all. Answers false, having said why, if it can't be built
func load_tests(path: string, shown: string, program: Program, tests: [string]): bool
    var errors = new_errors()
    if not load_program(path, errors, program)
        complain(f"I can't read a file called {shown}.\n")
        return false
    end
    if not errors.any()
        for function in program.functions
            if function.name == "main"
                complain(f"{shown} has a main function, but a test file doesn't need one: jamo test makes its own, which runs each test_ function.\n")
                return false
            end
            if function.file == 0 and starts_with(function.name, "test_") and len(function.inputs) == 0 and function.owner == TYPE_NOTHING and len(function.type_params) == 0 and function.dll == ""
                tests.add(function.name)
            end
        end
        if len(tests) == 0
            complain(f"{shown} has no tests. A test is a function with no inputs whose name starts with test_, like func test_adding().\n")
            return false
        end
        var source = "func main()\n    var which = args()\n    if len(which) != 1\n        return\n    end\n"
        for test in tests
            source += "    if which[0] == \"" + test + "\"\n        " + test + "()\n    end\n"
        end
        source += "end\n"
        load_extra_file(TEST_RUNNER, source, errors, program)
        if not errors.any()
            check_program(program, errors)
        end
    end
    if errors.any()
        complain(errors.text())
        return false
    end
    complain(errors.warnings_text())
    return true
end

struct TestRun
    code: int
    output: string
end

# Runs a test program in the test file's folder, keeping everything it writes
func run_test(exe_path: string, test: string, folder: string): TestRun
    var security = memory(24)
    poke_i32(security, 0, 24)
    poke_i32(security, 16, 1)
    var ends = memory(16)
    if not CreatePipe(ends, ends + 8, security, 0)
        return TestRun{code: FAILED, output: "Windows wouldn't make a pipe to read the test's output.\n"}
    end
    var reading = peek_i64(ends, 0)
    var writing = peek_i64(ends, 8)
    SetHandleInformation(reading, 1, 0)
    var command = add_to_command("\"" + exe_path + "\"", test)
    var startup = memory(STARTUP_INFO_SIZE)
    poke_i32(startup, 0, STARTUP_INFO_SIZE)
    poke_i32(startup, 60, USE_STANDARD_HANDLES)
    poke_i64(startup, 80, GetStdHandle(STANDARD_INPUT))
    poke_i64(startup, 88, writing)
    poke_i64(startup, 96, writing)
    var process = memory(PROCESS_INFO_SIZE)
    var started = CreateProcessW(0, wide(command), 0, 0, true, 0, 0, wide(folder), startup, process)
    CloseHandle(writing)
    if not started
        CloseHandle(reading)
        return TestRun{code: FAILED, output: f"Windows wouldn't start the test (error {GetLastError()}).\n"}
    end
    var output = ""
    var buffer = memory(4096)
    var got = memory(8)
    while true
        poke_i32(got, 0, 0)
        if not ReadFile(reading, buffer, 4096, got, 0) or peek_i32(got, 0) <= 0
            break
        end
        output += memory_text(buffer, peek_i32(got, 0))
    end
    CloseHandle(reading)
    var handle = peek_i64(process, 0)
    WaitForSingleObject(handle, WAIT_FOREVER)
    var exit_code = memory(8)
    poke_i32(exit_code, 0, FAILED)
    GetExitCodeProcess(handle, exit_code)
    CloseHandle(handle)
    CloseHandle(peek_i64(process, 8))
    return TestRun{code: peek_i32(exit_code, 0), output: output}
end

# One line of a failed test's output, moved in under its name, or nothing for a line about the made-up main. A run
# error from inside a library shows just the error, since the lines after it say where in the test it came from
func test_output_line(line: string): string
    if ends_with(line, "\r")
        line = slice(line, 0, len(line) - 1)
    end
    if contains(line, TEST_RUNNER)
        return ""
    end
    var built_in = find(line, " (built in) line ")
    if built_in >= 0
        var rest = slice(line, built_in, len(line))
        var error = find(rest, ": Error: ")
        if error >= 0
            line = "Error: " + slice(rest, error + 9, len(rest))
        end
    end
    return "        " + line + "\n"
end

func test_output(output: string): string
    var out = ""
    var start = 0
    for i in 0..len(output)
        if byte(output, i) == 10
            out += test_output_line(slice(output, start, i))
            start = i + 1
        end
    end
    if start < len(output)
        out += test_output_line(slice(output, start, len(output)))
    end
    return out
end

func count_of(count: int, what: string): string
    if count == 1
        return f"{count} {what}"
    end
    return f"{count} {what}s"
end

func temp_folder(): string
    var place = memory(65536)
    var size = GetTempPathW(32767, place)
    if size <= 0 or size >= 32767
        return "."
    end
    return text_from_wide(place, size)
end

func test_command(place: string): int
    var files: [string] = []
    var folder = place
    var kind = file_kind(place)
    if kind == 16
        find_test_files(place, "", files)
    elif kind == 0
        folder = parent_path(place)
        if folder == ""
            folder = "."
        end
        files.add(file_name(place))
    else
        complain(f"I can't find {place}.\n")
        return FAILED
    end
    # Sorted the way std::sort sorts std::strings
    for i in 1..len(files)
        var j = i
        while j > 0 and text_before(files[j], files[j - 1])
            var held = files[j]
            files[j] = files[j - 1]
            files[j - 1] = held
            j -= 1
        end
    end
    if len(files) == 0
        complain("There are no test files here. A test file's name ends in _test.jamo, like math_test.jamo.\n")
        return FAILED
    end
    var passed = 0
    var failed = 0
    var broken = 0
    var exe_folder = join_path(temp_folder(), "jamo test")
    make_folders(exe_folder)
    for shown in files
        var path = join_path(folder, shown)
        say(shown + "\n")
        var program = new_program()
        var tests: [string] = []
        if not load_tests(path, shown, program, tests)
            broken += 1
            continue
        end
        var name = file_name(path)
        var exe_path = join_path(exe_folder, slice(name, 0, len(name) - len(".jamo")) + ".exe")
        if not write_exe(exe_path, build_exe(generate_code(program, name, 0)))
            complain(f"I can't write {exe_path}.\n")
            broken += 1
            continue
        end
        var test_folder = parent_path(path)
        for test in tests
            var ran = run_test(exe_path, test, test_folder)
            if ran.code == 0
                passed += 1
                say(f"  ok    {test}\n")
            else
                failed += 1
                say(f"  FAIL  {test}\n" + test_output(ran.output))
            end
        end
    end
    var summary = count_of(passed + failed, "test") + ": " + string(passed) + " passed, " + string(failed) + " failed."
    if failed == 0
        summary = count_of(passed, "test") + " passed."
    end
    if passed + failed == 0
        summary = "No tests ran."
    end
    if broken == 1
        summary += " 1 test file has mistakes, so its tests didn't run."
    elif broken > 1
        summary += f" {broken} test files have mistakes, so their tests didn't run."
    end
    say("\n" + summary + "\n")
    if failed == 0 and broken == 0
        return 0
    end
    return FAILED
end

# --- jamo doc: a web page of everything in the program's own files ---

struct DocItem
    kind: string       # func, struct, interface, enum or const
    name: string
    line: string       # The line that makes it
    body: [string]     # A struct's fields, an interface's functions or an enum's members
    notes: [string]    # The # comment lines just above it
end

struct DocFile
    name: string
    about: [string]    # The comment at the top of the file
    items: [DocItem]
end

func doc_escape(text: string): string
    return replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

# The name a line makes: Box.get for func Box<T>.get(), MAX for const MAX = 3
func doc_name(kind: string, line: string): string
    var rest = trim(slice(line, len(kind), len(line)))
    var name = ""
    var inside = 0
    for i in 0..len(rest)
        var c = rest[i]
        if c == "<"
            inside += 1
        elif c == ">"
            inside -= 1
        elif inside == 0
            if c == "(" or c == ":" or c == "=" or c == " "
                return name
            end
            name += c
        end
    end
    return name
end

func doc_is_end(line: string): bool
    return trim(line) == "end" and not starts_with(line, " ")
end

# Reads one file's comments and the things it makes, top to bottom
func doc_read(name: string, source: string): DocFile
    var lines = split(replace(source, "\r", ""), "\n")
    var file = DocFile{name: name, about: [], items: []}
    var notes: [string] = []
    var at_top = true
    var i = 0
    while i < len(lines)
        var line = lines[i]
        if starts_with(line, "#")
            var note = slice(line, 1, len(line))
            if starts_with(note, " ")
                note = slice(note, 1, len(note))
            end
            notes.add(note)
            i += 1
            continue
        end
        if trim(line) == ""
            if at_top and len(notes) > 0 and len(file.about) == 0
                file.about = notes
            end
            notes = []
            i += 1
            continue
        end
        if starts_with(line, " ")
            notes = []
            i += 1
            continue
        end
        at_top = false
        var rest = line
        var first = tidy_first_word(line)
        var hidden = false
        if first == "private"
            hidden = true
            rest = trim(slice(line, len("private"), len(line)))
            first = tidy_first_word(rest)
        end
        var body: [string] = []
        if first == "struct" or first == "enum" or first == "interface"
            i += 1
            while i < len(lines) and not doc_is_end(lines[i])
                var part = lines[i]
                if starts_with(part, "    ")
                    part = slice(part, 4, len(part))
                end
                if trim(part) != ""
                    body.add(part)
                end
                i += 1
            end
        elif first == "func" and not contains(line, "=>")
            i += 1
            while i < len(lines) and not doc_is_end(lines[i])
                i += 1
            end
        end
        if not hidden and (first == "func" or first == "struct" or first == "enum" or first == "interface" or first == "const")
            file.items.add(DocItem{kind: first, name: doc_name(first, rest), line: trim(rest), body: body, notes: notes})
        end
        notes = []
        i += 1
    end
    return file
end

# Comment lines as HTML: lines starting with 4 spaces are code, a blank line starts a new paragraph
func doc_notes(notes: [string], kind: string): string
    var out = ""
    var words = ""
    var code = ""
    for note in notes
        if starts_with(note, "    ")
            if words != ""
                out += "<p class=\"" + kind + "\">" + doc_escape(words) + "</p>"
                words = ""
            end
            code += doc_escape(slice(note, 4, len(note))) + "\n"
            continue
        end
        if code != ""
            out += "<pre>" + code + "</pre>"
            code = ""
        end
        if trim(note) == ""
            if words != ""
                out += "<p class=\"" + kind + "\">" + doc_escape(words) + "</p>"
                words = ""
            end
        elif words == ""
            words = trim(note)
        else
            words += " " + trim(note)
        end
    end
    if code != ""
        out += "<pre>" + code + "</pre>"
    end
    if words != ""
        out += "<p class=\"" + kind + "\">" + doc_escape(words) + "</p>"
    end
    return out
end

func doc_page(title: string, files: [DocFile]): string
    var side = ""
    var main_part = ""
    var number = 0
    for file in files
        side += "<h2>" + doc_escape(file.name) + "</h2>"
        main_part += "<section><h2>" + doc_escape(file.name) + "</h2>" + doc_notes(file.about, "about")
        for item in file.items
            number += 1
            var key = doc_escape(lower(item.name))
            side += "<a href=\"#item" + string(number) + "\" data-name=\"" + key + "\">" + doc_escape(item.name) + "</a>"
            var shown = item.line
            for part in item.body
                shown += "\n    " + part
            end
            if len(item.body) > 0
                shown += "\nend"
            end
            main_part += "<article id=\"item" + string(number) + "\" data-name=\"" + key + "\"><h3><span class=\"kind\">" + item.kind + "</span>" + doc_escape(item.name) + "</h3>"
            main_part += "<pre>" + doc_escape(shown) + "</pre>" + doc_notes(item.notes, "note") + "</article>"
        end
        main_part += "</section>"
    end
    var page = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    page += "<title>" + doc_escape(title) + " docs</title>\n<style>:root{--plum:#1a0f22;--plum2:#2a1834;--jam:#d6245a;--pink:#f2557f;--cream:#fff3e6;--soft:#e9dcef;--dim:#bfa9c9}*{box-sizing:border-box}body{margin:0;background:var(--plum);color:var(--soft);font:16px/1.6 'Segoe UI',system-ui,sans-serif;display:flex}aside{position:sticky;top:0;height:100vh;overflow:auto;width:280px;flex:none;background:var(--plum2);padding:24px 16px}aside h1{color:var(--cream);font-size:22px;margin:0 0 16px}aside h2{color:var(--pink);font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin:24px 0 8px}aside a{display:block;color:var(--soft);text-decoration:none;padding:2px 8px;border-radius:6px;font-family:Consolas,monospace;font-size:14px}aside a:hover{background:var(--plum);color:var(--cream)}#find{width:100%;padding:8px 12px;border-radius:8px;border:1px solid #4a2f57;background:var(--plum);color:var(--cream);font-size:15px}main{padding:32px 48px;max-width:900px;min-width:0}main>section>h2{color:var(--cream);font-size:28px;border-bottom:2px solid var(--jam);padding-bottom:8px}article{background:var(--plum2);border-radius:12px;padding:16px 24px;margin:16px 0}h3{margin:0 0 8px;color:var(--cream);font-family:Consolas,monospace;font-size:18px}.kind{color:var(--pink);font-weight:normal;margin-right:8px}pre{background:#0f0814;border-radius:8px;padding:12px 16px;overflow:auto;font:14px/1.5 Consolas,monospace;color:var(--soft)}.about{color:var(--dim)}footer{color:var(--dim);font-size:13px;margin-top:48px}</style>\n</head>\n<body>\n"
    page += "<aside><h1>" + doc_escape(title) + "</h1><input id=\"find\" placeholder=\"Search\" aria-label=\"Search\">" + side + "</aside>\n"
    page += "<main>" + main_part + "<footer>Made with jamo doc</footer></main>\n"
    page += "<script>document.getElementById('find').addEventListener('input',function(e){var q=e.target.value.toLowerCase();document.querySelectorAll('article').forEach(function(a){a.style.display=a.dataset.name.indexOf(q)>=0?'':'none'});document.querySelectorAll('aside a').forEach(function(a){a.style.display=a.dataset.name.indexOf(q)>=0?'':'none'})})</script>\n</body>\n</html>\n"
    return page
end

# jamo doc file.jamo writes file_doc.html beside it. jamo doc gfx.jamo, for a built-in library with no file of that
# name here, writes gfx_doc.html in this folder
func make_docs(path: string): int
    var files: [DocFile] = []
    var out = ""
    if file_kind(path) != 0 and builtin_library(path) != ""
        files.add(doc_read(path + " (built in)", builtin_library(path)))
        out = slice(path, 0, len(path) - len(".jamo")) + "_doc.html"
    else
        if path_extension(path) != ".jamo"
            complain(path + " isn't a Jamo file. Jamo files end in .jamo.\n")
            return FAILED
        end
        var program = new_program()
        var errors = new_errors()
        if not load_program(path, errors, program)
            complain("I can't read a file called " + path + ".\n")
            return FAILED
        end
        if errors.any()
            complain(errors.text())
            return FAILED
        end
        var root = parent_path(canonical_path(path))
        for name in program.file_names
            if not ends_with(name, " (built in)")
                files.add(doc_read(name, read_file(join_path(root, name))))
            end
        end
        out = slice(path, 0, len(path) - len(".jamo")) + "_doc.html"
    end
    if not save_text(out, doc_page(file_name(path), files))
        complain("I couldn't save " + out + ".\n")
        return FAILED
    end
    say("Wrote " + out + ". Open it in a web browser to read it.\n")
    return 0
end

# --- jamo debug: runs a program built with --debug, and talks to it over a named pipe ---

extern "kernel32.dll" func CreateNamedPipeW(name: int, open_mode: i32, pipe_mode: i32, most: i32, out_size: i32, in_size: i32, wait: i32, security: int): int
extern "kernel32.dll" func ConnectNamedPipe(pipe: int, overlapped: int): bool
extern "kernel32.dll" func CreateEventW(security: int, manual: bool, initial: bool, name: int): int
extern "kernel32.dll" func WaitForMultipleObjects(count: i32, handles: int, all: bool, milliseconds: i32): i32
extern "kernel32.dll" func GetOverlappedResult(file: int, overlapped: int, done: int, wait: bool): bool
extern "kernel32.dll" func SetEnvironmentVariableW(name: int, value: int): bool
extern "kernel32.dll" func GetCurrentProcessId(): i32

const PIPE_DUPLEX_OVERLAPPED = 1073741827
const IO_PENDING = 997
const PIPE_CONNECTED = 535
const DEBUG_HELP = "Commands:\n  c   continue until a breakpoint          n   next line, stepping over calls\n  s   step into a call                     o   out of this function\n  b 12, b enemy.jamo:12   a breakpoint     clear   take every breakpoint away\n  v   the variables here, v 1 one call up  p name  one variable\n  w   where: the calls it's in             q   quit, stopping the program\n  Enter on its own does the last c, n, s or o again\n"

struct DebugLink
    pipe: int
    process: int
    overlapped: int
    waits: int         # The pipe's event, then the program
    inbox: string
    open: bool
end

# Waits for the pipe's last read, write or connect, or for the program to end. Answers how many bytes moved, or -1
func DebugLink.finish(started: bool): int
    var error = GetLastError()
    if not started and error != IO_PENDING
        if error == PIPE_CONNECTED
            return 0
        end
        self.open = false
        return -1
    end
    var done = memory(8)
    poke_i64(done, 0, 0)
    if WaitForMultipleObjects(2, self.waits, false, WAIT_FOREVER) != 0
        self.open = false
        return -1
    end
    if not GetOverlappedResult(self.pipe, self.overlapped, done, false)
        self.open = false
        return -1
    end
    return peek_i32(done, 0)
end

func DebugLink.send(line: string)
    if not self.open
        return
    end
    var text = line + "\n"
    var place = memory(len(text) + 1)
    for i in 0..len(text)
        poke_u8(place, i, byte(text, i))
    end
    self.finish(WriteFile(self.pipe, place, len(text), 0, self.overlapped))
end

# The program's next line, or "" once it has finished
func DebugLink.read_line(): string
    while self.open
        var at = find(self.inbox, "\n")
        if at >= 0
            var line = slice(self.inbox, 0, at)
            self.inbox = slice(self.inbox, at + 1, len(self.inbox))
            return line
        end
        var buffer = memory(4096)
        var got = self.finish(ReadFile(self.pipe, buffer, 4096, 0, self.overlapped))
        if got <= 0
            self.open = false
            return ""
        end
        self.inbox += memory_text(buffer, got)
    end
    return ""
end

# The lines up to end, after asking a question like frames or vars 0
func DebugLink.ask(question: string): [string]
    self.send(question)
    var answer: [string] = []
    while self.open
        var line = self.read_line()
        if line == "end" or not self.open
            return answer
        end
        answer.add(line)
    end
    return answer
end

func debug_source_line(root: string, label: string, line: int): string
    var path = join_path(root, replace(label, "/", "\\"))
    if file_kind(path) != 0
        return ""
    end
    var lines = split(replace(read_file(path), "\r", ""), "\n")
    if line < 1 or line > len(lines)
        return ""
    end
    return trim(lines[line - 1])
end

func debug_show_vars(link: DebugLink, frame: int, only: string)
    var found = false
    for line in link.ask("vars " + string(frame))
        var parts = split(slice(line, 4, len(line)), "|")
        if len(parts) >= 3 and (only == "" or parts[0] == only)
            say("  " + parts[0] + ": " + parts[1] + " = " + parts[2] + "\n")
            found = true
        end
    end
    if not found and only != ""
        say("  There's no variable called " + only + " here.\n")
    elif not found
        say("  No variables here.\n")
    end
end

func debug_program(path: string, inputs: [string]): int
    if path_extension(path) != ".jamo"
        complain(path + " isn't a Jamo file. Jamo files end in .jamo.\n")
        return FAILED
    end
    debug_build = true
    var program = new_program()
    if not load_and_check(path, program)
        return FAILED
    end
    var folder = join_path(temp_folder(), "jamo debug")
    make_folders(folder)
    var name = file_name(path)
    var exe_path = join_path(folder, slice(name, 0, len(name) - len(".jamo")) + ".exe")
    if not write_exe(exe_path, build_exe(generate_code(program, name, NO_OPTIMIZING)))
        complain("I can't write " + exe_path + ".\n")
        return FAILED
    end
    var root = parent_path(canonical_path(path))
    var pipe_name = "\\\\.\\pipe\\jamo-debug-" + string(GetCurrentProcessId())
    var pipe = CreateNamedPipeW(wide(pipe_name), PIPE_DUPLEX_OVERLAPPED, 0, 1, 65536, 65536, 0, 0)
    if pipe == -1
        complain("Windows wouldn't make the pipe the debugger talks over (error " + string(GetLastError()) + ").\n")
        return FAILED
    end
    SetEnvironmentVariableW(wide("JAMO_DEBUG_PIPE"), wide(pipe_name))
    var process = start_program(exe_path, inputs)
    SetEnvironmentVariableW(wide("JAMO_DEBUG_PIPE"), 0)
    if process == 0
        CloseHandle(pipe)
        return FAILED
    end
    var overlapped = memory(32)
    var event = CreateEventW(0, true, false, 0)
    poke_i64(overlapped, 24, event)
    var waits = memory(16)
    poke_i64(waits, 0, event)
    poke_i64(waits, 8, process)
    var link = DebugLink{pipe: pipe, process: process, overlapped: overlapped, waits: waits, inbox: "", open: true}
    link.finish(ConnectNamedPipe(pipe, overlapped))
    if link.open and link.read_line() == "hello"
        say("Debugging " + name + ". It stops at its first line. Type help for the commands.\n")
        link.send("step")
    end
    var last = "c"
    while link.open
        var event_line = link.read_line()
        if not link.open
            break
        end
        if not starts_with(event_line, "stopped ")
            if starts_with(event_line, "error ")
                say(slice(event_line, 6, len(event_line)) + "\n")
            end
            continue
        end
        var parts = split(event_line, " ")
        var line = int(parts[2])
        var label = slice(event_line, len(parts[0]) + len(parts[1]) + len(parts[2]) + 3, len(event_line))
        var why = ""
        if parts[1] == "breakpoint"
            why = " (breakpoint)"
        elif parts[1] == "pause"
            why = " (paused)"
        end
        say("Stopped at " + label + " line " + string(line) + why + "\n")
        var text = debug_source_line(root, label, line)
        if text != ""
            say("  " + string(line) + " | " + text + "\n")
        end
        var resumed = false
        while not resumed and link.open
            say("(jamo) ")
            var typed = trim(input())
            if typed == ""
                typed = last
            end
            var word = typed
            var rest = ""
            var space = find(typed, " ")
            if space > 0
                word = slice(typed, 0, space)
                rest = trim(slice(typed, space + 1, len(typed)))
            end
            if word == "c" or word == "continue"
                link.send("continue")
                last = "c"
                resumed = true
            elif word == "n" or word == "next"
                link.send("next")
                last = "n"
                resumed = true
            elif word == "s" or word == "step"
                link.send("step")
                last = "s"
                resumed = true
            elif word == "o" or word == "out"
                link.send("out")
                last = "o"
                resumed = true
            elif word == "b" or word == "break"
                var where = label
                var number = rest
                var colon = find(rest, ":")
                if colon > 0
                    where = replace(slice(rest, 0, colon), "\\", "/")
                    number = slice(rest, colon + 1, len(rest))
                end
                if number == "" or int_or(number, -1) <= 0
                    say("  Like this: b 12, or b enemy.jamo:12\n")
                else
                    link.send("break " + string(int_or(number, -1)) + " " + where)
                    say("  Breakpoint at " + where + " line " + string(int_or(number, -1)) + ".\n")
                end
            elif word == "clear"
                link.send("clear")
                say("  No more breakpoints.\n")
            elif word == "v" or word == "vars"
                debug_show_vars(link, int_or(rest, 0), "")
            elif word == "p" or word == "print"
                debug_show_vars(link, 0, rest)
            elif word == "w" or word == "where"
                var frames = link.ask("frames")
                for i in 0..len(frames)
                    var bits = split(slice(frames[i], 6, len(frames[i])), "|")
                    if len(bits) >= 3
                        say("  " + string(i) + "  " + bits[0] + "  " + bits[1] + " line " + bits[2] + "\n")
                    end
                end
            elif word == "q" or word == "quit"
                TerminateProcess(process, FAILED)
                link.open = false
            else
                say(DEBUG_HELP)
            end
        end
    end
    WaitForSingleObject(process, WAIT_FOREVER)
    var exit_code = memory(8)
    poke_i32(exit_code, 0, FAILED)
    GetExitCodeProcess(process, exit_code)
    CloseHandle(process)
    CloseHandle(pipe)
    CloseHandle(event)
    say("The program finished with exit code " + string(peek_i32(exit_code, 0)) + ".\n")
    return peek_i32(exit_code, 0)
end

# --- The command ---

func command_answer(words: [string]): int
    var count = len(words) + 1
    var command = ""
    if count >= 2
        command = words[0]
    end
    if count == 2 and command == "help"
        say(USAGE)
        return 0
    end
    if count == 2 and command == "version"
        say("Jamo " + VERSION + "\n")
        return 0
    end
    # A name starting with -- is a mistyped option, like jamo new --game with the name left out
    if count >= 3 and command == "new" and starts_with(words[count - 2], "--") and starts_with(words[1], "--")
        complain(USAGE)
        return FAILED
    end
    if count == 3 and command == "new"
        return make_new_program(words[1], false)
    end
    if count == 4 and command == "new" and words[1] == "--game"
        return make_new_program(words[2], true)
    end
    if count == 4 and command == "new" and words[2] == "--game"
        return make_new_program(words[1], true)
    end
    if count >= 3 and command == "fmt"
        var paths: [string] = []
        for i in 1..len(words)
            paths.add(words[i])
        end
        return tidy_files(paths)
    end
    if count >= 3 and command == "debug"
        var debug_inputs: [string] = []
        for i in 2..len(words)
            debug_inputs.add(words[i])
        end
        return debug_program(words[1], debug_inputs)
    end
    if count == 3 and command == "doc"
        return make_docs(words[1])
    end
    if count == 3 and command == "get"
        return get_package(words[1])
    end
    if count <= 3 and command == "test"
        if count == 3
            return test_command(words[1])
        end
        return test_command(".")
    end
    if count == 3 and command == "check"
        var program = new_program()
        if load_and_check(words[1], program)
            return 0
        end
        return FAILED
    end
    # These test the Memory Cleaner and the optimizer, and aren't for normal programs
    var cleaner_mode = 0
    var first = 2
    while first < count
        var word = words[first - 1]
        if word == "--gc-test"
            cleaner_mode = cleaner_mode / 2 * 2 + 1
        elif word == "--gc-check"
            if cleaner_mode / 2 % 2 == 0
                cleaner_mode += CLEANER_CHECKS
            end
        elif word == "--gc-off"
            if cleaner_mode / 4 % 2 == 0
                cleaner_mode += CLEANER_OFF
            end
        elif word == "--no-optimize"
            if cleaner_mode / 8 % 2 == 0
                cleaner_mode += NO_OPTIMIZING
            end
        elif word == "--window"
            if cleaner_mode / WINDOW_PROGRAM % 2 == 0
                cleaner_mode += WINDOW_PROGRAM
            end
        elif word == "--trace"
            if cleaner_mode / TRACING % 2 == 0
                cleaner_mode += TRACING
            end
        elif word == "--debug"
            if cleaner_mode / 8 % 2 == 0
                cleaner_mode += NO_OPTIMIZING
            end
            debug_build = true
        else
            break
        end
        first += 1
    end
    if first >= count or (first + 1 < count and command != "run" and command != "watch")
        complain(USAGE)
        return FAILED
    end
    if command == "watch"
        var watch_inputs: [string] = []
        for i in first..len(words)
            watch_inputs.add(words[i])
        end
        return watch(words[first - 1], cleaner_mode, watch_inputs)
    end
    if command != "build" and command != "run"
        complain(USAGE)
        return FAILED
    end
    var exe_path = build(words[first - 1], cleaner_mode)
    if exe_path == ""
        return FAILED
    end
    if command != "run"
        return 0
    end
    var inputs: [string] = []
    for i in first..len(words)
        inputs.add(words[i])
    end
    return run(exe_path, inputs)
end

# --- jamo get: downloads a package, a library someone shared on GitHub ---
# jamo get someone/project fetches the list jamo-package.txt from the project's main branch, one .jamo file name per
# line, then each file, into packages/project/ in the current folder. With no list it fetches project.jamo alone.
# JAMO_PACKAGE_SITE changes where from, which the tests use to fetch from their own server on 127.0.0.1

extern "kernel32.dll" func GetEnvironmentVariableW(name: int, buffer: int, size: i32): i32

const PACKAGE_SITE = "https://raw.githubusercontent.com"
const PACKAGE_LIST = "jamo-package.txt"
const PACKAGE_MOST_BYTES = 4000000
const PACKAGE_MOST_FILES = 100

# An environment variable's value, or "" when it isn't set. Only ASCII, which is all a web address needs here
func environment(name: string): string
    var buffer = memory(2048)
    var size = GetEnvironmentVariableW(wide(name), buffer, 1000)
    if size <= 0 or size >= 1000
        return ""
    end
    var place = memory(size + 1)
    for i in 0..size
        var letter = peek_u16(buffer, i * 2)
        if letter > 127
            return ""
        end
        poke_u8(place, i, letter)
    end
    return memory_text(place, size)
end

# Letters, digits, - _ and ., not starting with a dot, so a name can never climb out of its folder
func package_name_ok(name: string): bool
    if len(name) == 0 or len(name) > 100 or byte(name, 0) == 46
        return false
    end
    for i in 0..len(name)
        var c = byte(name, i)
        var ok = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 45 or c == 95 or c == 46
        if not ok
            return false
        end
    end
    return true
end

func get_package(spec: string): int
    var parts = split(spec, "/")
    if len(parts) != 2 or not package_name_ok(parts[0]) or not package_name_ok(parts[1])
        complain("jamo get needs a GitHub name and project, like this: jamo get someone/project\n")
        return FAILED
    end
    var project = parts[1]
    var site = environment("JAMO_PACKAGE_SITE")
    if site == ""
        site = PACKAGE_SITE
    end
    var base = site + "/" + parts[0] + "/" + project + "/HEAD/"
    var net = start_net()
    net.set_timeout(30.0)
    var files: [string] = []
    var list = net.get(base + PACKAGE_LIST)
    if list.status == 200
        for line in split(replace(list.text, "\r", ""), "\n")
            var name = trim(line)
            if name != "" and not starts_with(name, "#")
                if not package_name_ok(name) or not ends_with(name, ".jamo")
                    complain(f"{spec}'s {PACKAGE_LIST} lists {name}, which isn't a plain .jamo file name, so nothing was saved.\n")
                    net.close()
                    return FAILED
                end
                files.add(name)
            end
        end
    elif list.status == 404
        files.add(project + ".jamo")
    else
        complain(f"I couldn't get {spec}: {package_problem(list)}\n")
        net.close()
        return FAILED
    end
    if len(files) == 0 or len(files) > PACKAGE_MOST_FILES
        complain(f"{spec}'s {PACKAGE_LIST} must list from 1 to {PACKAGE_MOST_FILES} .jamo files.\n")
        net.close()
        return FAILED
    end
    # Everything is fetched before anything is saved, so a failure leaves no half package behind
    var texts: [string] = []
    for name in files
        var got = net.get(base + name)
        if got.status != 200
            complain(f"I couldn't get {name} from {spec}: {package_problem(got)}\n")
            net.close()
            return FAILED
        end
        if len(got.text) > PACKAGE_MOST_BYTES
            complain(f"{name} from {spec} is over {PACKAGE_MOST_BYTES / 1000000} MB, which is too big for a Jamo file.\n")
            net.close()
            return FAILED
        end
        texts.add(got.text)
    end
    net.close()
    var folder = "packages/" + project
    make_folders(folder)
    for i in 0..len(files)
        if not save_text(folder + "/" + files[i], texts[i])
            complain(f"I couldn't save {folder}/{files[i]}.\n")
            return FAILED
        end
    end
    var word = "files"
    if len(files) == 1
        word = "file"
    end
    say(f"Got {len(files)} {word} from {spec} into {folder}\nUse it with: use \"{folder}/{files[0]}\"\n")
    return 0
end

func package_problem(got: Response): string
    if got.status == 404
        return "it isn't there (404). Check the name, and that the project is public"
    elif got.status > 0
        return f"the site answered {got.status}"
    end
    return got.error
end

# --- jamo fmt: tidies a program's indentation and spacing ---
# Jamo's blocks close with end, so indentation never changes what a program does. Each line keeps its place, so
# error line numbers stay the same: lines get 4 spaces for each open block (and 4 more while a line carries on), lose
# spaces at their ends, and the file ends with one line ending

# The code of a line, with text in quotes and the comment taken out, so they can't look like keywords or brackets
func tidy_code_part(line: string): string
    var out = new_builder()
    var i = 0
    var count = len(line)
    while i < count
        var c = byte(line, i)
        if c == 35
            break
        end
        if c == 34
            out.add("\"\"")
            i += 1
            while i < count and byte(line, i) != 34
                if byte(line, i) == 92
                    i += 1
                end
                i += 1
            end
            i += 1
        else
            out.add(slice(line, i, i + 1))
            i += 1
        end
    end
    return trim(out.text())
end

# The word a line starts with, or "" when it starts with something else
func tidy_first_word(line: string): string
    var at = 0
    while at < len(line)
        var c = byte(line, at)
        if not ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57 and at > 0) or c == 95)
            break
        end
        at += 1
    end
    return slice(line, 0, at)
end

# True when the code carries on to the next line, the way the lexer joins lines after an operator or a comma
func tidy_carries_on(code: string): bool
    if code == ""
        return false
    end
    for ending in [",", "=", "+", "-", "*", "/", "%", "..", " <", " >", " and", " or", " not", "=>"]
        if ends_with(code, ending)
            return true
        end
    end
    return code == "and" or code == "or" or code == "not"
end

# True when the line makes a function in place with a block after it, like var f = func(x: int): int, and not when
# func( is a type, like on_click: func(int): int
func tidy_starts_function_value(code: string): bool
    if contains(code, "=>")
        return false
    end
    var at = find(code, "func(")
    while at >= 0
        var before = trim(slice(code, 0, at))
        if ends_with(before, "=") or ends_with(before, "(") or ends_with(before, ",") or before == "return" or ends_with(before, " return")
            return true
        end
        var rest = slice(code, at + 5, len(code))
        var next = find(rest, "func(")
        if next < 0
            return false
        end
        at = at + 5 + next
    end
    return false
end

func tidy_source(text: string): string
    var lines = split(replace(text, "\r", ""), "\n")
    var out: [string] = []
    var stack: [string] = []
    var open = 0
    # How many brackets were open before each line that opened more, so lines inside get one level for each of those lines
    var bracket_lines: [int] = []
    var carried = false
    # Whether the line that started this statement opened a block, which already gives its next lines a level
    var opened = false
    for raw in lines
        var line = trim(raw)
        if line == ""
            out.add("")
            continue
        end
        var first = tidy_first_word(line)
        if first == "private"
            first = tidy_first_word(trim(slice(line, len("private"), len(line))))
        end
        var code = tidy_code_part(line)
        var level = len(stack)
        if open > 0
            level = len(stack) + len(bracket_lines)
            if starts_with(line, ")") or starts_with(line, "]") or starts_with(line, "}")
                level -= 1
            end
        elif carried
            level = len(stack) + 1
            if opened
                level = len(stack)
            end
        elif first == "end"
            if len(stack) > 0 and stack[len(stack) - 1] == "case"
                stack.pop()
            end
            if len(stack) > 0
                stack.pop()
            end
            level = len(stack)
        elif first == "case"
            if len(stack) > 0 and stack[len(stack) - 1] == "case"
                stack.pop()
            end
            level = len(stack)
            stack.add("case")
        elif first == "elif" or first == "else" or first == "catch"
            if len(stack) > 0 and stack[len(stack) - 1] == "case"
                stack.pop()
                level = len(stack)
                stack.add("case")
            else
                level = len(stack) - 1
                if level < 0
                    level = 0
                end
            end
        end
        out.add(repeat("    ", level) + line)
        if open == 0 and not carried
            var depth_before = len(stack)
            var in_interface = len(stack) > 0 and stack[len(stack) - 1] == "interface"
            if first == "if" or first == "while" or first == "for" or first == "struct" or first == "enum" or first == "try"
                stack.add("block")
            elif first == "interface"
                stack.add("interface")
            elif first == "match"
                stack.add("match")
            elif first == "func" and not in_interface and not contains(code, "=>")
                stack.add("block")
            elif first != "func" and tidy_starts_function_value(code)
                stack.add("block")
            end
            opened = len(stack) > depth_before
        end
        var open_before = open
        for i in 0..len(code)
            var c = byte(code, i)
            if c == 40 or c == 91 or c == 123
                open += 1
            elif (c == 41 or c == 93 or c == 125) and open > 0
                open -= 1
            end
        end
        if open > open_before
            bracket_lines.add(open_before)
        end
        while len(bracket_lines) > 0 and open <= bracket_lines[len(bracket_lines) - 1]
            bracket_lines.pop()
        end
        carried = tidy_carries_on(code)
    end
    while len(out) > 0 and out[len(out) - 1] == ""
        out.pop()
    end
    return join(out, "\n") + "\n"
end

# jamo fmt a.jamo b.jamo: tidies each file in place, saying which ones changed
func tidy_files(paths: [string]): int
    var failed = false
    for path in paths
        if not ends_with(lower(path), ".jamo")
            complain(f"jamo fmt tidies .jamo files, and {path} isn't one.\n")
            failed = true
            continue
        end
        if not exists(path)
            complain(f"I can't find {path}.\n")
            failed = true
            continue
        end
        var before = read_file(path)
        var after = tidy_source(before)
        if contains(before, "\r\n")
            after = replace(after, "\n", "\r\n")
        end
        if after == before
            say(f"{path} is already tidy\n")
        elif save_text(path, after)
            say(f"Tidied {path}\n")
        else
            complain(f"I couldn't save {path}.\n")
            failed = true
        end
    end
    if failed
        return FAILED
    end
    return 0
end

func main()
    var code = command_answer(args())
    if code != 0
        ExitProcess(code)
    end
end
