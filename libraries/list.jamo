# list: finding, putting in and taking out items of int and string arrays. use "list.jamo"
#
# Sorting ints and strings, and turning arrays around, are in text.jamo: sort_ints, sort_strings, reverse_ints and
# reverse_strings. The _int and _string versions came first. The ones at the end work on every kind of array, using
# generics, and sort_by, sort_by_float and sort_by_text sort any array by a key you give each item. sort_with,
# filtered and mapped take a function of your own.

use "text.jamo"

func list_check_place(at: int, count: int, word: string)
    if at < 0 or at > count
        fail(f"{word} needs a place from 0 to {count}, not {at}.")
    end
end

# --- Finding ---

# Where value first is in items, counting from 0, or -1 when it isn't there
func index_of_int(items: [int], value: int): int
    for i in 0..len(items)
        if items[i] == value
            return i
        end
    end
    return -1
end

func index_of_string(items: [string], value: string): int
    for i in 0..len(items)
        if items[i] == value
            return i
        end
    end
    return -1
end

func contains_int(items: [int], value: int): bool
    return index_of_int(items, value) >= 0
end

func contains_string(items: [string], value: string): bool
    return index_of_string(items, value) >= 0
end

# --- Putting in and taking out. These change the array itself ---

# Puts value at place at, moving the items from there on along by one. at can be len(items), to add at the end
func insert_int(items: [int], at: int, value: int)
    list_check_place(at, len(items), "insert_int")
    items.add(value)
    var i = len(items) - 1
    while i > at
        items[i] = items[i - 1]
        i -= 1
    end
    items[at] = value
end

func insert_string(items: [string], at: int, value: string)
    list_check_place(at, len(items), "insert_string")
    items.add(value)
    var i = len(items) - 1
    while i > at
        items[i] = items[i - 1]
        i -= 1
    end
    items[at] = value
end

# Takes out the item at place at, moving the ones after it back by one, and gives it back
func remove_int(items: [int], at: int): int
    list_check_place(at, len(items) - 1, "remove_int")
    var removed = items[at]
    for i in at..len(items) - 1
        items[i] = items[i + 1]
    end
    items.pop()
    return removed
end

func remove_string(items: [string], at: int): string
    list_check_place(at, len(items) - 1, "remove_string")
    var removed = items[at]
    for i in at..len(items) - 1
        items[i] = items[i + 1]
    end
    items.pop()
    return removed
end

# --- For every kind of array ---
# T must work with == for has_item, find_item and count_item: ints, floats, strings, bools and enums

func has_item<T>(items: [T], value: T): bool
    return find_item(items, value) >= 0
end

# Where the first one equal to value is, or -1
func find_item<T>(items: [T], value: T): int
    for i in 0..len(items)
        if items[i] == value
            return i
        end
    end
    return -1
end

func count_item<T>(items: [T], value: T): int
    var total = 0
    for item in items
        if item == value
            total += 1
        end
    end
    return total
end

# A new array with the items the other way round. The array itself stays as it was
func reversed<T>(items: [T]): [T]
    var out: [T] = []
    var i = len(items) - 1
    while i >= 0
        out.add(items[i])
        i -= 1
    end
    return out
end

func swap_items<T>(items: [T], a: int, b: int)
    list_check_place(a, len(items) - 1, "swap_items")
    list_check_place(b, len(items) - 1, "swap_items")
    var keep = items[a]
    items[a] = items[b]
    items[b] = keep
end

func last_item<T>(items: [T]): T
    if len(items) == 0
        fail("last_item needs an array with something in it, but this one is empty.")
    end
    return items[len(items) - 1]
end

# --- Sorting any array ---
# Jamo can't pass a function, so you give each item a key instead: an array the same length, where keys[i] belongs to
# items[i]. Both arrays get sorted from the smallest key to the largest. Items with equal keys keep their order.
#
#     var names = ["Ana", "Bo", "Cy"]
#     var scores = [30, 10, 20]
#     sort_by(names, scores)       # names is now Bo, Cy, Ana and scores is 10, 20, 30

# Sorts floats from smallest to largest. nan goes wherever it lands
func sort_floats(items: [float])
    list_put_in_order(items, list_order_of(items))
end

# Sorts items by int keys, smallest first
func sort_by<T>(items: [T], keys: [int])
    list_check_keys(len(items), len(keys), "sort_by")
    var order = list_order_of(keys)
    list_put_in_order(items, order)
    list_put_in_order(keys, order)
end

# Sorts items by float keys, smallest first
func sort_by_float<T>(items: [T], keys: [float])
    list_check_keys(len(items), len(keys), "sort_by_float")
    var order = list_order_of(keys)
    list_put_in_order(items, order)
    list_put_in_order(keys, order)
end

# Sorts items by text keys, in the same order as sort_strings ("Zoo" before "apple")
func sort_by_text<T>(items: [T], keys: [string])
    list_check_keys(len(items), len(keys), "sort_by_text")
    var order = list_text_order_of(keys)
    list_put_in_order(items, order)
    list_put_in_order(keys, order)
end

func list_check_keys(items: int, keys: int, word: string)
    if items != keys
        fail(f"{word} needs one key for each item, but there are {items} items and {keys} keys.")
    end
end

# The places of keys from smallest to largest, by merging runs that double in size. Equal keys keep their order.
# K must work with <=, so ints and floats
func list_order_of<K>(keys: [K]): [int]
    var count = len(keys)
    var from: [int] = []
    var to: [int] = []
    for i in 0..count
        from.add(i)
        to.add(i)
    end
    var width = 1
    while width < count
        var left = 0
        while left < count
            var middle = left + width
            if middle > count
                middle = count
            end
            var right = middle + width
            if right > count
                right = count
            end
            var a = left
            var b = middle
            for place in left..right
                if b >= right or (a < middle and keys[from[a]] <= keys[from[b]])
                    to[place] = from[a]
                    a += 1
                else
                    to[place] = from[b]
                    b += 1
                end
            end
            left = right
        end
        var spare = from
        from = to
        to = spare
        width *= 2
    end
    return from
end

# The same, for text keys
func list_text_order_of(keys: [string]): [int]
    var count = len(keys)
    var from: [int] = []
    var to: [int] = []
    for i in 0..count
        from.add(i)
        to.add(i)
    end
    var width = 1
    while width < count
        var left = 0
        while left < count
            var middle = left + width
            if middle > count
                middle = count
            end
            var right = middle + width
            if right > count
                right = count
            end
            var a = left
            var b = middle
            for place in left..right
                if b >= right or (a < middle and not text_before(keys[from[b]], keys[from[a]]))
                    to[place] = from[a]
                    a += 1
                else
                    to[place] = from[b]
                    b += 1
                end
            end
            left = right
        end
        var spare = from
        from = to
        to = spare
        width *= 2
    end
    return from
end

# --- With a function of your own ---

# Sorts items so that before(a, b) is true when a should come before b. Items it calls equal, where neither comes
# before the other, keep their order. before must give the same answer each time for the same two items
#
#     func by_score(a: Player, b: Player): bool
#         return a.score > b.score
#     end
#     sort_with(players, by_score)       # highest score first
func sort_with<T>(items: [T], before: func(T, T): bool)
    var count = len(items)
    var from: [int] = []
    var to: [int] = []
    for i in 0..count
        from.add(i)
        to.add(i)
    end
    var width = 1
    while width < count
        var left = 0
        while left < count
            var middle = left + width
            if middle > count
                middle = count
            end
            var right = middle + width
            if right > count
                right = count
            end
            var a = left
            var b = middle
            for place in left..right
                if b >= right or (a < middle and not before(items[from[b]], items[from[a]]))
                    to[place] = from[a]
                    a += 1
                else
                    to[place] = from[b]
                    b += 1
                end
            end
            left = right
        end
        var spare = from
        from = to
        to = spare
        width *= 2
    end
    list_put_in_order(items, from)
end

# A new array with the items where keep(item) is true, in order
func filtered<T>(items: [T], keep: func(T): bool): [T]
    var out: [T] = []
    for item in items
        if keep(item)
            out.add(item)
        end
    end
    return out
end

# A new array with change(item) for each item, in order
func mapped<T, U>(items: [T], change: func(T): U): [U]
    var out: [U] = []
    for item in items
        out.add(change(item))
    end
    return out
end

# Moves items so items[i] becomes what was at items[order[i]]
func list_put_in_order<T>(items: [T], order: [int])
    var copy: [T] = []
    for item in items
        copy.add(item)
    end
    for i in 0..len(order)
        items[i] = copy[order[i]]
    end
end
