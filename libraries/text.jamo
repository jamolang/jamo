# text: splitting, searching, cutting, changing and joining text, checking numbers, and sorting arrays. use "text.jamo"
#
# Places count bytes from 0, like text[i] and len. Results are built in memory and made into text with
# memory_text in one go, so long text doesn't get joined a letter at a time.

# --- Building text ---

# Copies the bytes of text into memory at a place, and gives back the place after them
func text_put(place: int, text: string): int
    var count = len(text)
    for i in 0..count
        poke_u8(place, i, byte(text, i))
    end
    return place + count
end

# True if part is in text starting at that place. The place must leave room for part
func text_matches_at(text: string, part: string, at: int): bool
    for i in 0..len(part)
        if byte(text, at + i) != byte(part, i)
            return false
        end
    end
    return true
end

# --- Searching ---

# Where part first starts in text, or -1 if it isn't there. Empty part is found at 0
func find(text: string, part: string): int
    var size = len(part)
    if size == 0
        return 0
    end
    var first = byte(part, 0)
    for at in 0..len(text) - size + 1
        if byte(text, at) == first and text_matches_at(text, part, at)
            return at
        end
    end
    return -1
end

func contains(text: string, part: string): bool
    return find(text, part) >= 0
end

func starts_with(text: string, part: string): bool
    return len(part) <= len(text) and text_matches_at(text, part, 0)
end

func ends_with(text: string, part: string): bool
    return len(part) <= len(text) and text_matches_at(text, part, len(text) - len(part))
end

# --- Cutting ---

# The bytes from place from up to, but not including, place to. slice("hello", 1, 3) is "el"
func slice(text: string, from: int, to: int): string
    if from < 0 or to > len(text) or from > to
        fail(f"slice needs 0 <= from <= to <= {len(text)}, the text's length, but from is {from} and to is {to}.")
    end
    var count = to - from
    var place = memory(count + 1)
    for i in 0..count
        poke_u8(place, i, byte(text, from + i))
    end
    return memory_text(place, count)
end

# The pieces of text between each by. split("a,b,,c", ",") gives ["a", "b", "", "c"]
func split(text: string, by: string): [string]
    var size = len(by)
    if size == 0
        fail("split needs something to split by, but it was given empty text.")
    end
    var count = len(text)
    var place = memory(count + 1)
    text_put(place, text)
    var parts: [string] = []
    var start = 0
    var at = 0
    var first = byte(by, 0)
    while at <= count - size
        if byte(text, at) == first and text_matches_at(text, by, at)
            parts.add(memory_text(place + start, at - start))
            at += size
            start = at
        else
            at += 1
        end
    end
    parts.add(memory_text(place + start, count - start))
    return parts
end

func text_is_space(code: int): bool
    return code == 32 or code == 9 or code == 10 or code == 13
end

# Text without the spaces, tabs and line endings at its start and end
func trim(text: string): string
    var from = 0
    var to = len(text)
    while from < to and text_is_space(byte(text, from))
        from += 1
    end
    while to > from and text_is_space(byte(text, to - 1))
        to -= 1
    end
    if from == 0 and to == len(text)
        return text
    end
    return slice(text, from, to)
end

# --- Changing ---

# Text with every old changed to new, from left to right
func replace(text: string, old: string, new: string): string
    var size = len(old)
    if size == 0
        fail("replace needs some text to look for, but it was given empty text.")
    end
    var count = len(text)
    var first = byte(old, 0)
    var found = 0
    var at = 0
    while at <= count - size
        if byte(text, at) == first and text_matches_at(text, old, at)
            found += 1
            at += size
        else
            at += 1
        end
    end
    if found == 0
        return text
    end
    var total = count + found * (len(new) - size)
    var place = memory(total + 1)
    var out = 0
    at = 0
    while at < count
        if at <= count - size and byte(text, at) == first and text_matches_at(text, old, at)
            out = text_put(place + out, new) - place
            at += size
        else
            poke_u8(place, out, byte(text, at))
            out += 1
            at += 1
        end
    end
    return memory_text(place, total)
end

# Text with small letters made into capitals: a to z, and the accented, Greek and Cyrillic letters (like é, ß stays,
# ω and ж). Anything else stays as it is
func upper(text: string): string
    return text_change_case(text, true)
end

# Text with capitals made into small letters, the same letters as upper
func lower(text: string): string
    return text_change_case(text, false)
end

# Letters from U+0080 to U+07FF take two bytes in UTF-8, and every letter upper and lower change is one of them,
# so the text keeps its length
func text_change_case(text: string, to_upper: bool): string
    var count = len(text)
    var place = memory(count + 1)
    var i = 0
    while i < count
        var code = byte(text, i)
        if code < 128
            if to_upper and code >= 97 and code <= 122
                code -= 32
            elif not to_upper and code >= 65 and code <= 90
                code += 32
            end
            poke_u8(place, i, code)
            i += 1
        elif code >= 192 and code < 224 and i + 1 < count and byte(text, i + 1) >= 128 and byte(text, i + 1) < 192
            var letter = (code - 192) * 64 + byte(text, i + 1) - 128
            if to_upper
                letter = text_upper_letter(letter)
            else
                letter = text_lower_letter(letter)
            end
            poke_u8(place, i, 192 + letter / 64)
            poke_u8(place, i + 1, 128 + letter % 64)
            i += 2
        else
            poke_u8(place, i, code)
            i += 1
        end
    end
    return memory_text(place, count)
end

# The capital of a two-byte letter, by its Unicode number, or the same number when it has none that's two bytes
func text_upper_letter(letter: int): int
    if letter >= 224 and letter <= 254 and letter != 247
        return letter - 32                                   # à to þ
    elif letter >= 256 and letter <= 311 and letter != 305 and letter % 2 == 1
        return letter - 1                                    # ā to ķ
    elif letter >= 313 and letter <= 328 and letter % 2 == 0
        return letter - 1                                    # ĺ to ň
    elif letter >= 330 and letter <= 375 and letter % 2 == 1
        return letter - 1                                    # ŋ to ŷ
    elif letter >= 378 and letter <= 382 and letter % 2 == 0
        return letter - 1                                    # ź to ž
    elif letter == 962
        return 931                                           # ς, the sigma at the end of a word
    elif letter >= 945 and letter <= 969
        return letter - 32                                   # α to ω
    elif letter >= 1072 and letter <= 1103
        return letter - 32                                   # а to я
    elif letter >= 1104 and letter <= 1119
        return letter - 80                                   # ѐ to џ
    end
    return letter
end

# The small letter of a two-byte capital, by its Unicode number
func text_lower_letter(letter: int): int
    if letter >= 192 and letter <= 222 and letter != 215
        return letter + 32                                   # À to Þ
    elif letter >= 256 and letter <= 311 and letter != 304 and letter % 2 == 0
        return letter + 1                                    # Ā to Ķ
    elif letter >= 313 and letter <= 328 and letter % 2 == 1
        return letter + 1                                    # Ĺ to Ň
    elif letter >= 330 and letter <= 375 and letter % 2 == 0
        return letter + 1                                    # Ŋ to Ŷ
    elif letter >= 377 and letter <= 381 and letter % 2 == 1
        return letter + 1                                    # Ź to Ž
    elif letter >= 913 and letter <= 937 and letter != 930
        return letter + 32                                   # Α to Ω
    elif letter >= 1040 and letter <= 1071
        return letter + 32                                   # А to Я
    elif letter >= 1024 and letter <= 1039
        return letter + 80                                   # Ѐ to Џ
    end
    return letter
end

# --- Letters, not bytes ---
# len and text[i] count bytes. In UTF-8 a letter outside English takes 2 to 4 bytes, so these count whole letters

# How many letters the text has. "héllo" has 6 bytes but 5 letters
func letter_count(text: string): int
    var total = 0
    for i in 0..len(text)
        var code = byte(text, i)
        if code < 128 or code >= 192
            total += 1
        end
    end
    return total
end

# The text split into its letters, each as its own text
func letters(text: string): [string]
    var out: [string] = []
    var count = len(text)
    if count == 0
        return out
    end
    var start = 0
    for i in 1..count + 1
        if i == count or byte(text, i) < 128 or byte(text, i) >= 192
            out.add(slice(text, start, i))
            start = i
        end
    end
    return out
end

# The letters in the other order, keeping each letter's bytes together
func reverse_letters(text: string): string
    var parts = letters(text)
    var out: [string] = []
    var i = len(parts) - 1
    while i >= 0
        out.add(parts[i])
        i -= 1
    end
    return join(out, "")
end

# --- Joining ---

# The parts in order with between in each gap. join(["a", "b"], ", ") is "a, b"
func join(parts: [string], between: string): string
    var total = 0
    for part in parts
        total += len(part)
    end
    if len(parts) > 1
        total += (len(parts) - 1) * len(between)
    end
    var place = memory(total + 1)
    var at = place
    for i in 0..len(parts)
        if i > 0
            at = text_put(at, between)
        end
        at = text_put(at, parts[i])
    end
    return memory_text(place, total)
end

# The text that many times over. repeat("ab", 3) is "ababab"
func repeat(text: string, times: int): string
    if times < 0
        fail(f"repeat needs 0 or more times, not {times}.")
    end
    var count = len(text)
    if count > 0 and times > 4611686018427387903 / count
        fail(f"repeat would make text too long: {count} bytes {times} times.")
    end
    var total = count * times
    var place = memory(total + 1)
    var at = place
    for i in 0..times
        at = text_put(at, text)
    end
    return memory_text(place, total)
end

# --- Checking numbers ---

# The same limits float() has. From here up, a decimal rounds past the largest float: 2^1024 - 2^970
const TEXT_FLOAT_HIGH = ""
# At or below this, a decimal that isn't 0 rounds to 0: 2^-1075, all 1075 digits after the dot
const TEXT_FLOAT_LOW = ""

func text_all_digits(text: string): bool
    if len(text) == 0
        return false
    end
    for i in 0..len(text)
        var code = byte(text, i)
        if code < 48 or code > 57
            return false
        end
    end
    return true
end

func text_without_leading_zeros(digits: string): string
    var first = 0
    while first < len(digits) and byte(digits, first) == 48
        first += 1
    end
    return slice(digits, first, len(digits))
end

# Below 0 when the whole number a is smaller than b, with neither having leading zeros
func text_compare_digits(a: string, b: string): int
    if len(a) != len(b)
        return len(a) - len(b)
    end
    for i in 0..len(a)
        if byte(a, i) != byte(b, i)
            return byte(a, i) - byte(b, i)
        end
    end
    return 0
end

# True when int(text) would work: digits with an optional minus sign, small enough for 64 bits
func is_int(text: string): bool
    var digits = text
    var largest = "9223372036854775807"
    if starts_with(text, "-")
        digits = slice(text, 1, len(text))
        largest = "9223372036854775808"
    end
    if not text_all_digits(digits)
        return false
    end
    return text_compare_digits(text_without_leading_zeros(digits), largest) <= 0
end

# True when float(text) would work: digits with an optional minus sign, then maybe a dot and more digits,
# and not so large it rounds past the largest float or so small that a number that isn't 0 rounds to 0
func is_float(text: string): bool
    var number = text
    if starts_with(text, "-")
        number = slice(text, 1, len(text))
    end
    var whole = number
    var parts = ""
    var dot = find(number, ".")
    if dot >= 0
        whole = slice(number, 0, dot)
        parts = slice(number, dot + 1, len(number))
        if not text_all_digits(parts)
            return false
        end
    end
    if not text_all_digits(whole)
        return false
    end
    whole = text_without_leading_zeros(whole)
    if whole != ""
        return text_compare_digits(whole, TEXT_FLOAT_HIGH) < 0
    end
    var last = len(parts)
    while last > 0 and byte(parts, last - 1) == 48
        last -= 1
    end
    if last == 0
        return true
    end
    # Both have the dot in the same place, so the one with the first larger digit is larger
    for i in 0..last
        var mine = byte(parts, i)
        var bound = 48
        if i < len(TEXT_FLOAT_LOW)
            bound = byte(TEXT_FLOAT_LOW, i)
        end
        if mine != bound
            return mine > bound
        end
    end
    return last > len(TEXT_FLOAT_LOW)
end

# --- Sorting and turning arrays around. These change the array itself ---

# Sorts ints from smallest to largest
func sort_ints(items: [int])
    var count = len(items)
    if count < 2
        return
    end
    var from = items
    var to: [int] = []
    for item in items
        to.add(item)
    end
    var flipped = false
    var width = 1
    while width < count
        var left = 0
        while left < count
            var middle = left + width
            if middle > count
                middle = count
            end
            var right = middle + width
            if right > count
                right = count
            end
            var a = left
            var b = middle
            for place in left..right
                if b >= right or (a < middle and from[a] <= from[b])
                    to[place] = from[a]
                    a += 1
                else
                    to[place] = from[b]
                    b += 1
                end
            end
            left = right
        end
        var spare = from
        from = to
        to = spare
        flipped = not flipped
        width *= 2
    end
    if flipped
        for i in 0..count
            items[i] = from[i]
        end
    end
end

# True if a comes before b, by comparing their bytes. All capitals come before small letters
func text_before(a: string, b: string): bool
    var a_size = len(a)
    var b_size = len(b)
    var shorter = a_size
    if b_size < shorter
        shorter = b_size
    end
    for i in 0..shorter
        var x = byte(a, i)
        var y = byte(b, i)
        if x != y
            return x < y
        end
    end
    return a_size < b_size
end

# Sorts text by its bytes, so "Zoo" comes before "apple", and "app" before "apple"
func sort_strings(items: [string])
    var count = len(items)
    if count < 2
        return
    end
    var from = items
    var to: [string] = []
    for item in items
        to.add(item)
    end
    var flipped = false
    var width = 1
    while width < count
        var left = 0
        while left < count
            var middle = left + width
            if middle > count
                middle = count
            end
            var right = middle + width
            if right > count
                right = count
            end
            var a = left
            var b = middle
            for place in left..right
                if b >= right or (a < middle and not text_before(from[b], from[a]))
                    to[place] = from[a]
                    a += 1
                else
                    to[place] = from[b]
                    b += 1
                end
            end
            left = right
        end
        var spare = from
        from = to
        to = spare
        flipped = not flipped
        width *= 2
    end
    if flipped
        for i in 0..count
            items[i] = from[i]
        end
    end
end

func reverse_ints(items: [int])
    var last = len(items) - 1
    for i in 0..len(items) / 2
        var keep = items[i]
        items[i] = items[last - i]
        items[last - i] = keep
    end
end

func reverse_strings(items: [string])
    var last = len(items) - 1
    for i in 0..len(items) / 2
        var keep = items[i]
        items[i] = items[last - i]
        items[last - i] = keep
    end
end

# --- Numbers from text, without stopping ---

# The text as an int, or fallback when it isn't one, like int_or(input(), 0)
func int_or(text: string, fallback: int): int
    if is_int(text)
        return int(text)
    end
    return fallback
end

func float_or(text: string, fallback: float): float
    if is_float(text)
        return float(text)
    end
    return fallback
end
