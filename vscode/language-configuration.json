{
    "comments": { "lineComment": "#" },
    "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(func|struct|enum|if|elif|else|while|for|match|case|try|catch)\\b",
        "decreaseIndentPattern": "^\\s*(end|elif|else|case|catch)\\b"
    }
}
