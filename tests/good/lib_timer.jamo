# timer.jamo on a clock the test controls, with the _at methods
use "timer.jamo"

func main()
    var spawn = new_timer_at(2.0, 10.0)
    print(spawn.ready_at(10.5))
    print(spawn.ready_at(11.9))
    print(spawn.ready_at(12.0))
    print(spawn.ready_at(12.1))
    print(spawn.ready_at(13.0))
    print(spawn.ready_at(14.0))
    print(spawn.ready_at(20.5))
    print(spawn.ready_at(21.0))
    print(spawn.ready_at(22.4))
    print(spawn.ready_at(22.5))
    print(spawn.left_at(22.6))
    print(spawn.left_at(30.0))
    print(spawn.progress_at(23.5))
    spawn.restart_at(100.0)
    print(spawn.ready_at(101.0))
    print(spawn.ready_at(102.0))
    var gun = new_cooldown(0.3)
    print(gun.try_use_at(0.0))
    print(gun.try_use_at(0.1))
    print(gun.try_use_at(0.29))
    print(gun.try_use_at(0.31))
    print(gun.try_use_at(0.5))
    print(gun.try_use_at(0.62))
    print(gun.try_use_at(5.0))
    print(gun.ready_at(5.1))
    print(gun.left_at(5.1))
    var now_timer = new_timer(1000.0)
    print(now_timer.ready())
    print(new_cooldown(1.0).try_use())
end
