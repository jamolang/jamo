func area(width: float, height: float): float
    return width * height
end

func main()
    print(1.5)
    print(2.0)
    print(1234567.5)
    print(0.1234567)
    print(0.0)
    print(-2.5)
    print(-0.0)
    print(1.0 / 3.0)
    print(1.5 + 2.25)
    print(10.0 - 0.5)
    print(2.5 * 2.0)
    print(area(2.0, 1.25))
    print(float(7))
    print(float(-7))
    print(int(3.9))
    print(int(-3.9))
    print(int(float(5)))
    print(string(1.5) + "!")
    print(f"value {2.5 + 1.0}")
    print(1.5 < 2.5)
    print(2.5 <= 2.5)
    print(1.5 > 2.5)
    print(2.5 >= 3.5)
    print(1.5 == 1.5)
    print(1.5 != 1.5)
    var total: float = 0.5
    total = total + 0.25
    print(total)
    print(0.0078125)
    print(0.0234375)
    print(0.0000005)
    print(0.0000015)
    print(999999.9999999)
    print(9999999999999998.0)
    print(10000000000000000.0)
    print(100000000000000000000.0)
    print(-123456789012345678901234567890.0)
    print(99999995000000000000.0)
    print(12345665000000000000.0)
    print(12345675000000000000.0)
end
