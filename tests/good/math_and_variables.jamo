func main()
    var a = 7
    var b: int = 3
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a + b * 2)
    print((a + b) * 2)
    a = a + 1
    print(a)
    var yes: bool = a == 8
    print(yes)
    print(a != 8)
    print(a < 8)
    print(a > 8)
    print(a <= 8)
    print(a >= 9)
    print(1 < 2 == true)
end
