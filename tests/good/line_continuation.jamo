func add(a: int,
         b: int): int
    return a +
        b
end

func main()
    var total = 1 +
        2 *
        3
    print(total)
    print(add(1,
        2))
    print(
        add(
            3,
            4
        )
    )
    var ok = total > 1 and  # A comment here is fine
        total < 100
    print(ok)
    var word = "ab" +
        "cd"
    print(word)
    total +=
        1
    print(total)
    print((1 +
        2) * 2)
    for i in 0..
        2
        print(i)
    end
    var x = -
        5
    print(x)
    print(not
        true)
end
