func main()
    print(0.0 / 0.0)
    print(1.0 / 0.0)
    print(-1.0 / 0.0)
    print(0.0 / 0.0 == 0.0 / 0.0)
    print(0.0 / 0.0 != 0.0 / 0.0)
    print(-0.0)
    print(-9223372036854775808 / -1)
    print(-9223372036854775808 % -1)
    print(9223372036854775807 + 1)
    print(-7 / 2)
    print(-7 % 2)
    print(0.1 + 0.2 == 0.3)
    print(not (1 < 2))
    print(true and false or true)
    print(1 == 1 and 2 != 2)
end
