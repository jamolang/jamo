func main()
    print(int("42"))
    print(int("-42"))
    print(int("0"))
    print(int("007"))
    print(int("9223372036854775807"))
    print(int("-9223372036854775808"))
    print(float("1.5"))
    print(float("-2.25"))
    print(float("3"))
    print(float("0.1") == 0.1)
    print(float("0.0"))
    print(float("-0.0"))
    print(float("000.500"))
    print(float(".0"))
    print(float("0.") * 100000000000000000000000000000000000000.0 == 0. * 100000000000000000000000000000000000000.0)
end
