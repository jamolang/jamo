func main()
    print(7 % 3)
    print(-7 % 3)
    print(7 % -3)
    print(-7 % -3)
    print(-9223372036854775808 % -1)
    print(5.5 % 2.0)
    print(-5.5 % 2.0)
    print(5.5 % -2.0)
    var zero = 0.0
    print(5.5 % zero)
    var x = 10
    x += 5
    print(x)
    x -= 3
    print(x)
    x *= 2
    print(x)
    x /= 5
    print(x)
    x += -1
    print(x)
    var y = 1.5
    y += 1.0
    print(y)
    y -= 0.25
    print(y)
    y *= 2.0
    print(y)
    y /= 4.0
    print(y)
    print(2 + 3 * 4 % 5)
end
