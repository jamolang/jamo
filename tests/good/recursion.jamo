func factorial(n: int): int
    if n < 2
        return 1
    end
    return n * factorial(n - 1)
end

func fibonacci(n: int): int
    if n < 2
        return n
    end
    return fibonacci(n - 1) + fibonacci(n - 2)
end

func is_even(n: int): bool
    if n == 0
        return true
    end
    return is_odd(n - 1)
end

func is_odd(n: int): bool
    if n == 0
        return false
    end
    return is_even(n - 1)
end

func main()
    print(factorial(10))
    print(fibonacci(20))
    print(is_even(10))
    print(is_odd(10))
end
