func first_even(limit: int): int
    for i in 1..limit
        if i % 2 == 0
            return i
        end
    end
    return 0
end

func next_end(): int
    print("end worked out")
    return 3
end

func main()
    for i in 0..3
        print(i)
    end
    for i in 5..5
        print("never")
    end
    for i in 5..2
        print("never")
    end
    for i in -2..0
        print(i)
    end
    for i in 0..next_end()
        print(i)
    end
    var total = 0
    for i in 0..10
        if i == 2
            continue
        end
        if i == 5
            break
        end
        total += i
    end
    print(total)
    for a in 0..2
        for b in 0..2
            if b == 1
                continue
            end
            print(a * 10 + b)
        end
    end
    var n = 0
    while true
        n += 1
        if n == 2
            continue
        end
        if n > 3
            break
        end
        print(n)
    end
    print(first_even(9))
    for i in 9223372036854775805..9223372036854775807
        print(i)
    end
    for i in 0..2
        var inside = i * 2
        print(inside)
    end
end
