func yes(): bool
    print("yes ran")
    return true
end

func no(): bool
    print("no ran")
    return false
end

func grade(score: int): string
    if score >= 90
        return "A"
    elif score >= 80
        return "B"
    elif score >= 70
        return "C"
    else
        return "F"
    end
end

